# Per-machine build/signing config for Deskflow. This file is canonical.
# Copy to `.env` (gitignored) on each seat and fill in the values for THAT box:
#
#   cp env.example .env
#
# Read by .vscode/tasks.json, scripts/build-windows.ps1, scripts/install-macos.sh
# and the fleet deploy scripts. Values here are per-seat identifiers and paths;
# no passwords belong in this file.

# ===== macOS (code signing) =====
# Your Apple Development certificate's SHA-1 HASH (not its name -- the hash is
# unambiguous even if two same-named certs are in the keychain). Required on
# both Macs: strict signing (FLEET_STRICT_SIGNING) refuses to build without it.
# Find it with:  security find-identity -v -p codesigning
DESKFLOW_CODESIGN_ID=

# macOS: install destination (.app bundle path)
DESKFLOW_INSTALL_APP=/Applications/Deskflow.app

# ===== Windows (build dependencies + signing) =====
# Qt MSVC kit prefix (leave empty to auto-detect under C:\Qt)
DESKFLOW_QT_PATH=

# OpenSSL install root (e.g. C:\Program Files\OpenSSL-Win64)
OPENSSL_ROOT_DIR=

# Windows: install location (must be a full path, e.g. C:\Program Files\Deskflow -- not C:\Program)
DESKFLOW_INSTALL_DIR=

# Windows: SHA-1 thumbprint of the Authenticode signing cert (public identifier,
# not a secret). scripts/sign-windows.ps1 runs `signtool sign /sha1 <thumbprint>`.
# The same key is declared in scripts/fleet.env.example; either file may set it.
# Find it with:  Get-ChildItem Cert:\CurrentUser\My | Format-List Subject, Thumbprint
DESKFLOW_SIGN_THUMBPRINT=

# ===== Common =====
# Build output directory (relative to repo root)
DESKFLOW_BUILD_DIR=build

# Optional: override the settings directory used by scripts/sync-debug-settings-*.
# Default: ~/Library/Deskflow on macOS, %APPDATA%\Deskflow on Windows.
# DESKFLOW_SETTINGS_DIR=

# Login screen / UAC: configured in Deskflow GUI (Settings -> Advanced), not here.
# Requires the installed (Program Files) build + Deskflow Windows service + Start once while logged in.
