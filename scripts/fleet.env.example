# Fleet deploy configuration — copy to scripts/fleet.env (gitignored) on EVERY seat.
#
#   cp scripts/fleet.env.example scripts/fleet.env
#
# The controller is symmetric: any seat can run scripts/fleet-deploy.sh (macOS)
# or scripts/fleet-deploy.ps1 (Windows) and drive the whole fleet. Each seat
# identifies itself as LOCAL_ID, which is derived from the hostname
# (`hostname -s` on macOS, `$env:COMPUTERNAME` on Windows, lowercased) — it is
# NEVER read from this file. On each seat the FLEET_SSH_<LOCAL_ID> entry MUST
# be `local` so the controller builds that seat in-process instead of SSHing to
# itself; every other host gets its SSH target.
#
# This file holds NO secrets. Keychain passwords do not belong here: macOS
# build+sign is routed through the seat's logged-in GUI session
# (tools/fleet-gui-exec.py), so the login keychain is already unlocked and no
# password is ever needed over SSH. The macOS signing identity lives in the
# per-seat `.env` as DESKFLOW_CODESIGN_ID (see env.example). tools/fleet-doctor
# fails if any keychain-password key appears in fleet.env*.

# Branch every seat is fast-forwarded to before building.
FLEET_BRANCH=main

# Space-separated host ids. Each id must have a FLEET_SSH_<id> line below.
FLEET_HOSTS="hackintosh macbookpro tiny11"

# SSH target per host id. Set the entry for THIS seat to `local`; on the other
# seats swap which one is `local`. Passwordless keys recommended
# (see scripts/fleet-setup-ssh.sh).
FLEET_SSH_hackintosh=local
FLEET_SSH_macbookpro=macbookpro
FLEET_SSH_tiny11=tiny11

# Optional SSH user override per host (default: your current macOS user on
# Macs, alexh on Windows).
# FLEET_SSH_USER_hackintosh=alexhughes
# FLEET_SSH_USER_macbookpro=alexhughes
# FLEET_SSH_USER_tiny11=alexh

# What to deploy (1 = yes, 0 = no).
FLEET_DEPLOY_DESKFLOW=1
FLEET_DEPLOY_MOUSER=1

# Re-run cmake configure even when build/ already exists (1 = yes).
FLEET_RECONFIGURE=0

# Repo paths per platform (defaults match the Desktop layout).
FLEET_DESKFLOW_PATH_macos=~/Desktop/deskflow
FLEET_MOUSER_PATH_macos=~/Desktop/Mouser
FLEET_DESKFLOW_PATH_windows=C:/Users/alexh/Desktop/deskflow
FLEET_MOUSER_PATH_windows=C:/Users/alexh/Desktop/Mouser

# Windows: SHA-1 thumbprint of the Authenticode signing certificate used by
# scripts/sign-windows.ps1 (`signtool sign /sha1 <thumbprint> /fd SHA256`).
# A thumbprint is a public certificate identifier, not a secret. Find it with:
#   Get-ChildItem Cert:\CurrentUser\My | Format-List Subject, Thumbprint
DESKFLOW_SIGN_THUMBPRINT=

# Operator gate for the `# automation: manual` harness rows (bt-sleep-wake,
# lock-unlock, login-bridge). Leave at 0. Only a HUMAN sets this to 1, on the
# seat where they are physically running the manual scenario; agents never do.
FLEET_OPERATOR=0
