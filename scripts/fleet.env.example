# Fleet deploy configuration — copy to scripts/fleet.env (gitignored).
# Run from hackintosh:  bash scripts/fleet-deploy.sh
#
# SSH: passwordless keys recommended (see scripts/fleet-setup-ssh.sh).
# macOS signing over SSH needs the login keychain unlocked — set per-Mac
# passwords below OR run macbookpro deploy locally at the machine.

FLEET_BRANCH=main

# Space-separated host ids (must match FLEET_SSH_* keys below)
FLEET_HOSTS="hackintosh macbookpro tiny11"

# SSH target per host. Use "local" for this machine (no SSH).
FLEET_SSH_hackintosh=local
FLEET_SSH_macbookpro=macbookpro
FLEET_SSH_tiny11=tiny11

# Optional SSH user override (default: your current macOS user / alexh on Windows)
# FLEET_SSH_USER_macbookpro=alexhughes
# FLEET_SSH_USER_tiny11=alexh

# macOS login keychain passwords (unlock for codesign over SSH). Gitignored in fleet.env.
# FLEET_KEYCHAIN_PASSWORD_hackintosh=
# FLEET_KEYCHAIN_PASSWORD_macbookpro=

# What to deploy (1 = yes, 0 = no)
FLEET_DEPLOY_DESKFLOW=1
FLEET_DEPLOY_MOUSER=1

# Re-run cmake configure even when build/ exists
FLEET_RECONFIGURE=0

# Repo paths (defaults match Desktop layout)
FLEET_DESKFLOW_PATH_macos=~/Desktop/deskflow
FLEET_MOUSER_PATH_macos=~/Desktop/Mouser
FLEET_DESKFLOW_PATH_windows=C:/Users/alexh/Desktop/deskflow
FLEET_MOUSER_PATH_windows=C:/Users/alexh/Desktop/Mouser
