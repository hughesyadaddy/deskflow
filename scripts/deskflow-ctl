#!/usr/bin/env bash
# deskflow-ctl — the ONE way to stop/start/restart Deskflow on macOS.
#
#   scripts/deskflow-ctl stop           launchctl bootout both agents, wait, escalate
#   scripts/deskflow-ctl start          render + launchctl bootstrap (core, then GUI)
#   scripts/deskflow-ctl restart        launchctl kickstart -k (bootstrap if unloaded)
#   scripts/deskflow-ctl status         inventory: launchd state + every Deskflow process
#   scripts/deskflow-ctl assert-single  exit 0 only when exactly one core (owned by
#                                       launchd) and exactly one GUI run from the
#                                       canonical bundle, and nothing runs from
#                                       any other path
#   scripts/deskflow-ctl prio           render the deskflow-prio LaunchDaemon plist;
#                                       install+bootstrap it when root, otherwise
#                                       print the exact sudo commands (also run by
#                                       `start`)
#   scripts/deskflow-ctl converge [--apply] [--quiet]
#                                       report-and-repair: re-render stale plists,
#                                       enable + bootstrap unloaded agents, kickstart
#                                       loaded-but-dead ones. Never kills anything.
#                                       Default prints the plan; --apply acts. Starts
#                                       are skipped while a quit-intent sentinel from
#                                       this boot exists or a deploy lock < 30 min old
#                                       is present; at most 3 start actions per
#                                       rolling hour, then report-only. Writes
#                                       ~/Library/Application Support/Deskflow/health.json.
#                                       Exit 1 when --apply leaves assert-single failing.
#
# launchd is the only owner of deskflow-core and the GUI:
#   gui/$UID/io.github.hughesyadaddy.deskflow-core     deskflow-core auto (KeepAlive on crash)
#   gui/$UID/io.github.hughesyadaddy.deskflow          Deskflow GUI (KeepAlive on crash)
#   gui/$UID/io.github.hughesyadaddy.deskflow-converge `deskflow-ctl converge --apply` every 60 s
#   system/io.github.hughesyadaddy.deskflow-prio       deskflow-prio (root LaunchDaemon,
#                                                      task_for_pid needs root)
# The login-window bridge (/Library/LaunchAgents/org.deskflow.vhid-bridge.plist)
# is untouched. Mouser is never touched: it is an independent agent with its
# own installer.
#
# Env: DESKFLOW_INSTALL_APP (default /Applications/Deskflow.app),
#      DESKFLOW_CTL_STOP_TIMEOUT / DESKFLOW_CTL_START_TIMEOUT (seconds),
#      DESKFLOW_CTL_DAEMON_DIR (default /Library/LaunchDaemons),
#      DESKFLOW_CTL_DAEMON_STAGE_DIR (default ~/Library/Deskflow/launchd).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP="${DESKFLOW_INSTALL_APP:-/Applications/Deskflow.app}"
APP="${APP%/}"
CORE_LABEL="io.github.hughesyadaddy.deskflow-core"
GUI_LABEL="io.github.hughesyadaddy.deskflow"
CONVERGE_LABEL="io.github.hughesyadaddy.deskflow-converge"
PRIO_LABEL="io.github.hughesyadaddy.deskflow-prio"
AGENT_DIR="${DESKFLOW_CTL_AGENT_DIR:-$HOME/Library/LaunchAgents}"
DAEMON_DIR="${DESKFLOW_CTL_DAEMON_DIR:-/Library/LaunchDaemons}"
# Staged (rendered) daemon plist. NOT under ~/Library/LaunchAgents: launchd
# would load it as a user agent at login and deskflow-prio would fail
# task_for_pid every 30 s.
DAEMON_STAGE_DIR="${DESKFLOW_CTL_DAEMON_STAGE_DIR:-$HOME/Library/Deskflow/launchd}"
LOG_DIR="$HOME/Library/Logs/Deskflow"
STATE_DIR="$HOME/Library/Application Support/Deskflow"
QUIT_INTENT="$STATE_DIR/quit-intent"
HEALTH_JSON="$STATE_DIR/health.json"
ACTION_LOG="$STATE_DIR/converge-actions"
DEPLOY_LOCK="$HOME/Library/Deskflow/deploy.lock"
MACHINE_LOCK_DIR="/private/var/db/deskflow"
TEMPLATE_DIR="$ROOT/tools/launchd"
STOP_TIMEOUT="${DESKFLOW_CTL_STOP_TIMEOUT:-10}"
START_TIMEOUT="${DESKFLOW_CTL_START_TIMEOUT:-15}"
ESCALATE_TIMEOUT="${DESKFLOW_CTL_ESCALATE_TIMEOUT:-5}"
CONVERGE_BUDGET=3
CONVERGE_BUDGET_WINDOW=3600
DEPLOY_LOCK_MAX_AGE=1800
DOMAIN="gui/$(id -u)"

# `kill` is a bash builtin; disable it so the external binary is used and a
# PATH shim can observe the escalation in tests.
enable -n kill 2>/dev/null || true # fleet:allow builtin may already be disabled

usage() { sed -n '2,/^set -euo pipefail/p' "${BASH_SOURCE[0]}" | sed '$d'; }
die() { echo "deskflow-ctl: $*" >&2; exit 1; }
log() { echo "== deskflow-ctl: $* =="; }

# ---------------------------------------------------------------- inventory
# Every Deskflow-named process on the box, by executable path (never by
# pattern). Output lines: "<pid>\t<uid>\t<path>".
inventory() {
  ps -axo pid=,uid=,comm= 2>/dev/null | awk '
    {
      pid=$1; uid=$2; $1=""; $2=""; sub(/^  */, "");
      path=$0; n=split(path, parts, "/"); base=parts[n];
      if (base == "deskflow-core" || base == "Deskflow" || base == "deskflow" ||
          base == "deskflow-vhid-bridge" || index(path, "Deskflow.app/Contents/MacOS/") > 0)
        printf "%s\t%s\t%s\n", pid, uid, path
    }'
}

canonical_path() { [[ "$1" == "$APP/Contents/MacOS/"* ]]; }

# The processes `stop` owns: this user's deskflow-core and Deskflow GUI from
# the canonical bundle. Filtered by uid and basename on purpose: the root
# LoginWindow vhid-bridge and the root deskflow-prio LaunchDaemon also run
# from the bundle, and waiting on / signalling them makes `stop` hang forever
# (or EPERM) at the login window.
pids_under_bundle() {
  inventory | awk -F'\t' -v app="$APP/Contents/MacOS/" -v uid="$(id -u)" '
    index($3, app) == 1 && $2 == uid {
      n = split($3, parts, "/"); base = parts[n]
      if (base == "deskflow-core" || base == "Deskflow") print $1
    }'
}

count_role() {
  # $1 = basename, $2 = "canonical" | "any"
  local base="$1" scope="${2:-canonical}" n=0 pid uid path
  while IFS=$'\t' read -r pid uid path; do
    [[ "$(basename "$path")" == "$base" ]] || continue
    if [[ "$scope" == "canonical" ]]; then canonical_path "$path" || continue; fi
    n=$((n + 1))
  done < <(inventory)
  echo "$n"
}

# --------------------------------------------------------------- launchd
agent_loaded() { launchctl print "$DOMAIN/$1" >/dev/null 2>&1; }

agent_pid() {
  # Prints the pid launchd reports for a label, or nothing when not running.
  # `launchctl print` exits non-zero when the label isn't loaded; under
  # `set -euo pipefail` that failure propagates through the pipe and — for
  # callers that assign this via `x="$(agent_pid ...)"` — aborts the whole
  # script instead of yielding an empty string. `|| true` on the producer
  # keeps this a plain "no pid" result in every case.
  launchctl print "$DOMAIN/$1" 2>/dev/null | awk '/^[[:space:]]*pid = / { print $3; exit }' || true # fleet:allow launchctl exits non-zero when the label isn't loaded; empty output is the intended "no pid" result
}

render_agent_to() {
  # $1 = label, $2 = output file. Renders tools/launchd/<label>.plist with the
  # bundle, home and ctl path substituted.
  local src="$TEMPLATE_DIR/$1.plist"
  [[ -f "$src" ]] || die "missing template $src"
  sed -e "s#__APP__#$APP#g" -e "s#__HOME__#$HOME#g" -e "s#__CTL__#$ROOT/scripts/deskflow-ctl#g" "$src" >"$2"
}

agent_plist_stale() {
  # $1 = label. True when $AGENT_DIR/<label>.plist is missing or differs from
  # a fresh render.
  local tmp rc=1
  tmp="$(mktemp "${TMPDIR:-/tmp}/deskflow-ctl.XXXXXX")"
  render_agent_to "$1" "$tmp"
  if [[ ! -f "$AGENT_DIR/$1.plist" ]] || ! cmp -s "$tmp" "$AGENT_DIR/$1.plist"; then rc=0; fi
  rm -f "$tmp"
  return "$rc"
}

render_agent() {
  # $1 = label. Renders into $AGENT_DIR; only rewrites when the content changed.
  local label="$1" dst="$AGENT_DIR/$1.plist" tmp
  mkdir -p "$AGENT_DIR" "$LOG_DIR"
  tmp="$(mktemp "${TMPDIR:-/tmp}/deskflow-ctl.XXXXXX")"
  render_agent_to "$label" "$tmp"
  if [[ -f "$dst" ]] && cmp -s "$tmp" "$dst"; then
    rm -f "$tmp"
  else
    mv "$tmp" "$dst"
    chmod 644 "$dst"
    log "rendered $dst"
  fi
}

# ------------------------------------------------------- prio LaunchDaemon
render_prio_daemon() {
  # Renders tools/launchd/$PRIO_LABEL.plist into $DAEMON_STAGE_DIR. The
  # template carries the default bundle path literally (LaunchDaemons cannot
  # expand anything), so both the __APP__ placeholder and the literal
  # /Applications/Deskflow.app are rewritten to $APP. Prints the staged path.
  local src="$TEMPLATE_DIR/$PRIO_LABEL.plist" dst="$DAEMON_STAGE_DIR/$PRIO_LABEL.plist" tmp
  [[ -f "$src" ]] || die "missing template $src"
  mkdir -p "$DAEMON_STAGE_DIR"
  tmp="$(mktemp "${TMPDIR:-/tmp}/deskflow-ctl.XXXXXX")"
  sed -e "s#__APP__#$APP#g" -e "s#/Applications/Deskflow\.app#$APP#g" "$src" >"$tmp"
  if [[ -f "$dst" ]] && cmp -s "$tmp" "$dst"; then
    rm -f "$tmp"
  else
    mv "$tmp" "$dst"
    chmod 644 "$dst"
    log "rendered $dst" >&2 # stdout is the staged path (command substitution)
  fi
  echo "$dst"
}

daemon_loaded() { launchctl print "system/$1" >/dev/null 2>&1; }

prio_binary_owner_ok() {
  # LaunchDaemons should not run a user-writable binary as root: require root:wheel.
  local bin="$1" owner
  owner="$(stat -f '%Su:%Sg' "$bin" 2>/dev/null || true)" # fleet:allow stat failure = not ok
  [[ "$owner" == "root:wheel" ]]
}

cmd_prio() {
  local bin="$APP/Contents/MacOS/deskflow-prio" staged installed
  if [[ ! -x "$bin" ]]; then
    log "deskflow-prio not in bundle ($bin); skipping LaunchDaemon"
    return 0
  fi
  staged="$(render_prio_daemon)"
  installed="$DAEMON_DIR/$PRIO_LABEL.plist"

  if daemon_loaded "$PRIO_LABEL" && [[ -f "$installed" ]] && cmp -s "$staged" "$installed" &&
     prio_binary_owner_ok "$bin"; then
    log "prio: system/$PRIO_LABEL loaded, $installed up to date, $bin is root:wheel"
    return 0
  fi

  if [[ "$(id -u)" -eq 0 ]]; then
    log "prio: installing $installed and bootstrapping system/$PRIO_LABEL"
    install -d "$DAEMON_DIR"
    install -d -m 1777 "$MACHINE_LOCK_DIR"
    install -m 644 -o root -g wheel "$staged" "$installed"
    chown root:wheel "$bin"
    if daemon_loaded "$PRIO_LABEL"; then
      launchctl bootout "system/$PRIO_LABEL" || die "launchctl bootout system/$PRIO_LABEL failed"
    fi
    launchctl bootstrap system "$installed"
    return 0
  fi

  # No privilege escalation inside the ctl (no sudo prompts from a deploy
  # over SSH, no osascript). Documented human step, exact commands:
  cat <<EOF
== deskflow-ctl: prio: system/$PRIO_LABEL needs root; run once as admin: ==
  sudo install -d $DAEMON_DIR
  sudo install -d -m 1777 $MACHINE_LOCK_DIR
  sudo install -m 644 -o root -g wheel "$staged" "$installed"
  sudo chown root:wheel "$bin"
  sudo launchctl bootout system/$PRIO_LABEL 2>/dev/null; sudo launchctl bootstrap system "$installed"
(rendered from $TEMPLATE_DIR/$PRIO_LABEL.plist; verify with: sudo launchctl print system/$PRIO_LABEL)
EOF
  return 0
}

bootstrap_agent() {
  local label="$1" plist="$AGENT_DIR/$1.plist"
  render_agent "$label"
  # A label disabled by an earlier `launchctl disable` (or the Login Items
  # pane) makes bootstrap fail silently at login; enable is idempotent.
  launchctl enable "$DOMAIN/$label"
  if agent_loaded "$label"; then
    # Already loaded (e.g. previous start with KeepAlive false and a clean
    # exit): kickstart runs it if it is not running.
    launchctl kickstart "$DOMAIN/$label"
  else
    launchctl bootstrap "$DOMAIN" "$plist"
  fi
}

bootout_agent() {
  local label="$1"
  agent_loaded "$label" || return 0
  launchctl bootout "$DOMAIN/$label" || die "launchctl bootout $DOMAIN/$label failed"
}

kickstart_agent() {
  local label="$1"
  if agent_loaded "$label"; then
    launchctl kickstart -k "$DOMAIN/$label"
  else
    bootstrap_agent "$label"
  fi
}

# ------------------------------------------------------------------- verbs
wait_gone() {
  # Wait up to $1 seconds for no process to run from the bundle.
  local deadline=$(( $(date +%s) + $1 ))
  while [[ -n "$(pids_under_bundle)" ]]; do
    (( $(date +%s) >= deadline )) && return 1
    sleep 0.5
  done
  return 0
}

write_quit_intent() {
  mkdir -p "$STATE_DIR"
  date +%s >"$QUIT_INTENT"
}

clear_quit_intent() { rm -f "$QUIT_INTENT"; }

cmd_stop() {
  log "stop (launchctl bootout $DOMAIN/{$CONVERGE_LABEL,$GUI_LABEL,$CORE_LABEL})"
  # The sentinel goes first: a converge tick racing this stop must not
  # bootstrap the agents straight back.
  write_quit_intent
  bootout_agent "$CONVERGE_LABEL"
  bootout_agent "$GUI_LABEL"
  bootout_agent "$CORE_LABEL"
  if wait_gone "$STOP_TIMEOUT"; then
    log "stopped"
    return 0
  fi
  # Escalate by PID only — never `pkill -f`, which also matches Mouser and
  # anything with "deskflow" in its argv.
  local sig
  for sig in TERM KILL; do
    local pids
    pids="$(pids_under_bundle)"
    [[ -n "$pids" ]] || break
    log "escalating: SIG$sig to $(echo "$pids" | tr '\n' ' ')"
    for pid in $pids; do
      kill "-$sig" "$pid" 2>/dev/null || true # fleet:allow pid may have exited already
    done
    wait_gone "$ESCALATE_TIMEOUT" && break
  done
  if [[ -n "$(pids_under_bundle)" ]]; then
    die "processes still running from $APP after SIGKILL: $(pids_under_bundle | tr '\n' ' ')"
  fi
  log "stopped (escalated)"
}

cmd_start() {
  [[ -d "$APP" ]] || die "bundle missing: $APP"
  [[ -x "$APP/Contents/MacOS/deskflow-core" ]] || die "missing $APP/Contents/MacOS/deskflow-core"
  log "start ($DOMAIN/$CORE_LABEL then $DOMAIN/$GUI_LABEL, then $DOMAIN/$CONVERGE_LABEL)"
  clear_quit_intent
  bootstrap_agent "$CORE_LABEL"
  local deadline=$(( $(date +%s) + START_TIMEOUT ))
  while [[ -z "$(agent_pid "$CORE_LABEL")" ]]; do
    (( $(date +%s) >= deadline )) && die "deskflow-core did not start under launchd within ${START_TIMEOUT}s (see $LOG_DIR/deskflow-core.log)"
    sleep 0.5
  done
  bootstrap_agent "$GUI_LABEL"
  bootstrap_agent "$CONVERGE_LABEL"
  log "started: core pid $(agent_pid "$CORE_LABEL")"
  cmd_prio
}

cmd_restart() {
  log "restart (launchctl kickstart -k)"
  clear_quit_intent
  kickstart_agent "$CORE_LABEL"
  kickstart_agent "$GUI_LABEL"
}

# ---------------------------------------------------------------- converge
boot_epoch() {
  # Seconds since the epoch at the last boot; 0 when unknown (then every
  # sentinel counts as current, the safe direction: no unwanted starts).
  local sec
  sec="$(sysctl -n kern.boottime 2>/dev/null | sed -n 's/^{ sec = \([0-9]*\).*/\1/p' | head -1)"
  echo "${sec:-0}"
}

file_mtime() { stat -f %m "$1" 2>/dev/null || echo 0; } # fleet:allow missing file = epoch 0

quit_intent_active() {
  # A sentinel written before the last boot is stale: a reboot ends a quit.
  [[ -f "$QUIT_INTENT" ]] || return 1
  if (( $(file_mtime "$QUIT_INTENT") < $(boot_epoch) )); then
    rm -f "$QUIT_INTENT"
    return 1
  fi
  return 0
}

deploy_lock_active() {
  [[ -f "$DEPLOY_LOCK" ]] || return 1
  (( $(date +%s) - $(file_mtime "$DEPLOY_LOCK") < DEPLOY_LOCK_MAX_AGE ))
}

budget_used() {
  # Start actions recorded in the last CONVERGE_BUDGET_WINDOW seconds.
  local cutoff=$(( $(date +%s) - CONVERGE_BUDGET_WINDOW ))
  [[ -f "$ACTION_LOG" ]] || { echo 0; return; }
  awk -v cutoff="$cutoff" '$1 >= cutoff { n++ } END { print n + 0 }' "$ACTION_LOG"
}

budget_record() {
  mkdir -p "$STATE_DIR"
  local cutoff=$(( $(date +%s) - CONVERGE_BUDGET_WINDOW )) tmp
  tmp="$(mktemp "${TMPDIR:-/tmp}/deskflow-ctl.XXXXXX")"
  { [[ -f "$ACTION_LOG" ]] && awk -v cutoff="$cutoff" '$1 >= cutoff' "$ACTION_LOG"; date +%s; } >"$tmp"
  mv "$tmp" "$ACTION_LOG"
}

json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

json_list() {
  # Joins the remaining arguments as a JSON array of strings.
  local out="" item
  for item in "$@"; do
    out+="${out:+, }\"$(json_escape "$item")\""
  done
  printf '[%s]' "$out"
}

CONVERGE_PLAN=()
CONVERGE_DONE=()
CONVERGE_ERRORS=()
CONVERGE_GATE=""
CONVERGE_NEEDS_REBOOTSTRAP=0

converge_agent() {
  # $1 = label, $2 = apply (0/1), $3 = starts allowed (0/1), $4 = kickstart
  # when loaded-but-dead (0/1: a StartInterval job is idle between runs, so
  # "no pid" is its normal state).
  local label="$1" apply="$2" starts_ok="$3" kick_dead="$4"
  local loaded=0
  agent_loaded "$label" && loaded=1
  if agent_plist_stale "$label"; then
    local render="render $label"
    # launchd keeps the definition it loaded; a re-rendered file only takes
    # effect at the next bootstrap, so this is a pending change, not a repair.
    if (( loaded )); then
      render="render $label (takes effect at next deskflow-ctl start/restart)"
      CONVERGE_NEEDS_REBOOTSTRAP=1
    fi
    CONVERGE_PLAN+=("$render")
    if (( apply )); then
      render_agent "$label" >/dev/null
      (( loaded )) || CONVERGE_DONE+=("$render")
    fi
  fi
  local want=""
  if (( ! loaded )); then
    want="bootstrap $label"
  elif (( kick_dead )) && [[ -z "$(agent_pid "$label")" ]]; then
    want="kickstart $label"
  fi
  [[ -n "$want" ]] || return 0
  CONVERGE_PLAN+=("$want")
  (( apply && starts_ok )) || return 0
  if (( $(budget_used) >= CONVERGE_BUDGET )); then
    CONVERGE_GATE="action budget exhausted ($CONVERGE_BUDGET/$CONVERGE_BUDGET in the last $((CONVERGE_BUDGET_WINDOW / 60)) min); report-only"
    return 0
  fi
  # Never `kickstart -k`: converge repairs absence, it does not restart the living.
  [[ -f "$AGENT_DIR/$label.plist" ]] || render_agent "$label" >/dev/null
  # Every attempt spends budget, successful or not: a launchctl that keeps
  # failing must not be retried every 60 s forever.
  budget_record
  local err=""
  if ! err="$(launchctl enable "$DOMAIN/$label" 2>&1)"; then
    CONVERGE_ERRORS+=("enable $label: ${err:-rc $?}")
    return 0
  fi
  if [[ "$want" == bootstrap* ]]; then
    err="$(launchctl bootstrap "$DOMAIN" "$AGENT_DIR/$label.plist" 2>&1)" || { CONVERGE_ERRORS+=("$want: ${err:-failed}"); return 0; }
  else
    err="$(launchctl kickstart "$DOMAIN/$label" 2>&1)" || { CONVERGE_ERRORS+=("$want: ${err:-failed}"); return 0; }
  fi
  CONVERGE_DONE+=("$want")
}

write_health_json() {
  # $1 = mode, $2 = gate, $3 = assert result, $4 = budget used
  mkdir -p "$STATE_DIR"
  local tmp label pid agents=""
  tmp="$(mktemp "${TMPDIR:-/tmp}/deskflow-ctl.XXXXXX")"
  for label in "$CORE_LABEL" "$GUI_LABEL" "$CONVERGE_LABEL"; do
    if agent_loaded "$label"; then
      pid="$(agent_pid "$label")"
      agents+="${agents:+, }\"$label\": {\"loaded\": true, \"pid\": ${pid:-null}}"
    else
      agents+="${agents:+, }\"$label\": {\"loaded\": false, \"pid\": null}"
    fi
  done
  cat >"$tmp" <<EOF
{
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "mode": "$1",
  "gate": "$(json_escape "$2")",
  "bundle": "$(json_escape "$APP")",
  "counts": {"core": $(count_role deskflow-core), "gui": $(count_role Deskflow), "bridge": $(count_role deskflow-vhid-bridge any)},
  "agents": {$agents},
  "plan": $(json_list ${CONVERGE_PLAN[@]+"${CONVERGE_PLAN[@]}"}),
  "actions": $(json_list ${CONVERGE_DONE[@]+"${CONVERGE_DONE[@]}"}),
  "errors": $(json_list ${CONVERGE_ERRORS[@]+"${CONVERGE_ERRORS[@]}"}),
  "needs_rebootstrap": $([[ $CONVERGE_NEEDS_REBOOTSTRAP -eq 1 ]] && echo true || echo false),
  "budget": {"used": $4, "max": $CONVERGE_BUDGET, "window_seconds": $CONVERGE_BUDGET_WINDOW},
  "assert_single": "$(json_escape "$3")"
}
EOF
  mv "$tmp" "$HEALTH_JSON"
}

notify() {
  osascript -e "display notification \"$(json_escape "$1")\" with title \"Deskflow\"" >/dev/null 2>&1 || true # fleet:allow no WindowServer (ssh, login window) = no toast
}

cmd_converge() {
  local apply=0 quiet=0 arg
  for arg in "$@"; do
    case "$arg" in
      --apply) apply=1 ;;
      --quiet) quiet=1 ;;
      *) die "converge: unknown option '$arg'" ;;
    esac
  done
  [[ -d "$APP" ]] || die "bundle missing: $APP"

  local starts_ok=1 intended=0 used mode="plan"
  (( apply )) && mode="apply"
  used="$(budget_used)"
  if deploy_lock_active; then
    CONVERGE_GATE="deploy lock $DEPLOY_LOCK is younger than $((DEPLOY_LOCK_MAX_AGE / 60)) min"
    intended=1
  elif quit_intent_active; then
    CONVERGE_GATE="quit-intent set after last boot ($QUIT_INTENT)"
    intended=1
  elif (( used >= CONVERGE_BUDGET )); then
    CONVERGE_GATE="action budget exhausted ($used/$CONVERGE_BUDGET in the last $((CONVERGE_BUDGET_WINDOW / 60)) min); report-only"
  fi
  [[ -z "$CONVERGE_GATE" ]] || starts_ok=0

  if [[ "$CONVERGE_GATE" == "deploy lock"* ]]; then
    write_health_json "$mode" "$CONVERGE_GATE" "skipped" "$used"
    (( quiet )) || log "converge: $CONVERGE_GATE; nothing done"
    return 0
  fi

  converge_agent "$CORE_LABEL" "$apply" "$starts_ok" 1
  converge_agent "$GUI_LABEL" "$apply" "$starts_ok" 1
  converge_agent "$CONVERGE_LABEL" "$apply" "$starts_ok" 0
  local gate="$CONVERGE_GATE"

  local assert_out assert_rc=0
  assert_out="$(cmd_assert_single 2>&1)" || assert_rc=$?
  local assert_summary="OK"
  (( assert_rc == 0 )) || assert_summary="FAIL: $(echo "$assert_out" | sed -n '2,$p' | sed 's/^  //' | paste -sd ';' -)"

  write_health_json "$mode" "${gate:-none}" "$assert_summary" "$(budget_used)"

  # A quit-intent or deploy-lock gate makes a failing assert-single expected;
  # a run that was free to act (or is out of budget) and still fails is not.
  # A launchctl failure is always a failure.
  local failing=0
  (( apply && assert_rc != 0 && ! intended )) && failing=1
  (( ${#CONVERGE_ERRORS[@]} )) && failing=1
  local verbose=1
  (( quiet )) && (( ! failing )) && verbose=0

  if (( ${#CONVERGE_ERRORS[@]} )); then
    log "converge: FAILED: $(printf '%s; ' "${CONVERGE_ERRORS[@]}")"
    notify "converge FAILED: $(printf '%s; ' "${CONVERGE_ERRORS[@]}")"
  elif (( ${#CONVERGE_DONE[@]} )); then
    log "converge: acted: $(printf '%s; ' "${CONVERGE_DONE[@]}")"
    notify "converge repaired: $(printf '%s; ' "${CONVERGE_DONE[@]}")"
  elif (( verbose )); then
    if (( ${#CONVERGE_PLAN[@]} )); then
      log "converge: plan (${mode}${gate:+; gated: $gate}): $(printf '%s; ' "${CONVERGE_PLAN[@]}")"
    else
      log "converge: nothing to do${gate:+ (gated: $gate)}"
    fi
  fi
  (( verbose )) && echo "$assert_out"
  return "$failing"
}

cmd_status() {
  local label pid
  echo "bundle: $APP"
  for label in "$CORE_LABEL" "$GUI_LABEL"; do
    if agent_loaded "$label"; then
      pid="$(agent_pid "$label")"
      echo "agent: $label loaded pid=${pid:-none}"
    else
      echo "agent: $label not loaded"
    fi
  done
  echo "processes (pid uid path canonical):"
  local uid path
  while IFS=$'\t' read -r pid uid path; do
    if canonical_path "$path"; then
      echo "  $pid $uid $path yes"
    else
      echo "  $pid $uid $path NO"
    fi
  done < <(inventory)
}

cmd_assert_single() {
  local problems=() pid uid path
  local cores gui bridge core_pid launchd_pid
  cores="$(count_role deskflow-core)"
  gui="$(count_role Deskflow)"
  bridge="$(count_role deskflow-vhid-bridge any)"
  while IFS=$'\t' read -r pid uid path; do
    canonical_path "$path" || problems+=("non-canonical process pid=$pid $path")
  done < <(inventory)
  [[ "$cores" -eq 1 ]] || problems+=("deskflow-core count=$cores (want 1)")
  [[ "$gui" -eq 1 ]] || problems+=("Deskflow GUI count=$gui (want 1)")
  [[ "$bridge" -le 1 ]] || problems+=("deskflow-vhid-bridge count=$bridge (want <=1)")
  launchd_pid="$(agent_pid "$CORE_LABEL")"
  if [[ -z "$launchd_pid" ]]; then
    problems+=("$CORE_LABEL has no running pid under launchd")
  elif [[ "$cores" -eq 1 ]]; then
    core_pid="$(inventory | awk -F'\t' -v app="$APP/Contents/MacOS/deskflow-core" '$3 == app { print $1 }')"
    [[ "$core_pid" == "$launchd_pid" ]] || problems+=("deskflow-core pid $core_pid is not launchd's ($launchd_pid)")
  fi
  if ((${#problems[@]})); then
    printf 'deskflow-ctl assert-single: FAIL\n' >&2
    printf '  %s\n' "${problems[@]}" >&2
    return 1
  fi
  echo "deskflow-ctl assert-single: OK (core=1 launchd-owned, gui=1, bridge=$bridge)"
}

case "${1:-}" in
  stop) cmd_stop ;;
  start) cmd_start ;;
  restart) cmd_restart ;;
  status) cmd_status ;;
  assert-single) cmd_assert_single ;;
  prio) cmd_prio ;;
  converge) cmd_converge "${@:2}" ;;
  -h|--help|help) usage ;;
  *) usage >&2; die "unknown verb '${1:-}'" ;;
esac
