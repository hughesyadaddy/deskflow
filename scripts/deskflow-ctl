#!/usr/bin/env bash
# deskflow-ctl — the ONE way to stop/start/restart Deskflow on macOS.
#
#   scripts/deskflow-ctl stop           launchctl bootout the three agents, wait, then
#                                       TERM/KILL every deskflow-core/Deskflow this
#                                       user still runs, from ANY path (each one makes
#                                       `start` refuse). Another uid's is never
#                                       signalled: the exact `sudo kill` line is
#                                       printed and stop exits 1, never "stopped".
#   scripts/deskflow-ctl start          render + launchctl bootstrap (core, then GUI,
#                                       then converge). A loaded label whose LOADED
#                                       definition (launchctl print argv/env) differs
#                                       from the render is booted out and bootstrapped
#                                       again; a current one is only kickstarted.
#   scripts/deskflow-ctl restart        launchctl kickstart -k (bootstrap if unloaded;
#                                       bootout+bootstrap if the loaded definition is stale)
#   scripts/deskflow-ctl status         inventory: launchd state + every Deskflow process
#   scripts/deskflow-ctl assert-single  exit 0 only when exactly one core (owned by
#                                       launchd) and exactly one GUI run from the
#                                       canonical bundle, and nothing runs from
#                                       any other path
#   scripts/deskflow-ctl prio           render the deskflow-prio LaunchDaemon plist;
#                                       install+bootstrap it when root, otherwise
#                                       print the exact sudo commands (also run by
#                                       `start`)
#   scripts/deskflow-ctl login-items audit [--fix] [--stdin]
#                                       one launcher only: parse `sfltool dumpbtm`
#                                       and FAIL (exit 1) on any enabled BTM app /
#                                       login-item record for deskflow|synergy|
#                                       barrier, or more than one such app record;
#                                       the fleet LaunchAgents are allowed. Prints
#                                       the exact System Settings step. SKIP (exit
#                                       3, never PASS) when dumpbtm needs root.
#                                       --fix first tries the legacy System Events
#                                       delete, then re-audits. --stdin reads a dump
#                                       from stdin (`sudo sfltool dumpbtm | ...`).
#   scripts/deskflow-ctl login-items print-steps
#                                       print the manual removal steps only
#   scripts/deskflow-ctl retire         remove retired fleet files this user owns
#                                       (keepalive log); print, never run, the sudo
#                                       lines for the root-owned ones. Exit 2 while
#                                       root steps remain.
#   scripts/deskflow-ctl converge [--apply] [--quiet]
#                                       report-and-repair: re-render stale plists,
#                                       enable + bootstrap unloaded agents, kickstart
#                                       loaded-but-dead ones. Never kills anything.
#                                       Default prints the plan; --apply acts. Starts
#                                       are skipped while a quit-intent sentinel from
#                                       this boot exists or a deploy lock < 30 min old
#                                       is present; at most 3 start actions per
#                                       rolling hour, then report-only. Writes
#                                       ~/Library/Application Support/Deskflow/health.json.
#                                       Exit 1 when --apply leaves assert-single failing
#                                       or the login-items audit fails. Report-only
#                                       (exit 1) while its own agent cannot run its
#                                       program (TCC EPERM / exit 126 evidence).
#   scripts/deskflow-ctl safe-copy      install/refresh the launchd-safe copy under
#                                       ~/Library/Deskflow/bin (this script, the
#                                       tools/launchd templates, tools/fleet-soak;
#                                       diff-and-replace, 755/644). The converge and
#                                       soak agents run from there: macOS TCC gives
#                                       a launchd job EPERM (no prompt, exit 126) on
#                                       anything under ~/Desktop, ~/Documents or
#                                       ~/Downloads, i.e. on every checkout. Also run
#                                       by `start`.
#   scripts/deskflow-ctl render-plist <label>
#                                       print a rendered tools/launchd/<label>.plist
#                                       (com.fleet.soak, ...) to stdout; installs and
#                                       loads nothing. Refuses a render that points
#                                       launchd into a TCC-protected folder.
#
# launchd is the only owner of deskflow-core and the GUI:
#   gui/$UID/io.github.hughesyadaddy.deskflow-core     deskflow-core auto (KeepAlive on crash)
#   gui/$UID/io.github.hughesyadaddy.deskflow          Deskflow GUI (KeepAlive on crash)
#   gui/$UID/io.github.hughesyadaddy.deskflow-converge `deskflow-ctl converge --apply` every 60 s
#   system/io.github.hughesyadaddy.deskflow-prio       deskflow-prio (root LaunchDaemon,
#                                                      task_for_pid needs root)
# The login-window bridge (/Library/LaunchAgents/org.deskflow.vhid-bridge.plist)
# is untouched. Mouser is never touched: it is an independent agent with its
# own installer.
#
# Env: DESKFLOW_INSTALL_APP (default /Applications/Deskflow.app),
#      DESKFLOW_CTL_STOP_TIMEOUT / DESKFLOW_CTL_START_TIMEOUT (seconds),
#      DESKFLOW_CTL_DAEMON_DIR (default /Library/LaunchDaemons),
#      DESKFLOW_CTL_DAEMON_STAGE_DIR (default ~/Library/Deskflow/launchd),
#      DESKFLOW_CTL_RETIRED_PRIO_APPLY / DESKFLOW_CTL_RETIRED_SYNERGY_AGENT
#      (retired root-owned paths; overridable for tests only),
#      DESKFLOW_CTL_SAFE_DIR (default ~/Library/Deskflow/bin; must not be under
#      ~/Desktop, ~/Documents, ~/Downloads, iCloud Drive or /Volumes -- checked
#      canonical (symlinks, ..) and case-insensitive, APFS is),
#      DESKFLOW_ROOT (the checkout; only read by the launchd-safe copy, only
#      for `safe-copy`/`start`; validated: a value that is not a checkout is a
#      warning for `start` (then the checkout recorded by the last safe-copy,
#      else none) and an error for `safe-copy`; never rendered into a plist
#      and never needed by `converge`),
#      DESKFLOW_CTL_SOAK_DIR (default ~/Library/Deskflow/soak; com.fleet.soak output).
set -euo pipefail

# Two homes. The checkout (scripts/deskflow-ctl: humans, deploys) and the
# launchd-safe copy under ~/Library/Deskflow/bin that the converge and soak
# agents run. macOS TCC guards ~/Desktop, ~/Documents and ~/Downloads per
# consenting app; a launchd job has none, so it gets EPERM there with no
# prompt -- from deploy until 2026-09-25 the converge tick on macbookpro died
# with "/bin/bash: ~/Desktop/deskflow/scripts/deskflow-ctl: Operation not
# permitted" (exit 126) every 60 s. `start`/`safe-copy` refresh the safe copy
# (diff-and-replace); a tick never reads the checkout.
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
CTL_SELF="$SELF_DIR/${BASH_SOURCE[0]##*/}"
SAFE_DIR="${DESKFLOW_CTL_SAFE_DIR:-$HOME/Library/Deskflow/bin}"
SAFE_DIR="${SAFE_DIR%/}"
SAFE_CTL="$SAFE_DIR/deskflow-ctl"
SAFE_TEMPLATE_DIR="$SAFE_DIR/launchd"
IS_SAFE_COPY=0
if [[ -d "$SAFE_DIR" && "$SELF_DIR" == "$(cd "$SAFE_DIR" && pwd -P)" ]]; then IS_SAFE_COPY=1; fi
# Where the last `safe-copy` came from, recorded by it: the copy's own way
# back to a checkout when DESKFLOW_ROOT is unset. A vanished one is simply
# "no checkout known" -- never named, never fatal.
SAFE_CHECKOUT_FILE="$SAFE_DIR/checkout"
is_checkout() { [[ -n "$1" && -f "$1/scripts/deskflow-ctl" && -d "$1/tools/launchd" ]]; }
ROOT_WARNING=""
if (( IS_SAFE_COPY )); then
  ROOT="${DESKFLOW_ROOT:-}"
  ROOT="${ROOT/#\~/$HOME}"
  if [[ -n "$ROOT" ]] && ! is_checkout "$ROOT"; then
    ROOT_WARNING="DESKFLOW_ROOT=$ROOT is not a deskflow checkout (no scripts/deskflow-ctl + tools/launchd there); ignored"
    ROOT=""
  fi
  if [[ -z "$ROOT" && -f "$SAFE_CHECKOUT_FILE" ]]; then
    ROOT="$(head -n 1 "$SAFE_CHECKOUT_FILE" 2>/dev/null || true)" # fleet:allow unreadable record = no checkout known
    is_checkout "$ROOT" || ROOT=""
  fi
else
  ROOT="$(cd "$SELF_DIR/.." && pwd)"
fi
APP="${DESKFLOW_INSTALL_APP:-/Applications/Deskflow.app}"
APP="${APP%/}"
CORE_LABEL="io.github.hughesyadaddy.deskflow-core"
GUI_LABEL="io.github.hughesyadaddy.deskflow"
CONVERGE_LABEL="io.github.hughesyadaddy.deskflow-converge"
PRIO_LABEL="io.github.hughesyadaddy.deskflow-prio"
AGENT_DIR="${DESKFLOW_CTL_AGENT_DIR:-$HOME/Library/LaunchAgents}"
DAEMON_DIR="${DESKFLOW_CTL_DAEMON_DIR:-/Library/LaunchDaemons}"
# Staged (rendered) daemon plist. NOT under ~/Library/LaunchAgents: launchd
# would load it as a user agent at login and deskflow-prio would fail
# task_for_pid every 30 s.
DAEMON_STAGE_DIR="${DESKFLOW_CTL_DAEMON_STAGE_DIR:-$HOME/Library/Deskflow/launchd}"
LOG_DIR="$HOME/Library/Logs/Deskflow"
STATE_DIR="$HOME/Library/Application Support/Deskflow"
QUIT_INTENT="$STATE_DIR/quit-intent"
HEALTH_JSON="$STATE_DIR/health.json"
ACTION_LOG="$STATE_DIR/converge-actions"
DEPLOY_LOCK="$HOME/Library/Deskflow/deploy.lock"
MACHINE_LOCK_DIR="/private/var/db/deskflow"
# Templates are rendered from the launchd-safe copy once it exists, so a
# checkout-run converge and the tick agree on what "stale" means; before the
# first `start` (or with no checkout at all) the checkout's are used.
TEMPLATE_DIR="$SAFE_TEMPLATE_DIR"
[[ -d "$TEMPLATE_DIR" ]] || TEMPLATE_DIR="${ROOT:+$ROOT/tools/launchd}"
CONVERGE_LOG="$LOG_DIR/converge.log"
CONVERGE_EPERM_WINDOW=600
# What launchd's shell prints when TCC refuses the script it was handed:
# "/bin/bash: <path>: Operation not permitted" (exit 126). Shape-specific on
# purpose: a tick's own "<script>: line N: <file>: Permission denied" (its
# redirection, not its program) is not this. Group 3 is the refused path.
CONVERGE_EPERM_RE='^(/[^:]*/)?(bash|sh|zsh|dash|env): (/[^:]+): (Operation not permitted|Permission denied)[[:space:]]*$'
SOAK_DIR="${DESKFLOW_CTL_SOAK_DIR:-$HOME/Library/Deskflow/soak}"
# Folders macOS TCC guards per consenting app: a launchd job has none, so it
# gets EPERM there with no prompt (exit 126). Paths are compared canonical
# (symlinks and .. resolved) and case-insensitively, since APFS is.
# shellcheck disable=SC2088  # display text, the ~ is deliberate
TCC_FOLDERS="~/Desktop, ~/Documents, ~/Downloads, iCloud Drive (~/Library/Mobile Documents) or /Volumes"
tcc_roots() { printf '%s\n' "$HOME/Desktop" "$HOME/Documents" "$HOME/Downloads" "$HOME/Library/Mobile Documents" "/Volumes"; }
# A plist <string> value under such a folder (any account, ~, $HOME; grep -i).
TCC_STRING_RE='<string>[^<]*(/Desktop|/Documents|/Downloads|/Library/Mobile Documents|/Volumes)(/|<)'
# launchd's `exit timeout` for these labels (`launchctl print` shows it):
# bootout sends SIGTERM and launchd SIGKILLs this many seconds later.
# STOP_TIMEOUT, the wait after a bootout before by-pid escalation, covers it.
LAUNCHD_EXIT_TIMEOUT=5
STOP_TIMEOUT="${DESKFLOW_CTL_STOP_TIMEOUT:-10}"
START_TIMEOUT="${DESKFLOW_CTL_START_TIMEOUT:-15}"
ESCALATE_TIMEOUT="${DESKFLOW_CTL_ESCALATE_TIMEOUT:-5}"
CONVERGE_BUDGET=3
CONVERGE_BUDGET_WINDOW=3600
DEPLOY_LOCK_MAX_AGE=1800
ME_UID="$(id -u)"
DOMAIN="gui/$ME_UID"
# Retired launchers/logs from earlier fleet designs. The keepalive log is this
# user's (retire removes it); the other two are root-owned (retire prints the
# sudo lines). All three fail assert-single while present.
RETIRED_KEEPALIVE_LOG="$LOG_DIR/deskflow-keepalive.log"
RETIRED_KEEPALIVE_LOG_OLD="$HOME/Library/Logs/deskflow-keepalive.log"
RETIRED_PRIO_APPLY="${DESKFLOW_CTL_RETIRED_PRIO_APPLY:-/usr/local/bin/deskflow-prio-apply.sh}"
RETIRED_SYNERGY_AGENT="${DESKFLOW_CTL_RETIRED_SYNERGY_AGENT:-/Library/LaunchAgents/com.symless.synergy-agent.plist}"
# BTM (Background Task Management) records that may launch Deskflow: the fleet
# LaunchAgents, the prio LaunchDaemon and the login-window bridge. Any other
# enabled app / login-item record whose BUNDLE ID is ours or a KVM sibling's
# is a second launcher. Bundle-id components, never free substrings: "Desk
# Flow Notes" (com.acme.deskflownotes) and "Barrier Breaker" are not launchers.
BTM_ALLOWED_LABELS="$CORE_LABEL $GUI_LABEL $CONVERGE_LABEL $PRIO_LABEL org.deskflow.vhid-bridge"
LOGIN_ITEM_ID_PATTERN='^(io\.github\.hughesyadaddy\.deskflow([.-]|$)|org\.deskflow(\.|$)|com\.symless(\.|$)|([a-z0-9-]+\.)*barrier(\.|$))'
LOGIN_ITEM_BUNDLE_PATTERN='^(deskflow|synergy|barrier)\.app$'

# `kill` is a bash builtin; disable it so the external binary is used and a
# PATH shim can observe the escalation in tests.
enable -n kill 2>/dev/null || true # fleet:allow builtin may already be disabled

usage() { sed -n '2,/^set -euo pipefail/p' "${BASH_SOURCE[0]}" | sed '$d'; }
die() { echo "deskflow-ctl: $*" >&2; exit 1; }
warn() { echo "deskflow-ctl: warning: $*" >&2; }
log() { echo "== deskflow-ctl: $* =="; }

# ---------------------------------------------------------------- inventory
# Every Deskflow-named process on the box, by executable path (never by
# pattern). Output lines: "<pid>\t<uid>\t<path>".
inventory() {
  ps -axo pid=,uid=,comm= 2>/dev/null | awk '
    {
      pid=$1; uid=$2; $1=""; $2=""; sub(/^  */, "");
      path=$0; n=split(path, parts, "/"); base=parts[n];
      if (base == "deskflow-core" || base == "Deskflow" || base == "deskflow" ||
          base == "deskflow-vhid-bridge" || index(path, "Deskflow.app/Contents/MacOS/") > 0)
        printf "%s\t%s\t%s\n", pid, uid, path
    }'
}

canonical_path() { [[ "$1" == "$APP/Contents/MacOS/"* ]]; }

# What `stop` owns and `start` refuses to duplicate: every deskflow-core and
# Deskflow GUI THIS user runs, from ANY path (a dev build, a Deskflow.app.bak,
# a GUI-spawned or orphaned core). Exactly those two basenames: the root
# LoginWindow vhid-bridge and the root deskflow-prio LaunchDaemon run from
# the same bundle and are never matched (waiting on / signalling them made
# `stop` hang forever, or EPERM, at the login window). No root deskflow-core
# exists by design -- the login-window agent is deskflow-vhid-bridge -- so
# one is somebody's `sudo`, named with the exact sudo line, never signalled.
# Output lines: "<pid>\t<uid>\t<path>".
user_program() { case "${1##*/}" in deskflow-core|Deskflow) return 0 ;; esac; return 1; }

owned_lines() {
  local pid uid path
  while IFS=$'\t' read -r pid uid path; do
    if [[ "$uid" == "$ME_UID" ]] && user_program "$path"; then printf '%s\t%s\t%s\n' "$pid" "$uid" "$path"; fi
  done < <(inventory)
  return 0
}

owned_pids() { owned_lines | cut -f1; }

foreign_lines() {
  # The same programs run by ANOTHER uid: not ours to signal.
  local pid uid path
  while IFS=$'\t' read -r pid uid path; do
    if [[ "$uid" != "$ME_UID" ]] && user_program "$path"; then printf '%s\t%s\t%s\n' "$pid" "$uid" "$path"; fi
  done < <(inventory)
  return 0
}

pids_of() {
  # "<pid>\t<uid>\t<path>" lines in $1 -> their pids, space-separated, no newline.
  awk -F'\t' 'NF { out = out (out == "" ? "" : " ") $1 } END { printf "%s", out }' <<<"$1"
}

pids_with_paths() {
  # "<pid>\t<uid>\t<path>" lines in $1 -> "pid (path) pid (path) " for a log line.
  awk -F'\t' 'NF { printf "%s (%s) ", $1, $3 }' <<<"$1"
}

count_role() {
  # $1 = basename, $2 = "canonical" | "any"
  local base="$1" scope="${2:-canonical}" n=0 pid uid path
  while IFS=$'\t' read -r pid uid path; do
    [[ "$(basename "$path")" == "$base" ]] || continue
    if [[ "$scope" == "canonical" ]]; then canonical_path "$path" || continue; fi
    n=$((n + 1))
  done < <(inventory)
  echo "$n"
}

# --------------------------------------------------------------- launchd
agent_loaded() { launchctl print "$DOMAIN/$1" >/dev/null 2>&1; }

agent_pid() {
  # Prints the pid launchd reports for a label, or nothing when not running.
  # `launchctl print` exits non-zero when the label isn't loaded; under
  # `set -euo pipefail` that failure propagates through the pipe and — for
  # callers that assign this via `x="$(agent_pid ...)"` — aborts the whole
  # script instead of yielding an empty string. `|| true` on the producer
  # keeps this a plain "no pid" result in every case.
  launchctl print "$DOMAIN/$1" 2>/dev/null | awk '/^[[:space:]]*pid = / { print $3; exit }' || true # fleet:allow launchctl exits non-zero when the label isn't loaded; empty output is the intended "no pid" result
}

proc_ppid() {
  # Parent pid of $1 via ps (a PATH shim in tests); empty when the pid is gone.
  ps -o ppid= -p "$1" 2>/dev/null | tr -d ' ' || true # fleet:allow exited pid = empty ppid
}

domain_services() {
  # `launchctl print gui/$UID` lists every service in the user domain, including
  # runningboard's application.<bundle-id>.<n> instances (a GUI launched by a
  # Login Item, Finder or `open`). Empty when launchd will not answer.
  launchctl print "$DOMAIN" 2>/dev/null || true # fleet:allow unreadable domain = no runningboard evidence
}

render_agent_to() {
  # $1 = label, $2 = output file. Renders <templates>/<label>.plist with the
  # bundle, home, launchd-safe ctl/dir and soak dir substituted. __CTL__ is
  # ALWAYS the safe copy, never this checkout. Refuses a result that points
  # launchd into a TCC-protected folder (it would die with EPERM, no prompt).
  local src="${TEMPLATE_DIR:+$TEMPLATE_DIR/$1.plist}" hit
  [[ -n "$src" && -f "$src" ]] || die "missing template ${src:-$1.plist}: no launchd-safe copy at $SAFE_TEMPLATE_DIR and no checkout (run scripts/deskflow-ctl start from the checkout)"
  sed -e "s#__APP__#$APP#g" -e "s#__HOME__#$HOME#g" -e "s#__CTL__#$SAFE_CTL#g" \
      -e "s#__CTL_DIR__#$SAFE_DIR#g" -e "s#__SOAK_DIR__#$SOAK_DIR#g" "$src" >"$2"
  if hit="$(grep -m1 -iE "$TCC_STRING_RE" "$2")"; then
    die "rendered $1.plist points launchd into $TCC_FOLDERS (EPERM, no prompt): $(echo "$hit" | sed 's/^[[:space:]]*//')"
  fi
}

agent_plist_stale() {
  # $1 = label. True when $AGENT_DIR/<label>.plist is missing or differs from
  # a fresh render.
  local tmp rc=1
  tmp="$(mktemp "${TMPDIR:-/tmp}/deskflow-ctl.XXXXXX")"
  render_agent_to "$1" "$tmp"
  if [[ ! -f "$AGENT_DIR/$1.plist" ]] || ! cmp -s "$tmp" "$AGENT_DIR/$1.plist"; then rc=0; fi
  rm -f "$tmp"
  return "$rc"
}

render_agent() {
  # $1 = label. Renders into $AGENT_DIR; only rewrites when the content changed.
  local label="$1" dst="$AGENT_DIR/$1.plist" tmp
  mkdir -p "$AGENT_DIR" "$LOG_DIR"
  tmp="$(mktemp "${TMPDIR:-/tmp}/deskflow-ctl.XXXXXX")"
  render_agent_to "$label" "$tmp"
  if [[ -f "$dst" ]] && cmp -s "$tmp" "$dst"; then
    rm -f "$tmp"
  else
    mv "$tmp" "$dst"
    chmod 644 "$dst"
    log "rendered $dst"
  fi
}

# ------------------------------------------------------- prio LaunchDaemon
render_prio_daemon() {
  # Renders tools/launchd/$PRIO_LABEL.plist into $DAEMON_STAGE_DIR. The
  # template carries the default bundle path literally (LaunchDaemons cannot
  # expand anything), so both the __APP__ placeholder and the literal
  # /Applications/Deskflow.app are rewritten to $APP. Prints the staged path.
  local src="$TEMPLATE_DIR/$PRIO_LABEL.plist" dst="$DAEMON_STAGE_DIR/$PRIO_LABEL.plist" tmp
  [[ -f "$src" ]] || die "missing template $src"
  mkdir -p "$DAEMON_STAGE_DIR"
  tmp="$(mktemp "${TMPDIR:-/tmp}/deskflow-ctl.XXXXXX")"
  sed -e "s#__APP__#$APP#g" -e "s#/Applications/Deskflow\.app#$APP#g" "$src" >"$tmp"
  if [[ -f "$dst" ]] && cmp -s "$tmp" "$dst"; then
    rm -f "$tmp"
  else
    mv "$tmp" "$dst"
    chmod 644 "$dst"
    log "rendered $dst" >&2 # stdout is the staged path (command substitution)
  fi
  echo "$dst"
}

daemon_loaded() { launchctl print "system/$1" >/dev/null 2>&1; }

prio_binary_owner_ok() {
  # LaunchDaemons should not run a user-writable binary as root: require root:wheel.
  local bin="$1" owner
  owner="$(stat -f '%Su:%Sg' "$bin" 2>/dev/null || true)" # fleet:allow stat failure = not ok
  [[ "$owner" == "root:wheel" ]]
}

cmd_prio() {
  local bin="$APP/Contents/MacOS/deskflow-prio" staged installed
  if [[ ! -x "$bin" ]]; then
    log "deskflow-prio not in bundle ($bin); skipping LaunchDaemon"
    return 0
  fi
  staged="$(render_prio_daemon)"
  installed="$DAEMON_DIR/$PRIO_LABEL.plist"

  if daemon_loaded "$PRIO_LABEL" && [[ -f "$installed" ]] && cmp -s "$staged" "$installed" &&
     prio_binary_owner_ok "$bin"; then
    log "prio: system/$PRIO_LABEL loaded, $installed up to date, $bin is root:wheel"
    return 0
  fi

  if [[ "$(id -u)" -eq 0 ]]; then
    log "prio: installing $installed and bootstrapping system/$PRIO_LABEL"
    install -d "$DAEMON_DIR"
    install -d -m 1777 "$MACHINE_LOCK_DIR"
    install -m 644 -o root -g wheel "$staged" "$installed"
    chown root:wheel "$bin"
    if daemon_loaded "$PRIO_LABEL"; then
      launchctl bootout "system/$PRIO_LABEL" || die "launchctl bootout system/$PRIO_LABEL failed"
    fi
    launchctl bootstrap system "$installed"
    return 0
  fi

  # No privilege escalation inside the ctl (no sudo prompts from a deploy
  # over SSH, no osascript). Documented human step, exact commands:
  cat <<EOF
== deskflow-ctl: prio: system/$PRIO_LABEL needs root; run once as admin: ==
  sudo install -d $DAEMON_DIR
  sudo install -d -m 1777 $MACHINE_LOCK_DIR
  sudo install -m 644 -o root -g wheel "$staged" "$installed"
  sudo chown root:wheel "$bin"
  sudo launchctl bootout system/$PRIO_LABEL 2>/dev/null; sudo launchctl bootstrap system "$installed"
(rendered from $TEMPLATE_DIR/$PRIO_LABEL.plist; verify with: sudo launchctl print system/$PRIO_LABEL)
EOF
  return 0
}

# ------------------------------------------- loaded definition vs render
plist_program_args() {
  # $1 = plist file. Its ProgramArguments, one per line, XML entities decoded.
  awk '
    /<key>ProgramArguments<\/key>/ { p = 1; next }
    p && /<\/array>/ { exit }
    p && /<string>/ {
      s = $0; sub(/^[[:space:]]*<string>/, "", s); sub(/<\/string>[[:space:]]*$/, "", s)
      gsub(/&lt;/, "<", s); gsub(/&gt;/, ">", s); gsub(/&quot;/, "\"", s); gsub(/&amp;/, "\\&", s)
      print s
    }' "$1"
}

plist_env() {
  # $1 = plist file. Its EnvironmentVariables as "KEY=VALUE" lines.
  awk '
    /<key>EnvironmentVariables<\/key>/ { p = 1; next }
    p && /<\/dict>/ { exit }
    p && /<key>/ { k = $0; sub(/^[[:space:]]*<key>/, "", k); sub(/<\/key>[[:space:]]*$/, "", k); next }
    p && /<string>/ {
      v = $0; sub(/^[[:space:]]*<string>/, "", v); sub(/<\/string>[[:space:]]*$/, "", v)
      gsub(/&lt;/, "<", v); gsub(/&gt;/, ">", v); gsub(/&quot;/, "\"", v); gsub(/&amp;/, "\\&", v)
      print k "=" v
    }' "$1"
}

launchctl_block() {
  # $1 = label, $2 = "arguments" | "environment". The entries of that block
  # in `launchctl print gui/$UID/<label>` (what launchd LOADED), one per
  # line, leading whitespace stripped ("K => V" for the environment); nothing
  # when the label is not loaded or launchd prints no such block.
  launchctl print "$DOMAIN/$1" 2>/dev/null | awk -v b="$2" '
    $0 ~ ("^[[:space:]]*" b " = \\{") { p = 1; next }
    p && /^[[:space:]]*\}/ { exit }
    p { sub(/^[[:space:]]+/, ""); print }' || true # fleet:allow not loaded / no such block = nothing to compare
}

loaded_definition_differs() {
  # $1 = label, $2 = a rendered plist. True when what launchd LOADED for the
  # label (its argv, and every EnvironmentVariables entry of the file) is not
  # what the file says. The installed file alone cannot tell: `converge
  # --apply` re-renders it while the label stays loaded with the OLD
  # definition (macbookpro 2026-09-25: file = safe copy, launchd = checkout
  # path, exit 126 forever), and only a bootout + bootstrap replaces it.
  # Unknown (launchd prints no arguments block) compares equal.
  local largs lenv kv
  largs="$(launchctl_block "$1" arguments)"
  [[ -n "$largs" ]] || return 1
  [[ "$largs" == "$(plist_program_args "$2")" ]] || return 0
  lenv="$(launchctl_block "$1" environment | sed 's/ => /=/')"
  [[ -n "$lenv" ]] || return 1
  while IFS= read -r kv; do
    [[ -n "$kv" ]] || continue
    grep -qxF -- "$kv" <<<"$lenv" || return 0
  done < <(plist_env "$2")
  return 1
}

agent_needs_rebootstrap() {
  # $1 = label. Prints why launchd's loaded definition must be replaced
  # (bootout + bootstrap) and returns 0; returns 1 with no output when the
  # label is not loaded or launchd already runs what a fresh render says. A
  # missing installed file is "not yet rendered", not stale: a loaded label
  # without one is kickstarted, as before.
  local label="$1" plist="$AGENT_DIR/$1.plist" tmp why=""
  agent_loaded "$label" || return 1
  tmp="$(mktemp "${TMPDIR:-/tmp}/deskflow-ctl.XXXXXX")"
  render_agent_to "$label" "$tmp"
  if [[ -f "$plist" ]] && ! cmp -s "$tmp" "$plist"; then
    why="installed plist was stale while loaded"
  elif loaded_definition_differs "$label" "$tmp"; then
    why="launchd's loaded definition (argv/environment) differs from the rendered plist"
  fi
  rm -f "$tmp"
  [[ -n "$why" ]] || return 1
  printf '%s' "$why"
}

bootstrap_agent() {
  local label="$1" plist="$AGENT_DIR/$1.plist" why="" old_pid=""
  # Never start launchd's copy beside a process it does not own (a
  # GUI-spawned core, an orphan, a Login Item GUI): that is a duplicate.
  refuse_if_stray "$label" bootstrap
  # launchd keeps the definition it loaded: a re-rendered file only takes
  # effect at the next bootstrap. Decide from what launchd LOADED against a
  # fresh render, never from the file alone: after `converge --apply`
  # re-rendered the file the two match while launchd still runs the old
  # definition, and a plain kickstart would run it again (macbookpro's
  # converge label: checkout path, exit 126, forever). Only a label whose
  # loaded definition differs is booted out; a current one is never restarted
  # from here.
  why="$(agent_needs_rebootstrap "$label")" || why=""
  render_agent "$label"
  # A label disabled by an earlier `launchctl disable` (or the Login Items
  # pane) makes bootstrap fail silently at login; enable is idempotent.
  launchctl enable "$DOMAIN/$label"
  if [[ -n "$why" ]]; then
    old_pid="$(agent_pid "$label")"
    log "$label: $why; bootout then bootstrap"
    launchctl bootout "$DOMAIN/$label" || die "launchctl bootout $DOMAIN/$label failed"
    # bootout returns before the process is gone: launchd sends SIGTERM and
    # SIGKILLs at its exit timeout (LAUNCHD_EXIT_TIMEOUT, 5 s for these
    # labels). Bootstrapping straight away ran two copies for up to that
    # long and the new one could lose the instance lock and crash-loop, so
    # wait STOP_TIMEOUT (which covers it) for the old pid.
    if [[ -n "$old_pid" ]] && ! wait_pid_gone "$old_pid" "$STOP_TIMEOUT"; then
      die "$label: pid $old_pid still running ${STOP_TIMEOUT}s after bootout; not bootstrapping a second $(label_exe "$label" || true) (launchd SIGKILLs at its ${LAUNCHD_EXIT_TIMEOUT}s exit timeout; deskflow-ctl stop escalates by pid)"
    fi
    launchctl bootstrap "$DOMAIN" "$plist"
  elif agent_loaded "$label"; then
    # Already loaded and current (e.g. previous start with KeepAlive false
    # and a clean exit): kickstart runs it if it is not running.
    launchctl kickstart "$DOMAIN/$label"
  else
    launchctl bootstrap "$DOMAIN" "$plist"
  fi
}

bootout_agent() {
  local label="$1"
  agent_loaded "$label" || return 0
  launchctl bootout "$DOMAIN/$label" || die "launchctl bootout $DOMAIN/$label failed"
}

kickstart_agent() {
  # `restart`: kickstart -k a loaded, current label. A loaded label whose
  # definition must change goes through bootstrap_agent (bootout then
  # bootstrap): -k would only restart the OLD definition.
  local label="$1"
  if agent_loaded "$label" && ! agent_needs_rebootstrap "$label" >/dev/null; then
    refuse_if_stray "$label" "kickstart -k"
    launchctl kickstart -k "$DOMAIN/$label"
  else
    bootstrap_agent "$label"
  fi
}

# ------------------------------------------------------ launchd-safe copy
canon_path() {
  # Canonical form of $1 for the TCC checks: absolute, "." / ".." / "//"
  # folded, symlinks in the longest existing prefix resolved (a path that
  # does not exist yet keeps its tail as given). Pure bash 3.2 + `cd -P`: no
  # python3 (the tick's PATH is /usr/bin:/bin and /usr/bin/python3 may be the
  # Xcode CLT stub).
  local p="$1" out="" seg rest dir tail=""
  [[ "$p" == /* ]] || p="$PWD/$p"
  rest="$p"
  while [[ -n "$rest" ]]; do
    seg="${rest%%/*}"
    if [[ "$rest" == */* ]]; then rest="${rest#*/}"; else rest=""; fi
    case "$seg" in
      ''|.) ;;
      ..) out="${out%/*}" ;;
      *) out="$out/$seg" ;;
    esac
  done
  p="${out:-/}"
  dir="$p"
  while [[ ! -d "$dir" && "$dir" != "/" ]]; do
    tail="/${dir##*/}$tail"
    dir="${dir%/*}"
    dir="${dir:-/}"
  done
  dir="$(cd -P "$dir" 2>/dev/null && pwd -P)" || dir="${p%"$tail"}" # fleet:allow unreadable prefix = keep the folded path
  [[ "$dir" == "/" ]] && dir=""
  out="$dir$tail"
  printf '%s' "${out:-/}"
}

tcc_protected_path() {
  # True for a path under a folder macOS TCC guards per consenting app (a
  # launchd job has none: EPERM there, no prompt, exit 126). Canonical and
  # case-insensitive: APFS is, so ~/desktop/bin and ~/Library/../Desktop/bin
  # are ~/Desktop/bin.
  local p d lp ld
  p="$(canon_path "$1")"
  lp="$(printf '%s' "$p" | tr '[:upper:]' '[:lower:]')"
  while IFS= read -r d; do
    ld="$(canon_path "$d" | tr '[:upper:]' '[:lower:]')"
    [[ "$lp" == "$ld" || "$lp" == "$ld/"* ]] && return 0
  done < <(tcc_roots)
  return 1
}

install_file_if_changed() {
  # $1 = mode, $2 = src, $3 = dst. Returns 0 when dst was (re)written, 1 when
  # it already matched. Atomic replace: a bash still running the old copy
  # keeps its inode.
  local mode="$1" src="$2" dst="$3" tmp
  if [[ -f "$dst" ]] && cmp -s "$src" "$dst"; then
    chmod "$mode" "$dst"
    return 1
  fi
  tmp="$(mktemp "$(dirname "$dst")/.${dst##*/}.XXXXXX")"
  cp "$src" "$tmp"
  chmod "$mode" "$tmp"
  mv -f "$tmp" "$dst"
  return 0
}

cmd_safe_copy() {
  # $1 = "strict" for the safe-copy verb (an invalid DESKFLOW_ROOT is an
  # error naming the variable); `start` passes nothing (a warning, then the
  # checkout recorded by the last safe-copy, else none: the seat must still
  # start). Refresh $SAFE_DIR from the checkout: deskflow-ctl (755), every
  # tools/launchd/*.plist (644; ones that left the checkout are removed) and
  # tools/fleet-soak (755). Diff-and-replace: an up-to-date copy is untouched.
  local strict="${1:-}" src_ctl f n=0 tmp
  if [[ -n "$ROOT_WARNING" ]]; then
    if [[ "$strict" == strict ]]; then
      die "safe-copy: $ROOT_WARNING; point DESKFLOW_ROOT at the checkout, or run scripts/deskflow-ctl safe-copy from it"
    fi
    warn "safe-copy: $ROOT_WARNING"
  fi
  if [[ -z "$ROOT" ]]; then
    log "safe-copy: no checkout known (run scripts/deskflow-ctl from the checkout, or set DESKFLOW_ROOT); $SAFE_DIR left as is"
    return 0
  fi
  src_ctl="$ROOT/scripts/deskflow-ctl"
  [[ -f "$src_ctl" ]] || die "safe-copy: $src_ctl not found (DESKFLOW_ROOT=$ROOT is not a deskflow checkout)"
  if tcc_protected_path "$SAFE_DIR"; then
    die "safe-copy: $SAFE_DIR is under $TCC_FOLDERS; launchd could never execute it (DESKFLOW_CTL_SAFE_DIR)"
  fi
  mkdir -p "$SAFE_TEMPLATE_DIR"
  # Remember the checkout for the copy's own `safe-copy`/`start`.
  tmp="$(mktemp "${TMPDIR:-/tmp}/deskflow-ctl.XXXXXX")"
  printf '%s\n' "$ROOT" >"$tmp"
  install_file_if_changed 644 "$tmp" "$SAFE_CHECKOUT_FILE" || true # fleet:allow unchanged record
  rm -f "$tmp"
  if install_file_if_changed 755 "$src_ctl" "$SAFE_CTL"; then log "safe-copy: installed $SAFE_CTL"; n=$((n + 1)); fi
  for f in "$ROOT"/tools/launchd/*.plist; do
    [[ -f "$f" ]] || continue
    if install_file_if_changed 644 "$f" "$SAFE_TEMPLATE_DIR/${f##*/}"; then log "safe-copy: installed $SAFE_TEMPLATE_DIR/${f##*/}"; n=$((n + 1)); fi
  done
  for f in "$SAFE_TEMPLATE_DIR"/*.plist; do
    [[ -f "$f" && ! -f "$ROOT/tools/launchd/${f##*/}" ]] || continue
    rm -f "$f"
    log "safe-copy: removed $f (no longer in the checkout)"
    n=$((n + 1))
  done
  if [[ -f "$ROOT/tools/fleet-soak" ]]; then
    if install_file_if_changed 755 "$ROOT/tools/fleet-soak" "$SAFE_DIR/fleet-soak"; then log "safe-copy: installed $SAFE_DIR/fleet-soak"; n=$((n + 1)); fi
  fi
  TEMPLATE_DIR="$SAFE_TEMPLATE_DIR"
  (( n )) || log "safe-copy: $SAFE_DIR up to date"
  return 0
}

safe_copy_differs() {
  # From a checkout only: true when the safe copy is missing or behind it.
  local f
  [[ -n "$ROOT" && -f "$ROOT/scripts/deskflow-ctl" ]] || return 1
  { [[ -f "$SAFE_CTL" ]] && cmp -s "$ROOT/scripts/deskflow-ctl" "$SAFE_CTL"; } || return 0
  for f in "$ROOT"/tools/launchd/*.plist; do
    [[ -f "$f" ]] || continue
    { [[ -f "$SAFE_TEMPLATE_DIR/${f##*/}" ]] && cmp -s "$f" "$SAFE_TEMPLATE_DIR/${f##*/}"; } || return 0
  done
  return 1
}

cmd_render_plist() {
  # Print a rendered tools/launchd/<label>.plist to stdout. Installs and
  # loads nothing; each template's header carries its bootstrap recipe.
  local label="${1:-}" tmp
  [[ -n "$label" ]] || die "render-plist: usage: render-plist <label> (a tools/launchd/<label>.plist template)"
  tmp="$(mktemp "${TMPDIR:-/tmp}/deskflow-ctl.XXXXXX")"
  render_agent_to "$label" "$tmp"
  cat "$tmp"
  rm -f "$tmp"
}

# -------------------------------------------------------- duplicate guard
label_exe() {
  # Executable basename launchd runs for a label; empty for the converge tick.
  case "$1" in
    "$CORE_LABEL") echo "deskflow-core" ;;
    "$GUI_LABEL") echo "Deskflow" ;;
    *) echo "" ;;
  esac
}

stray_lines() {
  # $1 = label. "<pid>\t<uid>\t<path>" for every process (any uid, any path)
  # whose basename is this label's executable and which launchd does not
  # report as the label's pid. Empty = nothing runs that a bootstrap/kickstart
  # would duplicate. The process table has the last word, never launchd's pid
  # line: a GUI-spawned core (ppid = GUI), an orphan, a Login Item GUI or a
  # copy still exiting all leave launchd with no pid for the label.
  local label="$1" base launchd_pid pid uid path
  base="$(label_exe "$label")"
  [[ -n "$base" ]] || return 0
  launchd_pid="$(agent_pid "$label")"
  while IFS=$'\t' read -r pid uid path; do
    [[ "${path##*/}" == "$base" ]] || continue
    [[ -n "$launchd_pid" && "$pid" == "$launchd_pid" ]] && continue
    printf '%s\t%s\t%s\n' "$pid" "$uid" "$path"
  done < <(inventory)
  return 0
}

stray_remedy() {
  # $1 = stray lines. What clears them, and only what can: this user's ->
  # `deskflow-ctl stop` (it TERM/KILLs every deskflow-core/Deskflow this user
  # runs, any path); another uid's -> the exact sudo line, since nothing here
  # may signal it and `stop` would only be pretending.
  local pid uid path mine=0 foreign="" out=""
  while IFS=$'\t' read -r pid uid path; do
    [[ -n "$pid" ]] || continue
    if [[ "$uid" == "$ME_UID" ]]; then
      mine=1
    else
      foreign+="${foreign:+; }sudo kill $pid  # $path (uid $uid)"
    fi
  done <<<"$1"
  if (( mine )); then
    out="deskflow-ctl stop (bootout, then TERM/KILL of every deskflow-core/Deskflow this user runs, any path) first, then start"
  fi
  if [[ -n "$foreign" ]]; then
    out+="${out:+; }not this user's to signal (deskflow-ctl stop cannot clear it); run as admin: $foreign; then deskflow-ctl start"
  fi
  printf '%s' "$out"
}

refuse_if_stray() {
  # $1 = label, $2 = the launchctl verb about to run. Dies when a process
  # launchd does not own already runs: starting launchd's copy beside it is
  # exactly the duplicate-core path. The remedy named is one that works.
  local strays
  strays="$(stray_lines "$1")"
  [[ -z "$strays" ]] || die "$2 $1 refused: $(label_exe "$1") pid $(pids_of "$strays") already running outside launchd; $(stray_remedy "$strays")"
}

wait_pid_gone() {
  # Wait up to $2 seconds for pid $1 to leave the inventory.
  local deadline=$(( $(date +%s) + $2 ))
  while inventory | awk -F'\t' -v p="$1" '$1 == p { f = 1 } END { exit !f }'; do
    (( $(date +%s) >= deadline )) && return 1
    sleep 0.5
  done
  return 0
}

# --------------------------------------------------- converge self-check
program_of_args() {
  # $1 = argv, one per line. The script a job runs: argv[1] behind an
  # interpreter (bash/sh/zsh/dash/env), else argv[0]; nothing for no argv.
  awk 'NR == 1 { a0 = $0 } NR == 2 { a1 = $0 }
       END { if (NR == 0 || a0 == "") exit; if (NR > 1 && a0 ~ /(^|\/)(bash|sh|zsh|dash|env)$/) print a1; else print a0 }' <<<"$1"
}

converge_program() {
  # The script the converge agent runs: launchd's LOADED definition when the
  # label is loaded (a re-rendered file only takes effect at the next
  # bootstrap), else the installed plist; nothing when neither exists.
  local prog="" plist="$AGENT_DIR/$CONVERGE_LABEL.plist"
  if agent_loaded "$CONVERGE_LABEL"; then
    prog="$(program_of_args "$(launchctl_block "$CONVERGE_LABEL" arguments)")"
  fi
  if [[ -z "$prog" && -f "$plist" ]]; then
    prog="$(program_of_args "$(plist_program_args "$plist")")"
  fi
  printf '%s' "$prog"
}

converge_log_eperm_path() {
  # Prints the path launchd's shell was refused at when converge.log was
  # written within CONVERGE_EPERM_WINDOW and its LAST line is exactly that
  # refusal (CONVERGE_EPERM_RE: "/bin/bash: <path>: Operation not permitted",
  # TCC EPERM, exit 126). Only the last line counts: any later tick output
  # means the agent ran again (`start` appends a marker for the same reason),
  # and only that shape counts: a tick that died on its own redirection
  # ("<script>: line N: <file>: Permission denied") ran, so its program is
  # fine.
  local last
  [[ -f "$CONVERGE_LOG" ]] || return 1
  (( $(date +%s) - $(file_mtime "$CONVERGE_LOG") <= CONVERGE_EPERM_WINDOW )) || return 1
  last="$(tail -n 1 "$CONVERGE_LOG")"
  grep -qE "$CONVERGE_EPERM_RE" <<<"$last" || return 1
  sed -E "s#$CONVERGE_EPERM_RE#\\3#" <<<"$last"
}

converge_last_exit_126() {
  agent_loaded "$CONVERGE_LABEL" || return 1
  launchctl print "$DOMAIN/$CONVERGE_LABEL" 2>/dev/null | grep -q 'last exit code = 126'
}

converge_program_problem() {
  # One line when the converge agent cannot run its program, else nothing.
  # Evidence first (the log, launchd's exit code), then the static facts.
  local prog eperm
  prog="$(converge_program)"
  [[ -n "$prog" ]] || return 0
  if eperm="$(converge_log_eperm_path)"; then
    echo "converge agent cannot execute its program (TCC): ${eperm:-$prog}"
  elif converge_last_exit_126; then
    echo "converge agent cannot execute its program (TCC): $prog (launchd last exit code 126)"
  elif tcc_protected_path "$prog"; then
    echo "converge agent cannot execute its program (TCC): $prog is under $TCC_FOLDERS (launchd gets EPERM there, no prompt)"
  elif [[ ! -f "$prog" || ! -r "$prog" ]]; then
    echo "converge agent cannot execute its program (missing or unreadable): $prog"
  fi
  return 0
}

installed_plists_tcc_hits() {
  # "<plist>:<line>:<value>" for every <string> in a FLEET plist of
  # $AGENT_DIR (our labels only; a third party's plist is not this tool's
  # business) that points into a TCC-protected folder ($TCC_FOLDERS).
  local f
  for f in "$AGENT_DIR"/io.github.hughesyadaddy.*.plist "$AGENT_DIR"/org.deskflow.*.plist "$AGENT_DIR"/com.fleet.*.plist; do
    [[ -f "$f" ]] || continue
    grep -n -iE "$TCC_STRING_RE" "$f" 2>/dev/null | sed -e 's/[[:space:]]*<string>//' -e 's#</string>.*$##' | awk -v f="$f" '{ print f ":" $0 }' || true # fleet:allow no hit = grep exit 1
  done
}

# ------------------------------------------------------------------- verbs
wait_gone() {
  # Wait up to $1 seconds for none of this user's deskflow-core/Deskflow to run.
  local deadline=$(( $(date +%s) + $1 ))
  while [[ -n "$(owned_pids)" ]]; do
    (( $(date +%s) >= deadline )) && return 1
    sleep 0.5
  done
  return 0
}

stop_foreign_report() {
  # Another uid's deskflow-core/Deskflow (root: somebody's sudo, never a
  # fleet design -- the login-window agent is deskflow-vhid-bridge) is not
  # ours to signal. `start` will refuse beside it, so `stop` names the exact
  # sudo line and exits 1 rather than say "stopped".
  local lines pid uid path
  lines="$(foreign_lines)"
  [[ -n "$lines" ]] || return 0
  {
    echo "== deskflow-ctl: stop: NOT stopped: a deskflow-core/Deskflow of another user is running and deskflow-ctl cannot signal it; run as admin: =="
    while IFS=$'\t' read -r pid uid path; do
      [[ -n "$pid" ]] || continue
      echo "  sudo kill $pid   # ${path##*/} pid $pid uid $uid: $path"
    done <<<"$lines"
    echo "  then: deskflow-ctl start"
  } >&2
  return 1
}

write_quit_intent() {
  mkdir -p "$STATE_DIR"
  date +%s >"$QUIT_INTENT"
}

clear_quit_intent() { rm -f "$QUIT_INTENT"; }

cmd_stop() {
  log "stop (launchctl bootout $DOMAIN/{$CONVERGE_LABEL,$GUI_LABEL,$CORE_LABEL}, then every deskflow-core/Deskflow of this user, any path)"
  # The sentinel goes first: a converge tick racing this stop must not
  # bootstrap the agents straight back.
  write_quit_intent
  bootout_agent "$CONVERGE_LABEL"
  bootout_agent "$GUI_LABEL"
  bootout_agent "$CORE_LABEL"
  local how="stopped"
  if ! wait_gone "$STOP_TIMEOUT"; then
    # Escalate by PID only — never `pkill -f`, which also matches Mouser and
    # anything with "deskflow" in its argv. Every deskflow-core/Deskflow this
    # user runs, from any path: each one makes `start` refuse, so `stop` must
    # clear all of them for the remedy the refusal names to be true.
    local sig lines pid
    for sig in TERM KILL; do
      lines="$(owned_lines)"
      [[ -n "$lines" ]] || break
      log "escalating: SIG$sig to $(pids_with_paths "$lines")"
      for pid in $(pids_of "$lines"); do
        kill "-$sig" "$pid" 2>/dev/null || true # fleet:allow pid may have exited already
      done
      wait_gone "$ESCALATE_TIMEOUT" && break
    done
    if [[ -n "$(owned_pids)" ]]; then
      die "processes still running after SIGKILL: $(pids_with_paths "$(owned_lines)")"
    fi
    how="stopped (escalated)"
  fi
  # "stopped" only when nothing is left that `start` would refuse beside.
  stop_foreign_report || return 1
  log "$how"
}

cmd_start() {
  [[ -d "$APP" ]] || die "bundle missing: $APP"
  [[ -x "$APP/Contents/MacOS/deskflow-core" ]] || die "missing $APP/Contents/MacOS/deskflow-core"
  log "start ($DOMAIN/$CORE_LABEL then $DOMAIN/$GUI_LABEL, then $DOMAIN/$CONVERGE_LABEL)"
  # The converge tick runs the launchd-safe copy, never this checkout.
  cmd_safe_copy
  clear_quit_intent
  bootstrap_agent "$CORE_LABEL"
  local deadline=$(( $(date +%s) + START_TIMEOUT ))
  while [[ -z "$(agent_pid "$CORE_LABEL")" ]]; do
    (( $(date +%s) >= deadline )) && die "deskflow-core did not start under launchd within ${START_TIMEOUT}s (see $LOG_DIR/deskflow-core.log)"
    sleep 0.5
  done
  bootstrap_agent "$GUI_LABEL"
  bootstrap_agent "$CONVERGE_LABEL"
  # Ends any "Operation not permitted" block in the tick's log so the TCC
  # self-check (which reads only the last line) stops reporting it.
  mkdir -p "$LOG_DIR"
  echo "== deskflow-ctl: start: $CONVERGE_LABEL bootstrapped; program $SAFE_CTL ($(date -u +%Y-%m-%dT%H:%M:%SZ)) ==" >>"$CONVERGE_LOG"
  log "started: core pid $(agent_pid "$CORE_LABEL")"
  cmd_prio
}

cmd_restart() {
  log "restart (launchctl kickstart -k)"
  clear_quit_intent
  kickstart_agent "$CORE_LABEL"
  kickstart_agent "$GUI_LABEL"
}

# ---------------------------------------------------------------- converge
boot_epoch() {
  # Seconds since the epoch at the last boot; 0 when unknown (then every
  # sentinel counts as current, the safe direction: no unwanted starts).
  local sec
  sec="$(sysctl -n kern.boottime 2>/dev/null | sed -n 's/^{ sec = \([0-9]*\).*/\1/p' | head -1)"
  echo "${sec:-0}"
}

file_mtime() { stat -f %m "$1" 2>/dev/null || echo 0; } # fleet:allow missing file = epoch 0

quit_intent_active() {
  # A sentinel written before the last boot is stale: a reboot ends a quit.
  [[ -f "$QUIT_INTENT" ]] || return 1
  if (( $(file_mtime "$QUIT_INTENT") < $(boot_epoch) )); then
    rm -f "$QUIT_INTENT"
    return 1
  fi
  return 0
}

deploy_lock_active() {
  [[ -f "$DEPLOY_LOCK" ]] || return 1
  (( $(date +%s) - $(file_mtime "$DEPLOY_LOCK") < DEPLOY_LOCK_MAX_AGE ))
}

budget_used() {
  # Start actions recorded in the last CONVERGE_BUDGET_WINDOW seconds.
  local cutoff=$(( $(date +%s) - CONVERGE_BUDGET_WINDOW ))
  [[ -f "$ACTION_LOG" ]] || { echo 0; return; }
  awk -v cutoff="$cutoff" '$1 >= cutoff { n++ } END { print n + 0 }' "$ACTION_LOG"
}

budget_record() {
  mkdir -p "$STATE_DIR"
  local cutoff=$(( $(date +%s) - CONVERGE_BUDGET_WINDOW )) tmp
  tmp="$(mktemp "${TMPDIR:-/tmp}/deskflow-ctl.XXXXXX")"
  { [[ -f "$ACTION_LOG" ]] && awk -v cutoff="$cutoff" '$1 >= cutoff' "$ACTION_LOG"; date +%s; } >"$tmp"
  mv "$tmp" "$ACTION_LOG"
}

json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

json_list() {
  # Joins the remaining arguments as a JSON array of strings.
  local out="" item
  for item in "$@"; do
    out+="${out:+, }\"$(json_escape "$item")\""
  done
  printf '[%s]' "$out"
}

CONVERGE_PLAN=()
CONVERGE_DONE=()
CONVERGE_ERRORS=()
CONVERGE_GATE=""
CONVERGE_NEEDS_REBOOTSTRAP=0
CONVERGE_CORE_REFUSED=0

converge_agent() {
  # $1 = label, $2 = apply (0/1), $3 = starts allowed (0/1), $4 = kickstart
  # when loaded-but-dead (0/1: a StartInterval job is idle between runs, so
  # "no pid" is its normal state).
  local label="$1" apply="$2" starts_ok="$3" kick_dead="$4"
  local loaded=0
  agent_loaded "$label" && loaded=1
  if agent_plist_stale "$label"; then
    local render="render $label"
    # launchd keeps the definition it loaded; a re-rendered file only takes
    # effect at the next bootstrap, so this is a pending change, not a repair.
    if (( loaded )); then
      render="render $label (takes effect at next deskflow-ctl start/restart)"
      CONVERGE_NEEDS_REBOOTSTRAP=1
    fi
    CONVERGE_PLAN+=("$render")
    if (( apply )); then
      render_agent "$label" >/dev/null
      (( loaded )) || CONVERGE_DONE+=("$render")
    fi
  elif (( loaded )) && [[ -f "$AGENT_DIR/$label.plist" ]] && loaded_definition_differs "$label" "$AGENT_DIR/$label.plist"; then
    # The file is current but launchd still runs an older definition (an
    # earlier tick re-rendered it while loaded): invisible to a file diff,
    # so it is named here and in health.json; the tick never boots a loaded
    # label out (it must not restart the living nor hot-swap its own
    # program), deskflow-ctl start/restart does.
    CONVERGE_PLAN+=("rebootstrap $label (launchd runs an older definition than $AGENT_DIR/$label.plist; takes effect at next deskflow-ctl start/restart)")
    CONVERGE_NEEDS_REBOOTSTRAP=1
  fi
  local want=""
  if (( ! loaded )); then
    want="bootstrap $label"
  elif (( kick_dead )) && [[ -z "$(agent_pid "$label")" ]]; then
    want="kickstart $label"
  fi
  [[ -n "$want" ]] || return 0
  # launchd's view alone decided this until 2026-09-25: a core the GUI
  # spawned (ppid = GUI), an orphan, or a copy still exiting leaves launchd
  # with no pid for the label, and the bootstrap/kickstart below would start
  # a SECOND one (a latent path here: on macbookpro the tick itself never
  # ran, exit 126, and the GUI's own `launchctl kickstart -k` is the other
  # unguarded one). The process table has the last word: never start beside
  # a live one; report it (exit 1 under --apply) and leave it to assert-single.
  local strays
  strays="$(stray_lines "$label")"
  if [[ -n "$strays" ]]; then
    local pids
    pids="$(pids_of "$strays")"
    CONVERGE_PLAN+=("$want REFUSED: $(label_exe "$label") pid $pids already running outside launchd")
    if [[ "$label" == "$CORE_LABEL" ]]; then CONVERGE_CORE_REFUSED=1; fi
    if (( apply && starts_ok )); then
      CONVERGE_ERRORS+=("refused $want: $(label_exe "$label") pid $pids already running outside launchd; a second one is never started here ($(stray_remedy "$strays"))")
    fi
    return 0
  fi
  # No GUI while the core is refused: `start` brings the core up first for
  # the same reason (an old-build GUI spawns its own core beside the stray).
  if [[ "$label" == "$GUI_LABEL" ]] && (( CONVERGE_CORE_REFUSED )); then
    CONVERGE_PLAN+=("$want held while $CORE_LABEL is refused (deskflow-ctl stop, then start)")
    return 0
  fi
  CONVERGE_PLAN+=("$want")
  (( apply && starts_ok )) || return 0
  if (( $(budget_used) >= CONVERGE_BUDGET )); then
    CONVERGE_GATE="action budget exhausted ($CONVERGE_BUDGET/$CONVERGE_BUDGET in the last $((CONVERGE_BUDGET_WINDOW / 60)) min); report-only"
    return 0
  fi
  # Never `kickstart -k`: converge repairs absence, it does not restart the living.
  [[ -f "$AGENT_DIR/$label.plist" ]] || render_agent "$label" >/dev/null
  # Every attempt spends budget, successful or not: a launchctl that keeps
  # failing must not be retried every 60 s forever.
  budget_record
  local err=""
  if ! err="$(launchctl enable "$DOMAIN/$label" 2>&1)"; then
    CONVERGE_ERRORS+=("enable $label: ${err:-rc $?}")
    return 0
  fi
  if [[ "$want" == bootstrap* ]]; then
    err="$(launchctl bootstrap "$DOMAIN" "$AGENT_DIR/$label.plist" 2>&1)" || { CONVERGE_ERRORS+=("$want: ${err:-failed}"); return 0; }
  else
    err="$(launchctl kickstart "$DOMAIN/$label" 2>&1)" || { CONVERGE_ERRORS+=("$want: ${err:-failed}"); return 0; }
  fi
  CONVERGE_DONE+=("$want")
}

write_health_json() {
  # $1 = mode, $2 = gate, $3 = assert result, $4 = budget used
  mkdir -p "$STATE_DIR"
  local tmp label pid agents=""
  tmp="$(mktemp "${TMPDIR:-/tmp}/deskflow-ctl.XXXXXX")"
  for label in "$CORE_LABEL" "$GUI_LABEL" "$CONVERGE_LABEL"; do
    if agent_loaded "$label"; then
      pid="$(agent_pid "$label")"
      agents+="${agents:+, }\"$label\": {\"loaded\": true, \"pid\": ${pid:-null}}"
    else
      agents+="${agents:+, }\"$label\": {\"loaded\": false, \"pid\": null}"
    fi
  done
  cat >"$tmp" <<EOF
{
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "mode": "$1",
  "gate": "$(json_escape "$2")",
  "bundle": "$(json_escape "$APP")",
  "counts": {"core": $(count_role deskflow-core), "gui": $(count_role Deskflow), "bridge": $(count_role deskflow-vhid-bridge any)},
  "agents": {$agents},
  "plan": $(json_list ${CONVERGE_PLAN[@]+"${CONVERGE_PLAN[@]}"}),
  "actions": $(json_list ${CONVERGE_DONE[@]+"${CONVERGE_DONE[@]}"}),
  "errors": $(json_list ${CONVERGE_ERRORS[@]+"${CONVERGE_ERRORS[@]}"}),
  "needs_rebootstrap": $([[ $CONVERGE_NEEDS_REBOOTSTRAP -eq 1 ]] && echo true || echo false),
  "budget": {"used": $4, "max": $CONVERGE_BUDGET, "window_seconds": $CONVERGE_BUDGET_WINDOW},
  "assert_single": "$(json_escape "$3")"
}
EOF
  mv "$tmp" "$HEALTH_JSON"
}

notify() {
  osascript -e "display notification \"$(json_escape "$1")\" with title \"Deskflow\"" >/dev/null 2>&1 || true # fleet:allow no WindowServer (ssh, login window) = no toast
}

cmd_converge() {
  local apply=0 quiet=0 arg
  for arg in "$@"; do
    case "$arg" in
      --apply) apply=1 ;;
      --quiet) quiet=1 ;;
      *) die "converge: unknown option '$arg'" ;;
    esac
  done
  [[ -d "$APP" ]] || die "bundle missing: $APP"

  local starts_ok=1 intended=0 used mode="plan" program_problem=""
  (( apply )) && mode="apply"
  used="$(budget_used)"
  # First converge from a checkout on a seat that never ran `start`: install
  # the safe copy now (nothing runs from there yet), or the converge plist
  # rendered below would name a program that does not exist. A copy that
  # exists but differs is a pending `start` (plan item below): the tick's
  # program is never swapped under it from here.
  if (( ! IS_SAFE_COPY )) && [[ -n "$ROOT" && ! -f "$SAFE_CTL" ]]; then
    if (( apply )); then
      if (( quiet )); then cmd_safe_copy >/dev/null; else cmd_safe_copy; fi
    else
      CONVERGE_PLAN+=("install launchd-safe copy $SAFE_DIR (missing; converge --apply or deskflow-ctl start)")
    fi
  fi
  program_problem="$(converge_program_problem)"
  if deploy_lock_active; then
    CONVERGE_GATE="deploy lock $DEPLOY_LOCK is younger than $((DEPLOY_LOCK_MAX_AGE / 60)) min"
    intended=1
  elif quit_intent_active; then
    CONVERGE_GATE="quit-intent set after last boot ($QUIT_INTENT)"
    intended=1
  elif [[ -n "$program_problem" ]]; then
    # The tick itself cannot run (TCC EPERM on a checkout path, exit 126, a
    # missing file): report-only. The repair is a human `deskflow-ctl start`
    # (re-render onto the safe copy + re-bootstrap); assert-single names it.
    CONVERGE_GATE="$program_problem; report-only until deskflow-ctl start re-renders $CONVERGE_LABEL"
  elif (( used >= CONVERGE_BUDGET )); then
    CONVERGE_GATE="action budget exhausted ($used/$CONVERGE_BUDGET in the last $((CONVERGE_BUDGET_WINDOW / 60)) min); report-only"
  fi
  [[ -z "$CONVERGE_GATE" ]] || starts_ok=0

  if [[ "$CONVERGE_GATE" == "deploy lock"* ]]; then
    write_health_json "$mode" "$CONVERGE_GATE" "skipped" "$used"
    (( quiet )) || log "converge: $CONVERGE_GATE; nothing done"
    return 0
  fi

  converge_agent "$CORE_LABEL" "$apply" "$starts_ok" 1
  converge_agent "$GUI_LABEL" "$apply" "$starts_ok" 1
  converge_agent "$CONVERGE_LABEL" "$apply" "$starts_ok" 0
  local gate="$CONVERGE_GATE"

  # A second launcher (BTM app / login item) cannot be repaired from here: it
  # is a manual System Settings step, surfaced as an error (toast, exit 1)
  # under --apply and as a pending plan item otherwise.
  local audit_out audit_rc=0 audit_line
  audit_out="$(login_items_audit tool)" || audit_rc=$?
  case "$audit_rc" in
    0) ;;
    3) CONVERGE_PLAN+=("login-items audit skipped: $(echo "$audit_out" | sed -n '2p' | sed 's/^ *//')") ;;
    *)
      audit_line="$(echo "$audit_out" | grep -m1 'FAIL:' | sed 's/^ *FAIL: //')"
      if (( apply )); then
        CONVERGE_ERRORS+=("login-items: ${audit_line:-second launcher present}; remove it in System Settings -> General -> Login Items (deskflow-ctl login-items print-steps)")
      else
        CONVERGE_PLAN+=("login-items: ${audit_line:-second launcher present} (manual: deskflow-ctl login-items print-steps)")
      fi
      ;;
  esac

  # A checkout ahead of the safe copy is a pending `start`, never something
  # the tick does on its own (it must not hot-swap its own program).
  if (( ! IS_SAFE_COPY )) && safe_copy_differs; then
    CONVERGE_PLAN+=("launchd-safe copy $SAFE_DIR differs from this checkout (deskflow-ctl start refreshes it)")
  fi

  local assert_out assert_rc=0
  assert_out="$(cmd_assert_single 2>&1)" || assert_rc=$?
  local assert_summary="OK"
  (( assert_rc == 0 )) || assert_summary="FAIL: $(echo "$assert_out" | sed -n '2,$p' | sed 's/^  //' | paste -sd ';' -)"

  write_health_json "$mode" "${gate:-none}" "$assert_summary" "$(budget_used)"

  # A quit-intent or deploy-lock gate makes a failing assert-single expected;
  # a run that was free to act (or is out of budget) and still fails is not.
  # A launchctl failure is always a failure.
  local failing=0
  (( apply && assert_rc != 0 && ! intended )) && failing=1
  (( ${#CONVERGE_ERRORS[@]} )) && failing=1
  local verbose=1
  (( quiet )) && (( ! failing )) && verbose=0

  if (( ${#CONVERGE_ERRORS[@]} )); then
    log "converge: FAILED: $(printf '%s; ' "${CONVERGE_ERRORS[@]}")"
    notify "converge FAILED: $(printf '%s; ' "${CONVERGE_ERRORS[@]}")"
  elif (( ${#CONVERGE_DONE[@]} )); then
    log "converge: acted: $(printf '%s; ' "${CONVERGE_DONE[@]}")"
    notify "converge repaired: $(printf '%s; ' "${CONVERGE_DONE[@]}")"
  elif (( verbose )); then
    if (( ${#CONVERGE_PLAN[@]} )); then
      log "converge: plan (${mode}${gate:+; gated: $gate}): $(printf '%s; ' "${CONVERGE_PLAN[@]}")"
    else
      log "converge: nothing to do${gate:+ (gated: $gate)}"
    fi
  fi
  (( verbose )) && echo "$assert_out"
  return "$failing"
}

# ------------------------------------------------------------ login items
parse_btm_dump() {
  # Pure: `sfltool dumpbtm` text on stdin -> one TSV line per record:
  #   identifier<TAB>type<TAB>disposition<TAB>url
  # e.g. "2.io.github.hughesyadaddy.deskflow\tapp\tenabled, allowed, not notified\tfile:///Applications/Deskflow.app/"
  # Records start at a bare " #N:" line; "Embedded Item Identifiers" sub-lists
  # (" #1: 16.com...") carry text after the colon and are not records.
  awk '
    function flush() {
      if (id != "") printf "%s\t%s\t%s\t%s\n", id, type, disp, url
      id = ""; type = ""; disp = ""; url = ""
    }
    /^[[:space:]]*#[0-9]+:[[:space:]]*$/ { flush(); next }
    /^[[:space:]]*Records for UID/       { flush(); next }
    /^[[:space:]]*Type:/ {
      sub(/^[[:space:]]*Type:[[:space:]]*/, ""); sub(/[[:space:]]*\(0x[0-9a-fA-F]+\)[[:space:]]*$/, "")
      type = $0; next
    }
    /^[[:space:]]*Disposition:/ {
      sub(/^[[:space:]]*Disposition:[[:space:]]*\[/, ""); sub(/\].*$/, "")
      disp = $0; next
    }
    /^[[:space:]]*Identifier:/ { sub(/^[[:space:]]*Identifier:[[:space:]]*/, ""); id = $0; next }
    /^[[:space:]]*URL:/        { sub(/^[[:space:]]*URL:[[:space:]]*/, ""); url = $0; next }
    END { flush() }
  '
}

url_decode() {
  # file:///Applications/Desk%20Flow.app/ -> ... Desk Flow.app/ (the System
  # Events step needs the real name). Pure bash: %XX -> \xXX -> printf %b.
  local s="${1//%/\\x}"
  printf '%b' "$s"
}

btm_record_name() {
  # Display name for a record: the decoded bundle/plist basename from its
  # URL, else the identifier without the "N." type prefix.
  local id="$1" url="$2" base
  base="$(url_decode "${url%/}")"; base="${base##*/}"; base="${base%.app}"; base="${base%.plist}"
  [[ -n "$base" && "$base" != "(null)" ]] && { echo "$base"; return; }
  echo "${id#[0-9]*.}"
}

btm_is_ours() {
  # $1 = identifier (any "N." prefix stripped), $2 = URL. True for our bundle
  # ids / KVM siblings by id component, or a bundle literally named
  # Deskflow.app / Synergy.app / Barrier.app.
  local label="$1" url="$2" bundle
  grep -qiE "$LOGIN_ITEM_ID_PATTERN" <<<"$label" && return 0
  bundle="$(url_decode "${url%/}")"; bundle="${bundle##*/}"
  grep -qiE "$LOGIN_ITEM_BUNDLE_PATTERN" <<<"$bundle"
}

btm_manual_step() {
  # $1 = name, $2 = identifier. The removal is a user action in System Settings.
  cat <<EOF
    manual step: System Settings -> General -> Login Items & Extensions -> "Open at Login" -> remove "$1"
                 (legacy records only: \`osascript -e 'tell application "System Events" to delete login item "$1"'\`, i.e. \`deskflow-ctl login-items audit --fix\`)
                 record: $2
EOF
}

btm_evaluate() {
  # Pure policy over parse_btm_dump TSV on stdin. Prints one finding per
  # offending record (with its manual step) and returns 1 on any finding.
  # The four fleet agents, the prio daemon and the login bridge are allowed;
  # disabled records are not launchers and never count.
  local id type disp url rc=0 name label enabled_urls=""
  while IFS=$'\t' read -r id type disp url; do
    [[ -n "$id" ]] || continue
    label="${id#[0-9]*.}"
    btm_is_ours "$label" "$url" || continue
    [[ "$disp" == enabled* ]] || continue
    name="$(btm_record_name "$id" "$url")"
    case "$type" in
      app|"login item")
        echo "  FAIL: enabled BTM $type record launches \"$name\" beside the LaunchAgent: $id ($url)"
        btm_manual_step "$name" "$id"
        enabled_urls+="$(url_decode "${url%/}")"$'\n'
        rc=1
        ;;
      agent|"legacy agent")
        # Only OUR ids are policed here (an old org.deskflow.* agent plist);
        # a sibling KVM's agent plist is the retired-file check's business.
        case " $BTM_ALLOWED_LABELS " in
          *" $label "*) ;;
          *)
            if grep -qiE '^(io\.github\.hughesyadaddy\.deskflow|org\.deskflow)' <<<"$label"; then
              echo "  FAIL: enabled BTM $type record is not a fleet agent: $id ($url)"
              echo "    manual step: remove the plist behind $url and run: launchctl bootout $DOMAIN/$label"
              rc=1
            fi
            ;;
        esac
        ;;
      *) ;; # daemons (deskflow-prio), developer/curated groups, quicklook: not launchers of the GUI
    esac
  done
  # Two ENABLED app/login-item records for the SAME bundle (macbookpro had
  # 2.io.github.hughesyadaddy.deskflow + orphaned 2.org.deskflow.deskflow for
  # /Applications/Deskflow.app): one row in System Settings may hide the other.
  local dup
  dup="$(printf '%s' "$enabled_urls" | sort | uniq -d | head -1)"
  if [[ -n "$dup" ]]; then
    echo "  FAIL: more than one enabled BTM app/login-item record for ${dup#file://}"
    echo "    manual step: remove every \"$(btm_record_name '' "$dup")\" row under System Settings -> General -> Login Items & Extensions; if one survives: sfltool resetbtm, then reboot"
    rc=1
  fi
  return "$rc"
}

btm_dump() {
  # Runs `sfltool dumpbtm` (a PATH shim in tests). Prints the dump; returns 3
  # when the tool refused for lack of privilege (SKIP, never PASS), 1 on any
  # other failure.
  local out rc=0
  out="$(sfltool dumpbtm 2>&1)" || rc=$?
  if (( rc != 0 )) || ! grep -q 'Records for UID' <<<"$out"; then
    if grep -qiE 'root|privilege|permission|not permitted|must be run|operation not' <<<"$out" || (( rc != 0 )); then
      echo "$out"
      return 3
    fi
    echo "$out"
    return 1
  fi
  echo "$out"
}

login_items_audit() {
  # $1 = source: "tool" (run sfltool) or "stdin". Prints the verdict; exit
  # 0 PASS, 1 FAIL, 3 SKIP (dumpbtm needs root; the hint is the sudo pipe).
  local src="${1:-tool}" dump rc=0 findings
  if [[ "$src" == "stdin" ]]; then
    dump="$(cat)"
    grep -q 'Records for UID' <<<"$dump" || { echo "deskflow-ctl login-items: SKIP: stdin is not a sfltool dumpbtm dump"; return 3; }
  else
    dump="$(btm_dump)" || rc=$?
    if (( rc == 3 )); then
      echo "deskflow-ctl login-items: SKIP: sfltool dumpbtm needs privileges here ($(echo "$dump" | head -1))"
      echo "  run as admin: sudo sfltool dumpbtm | $CTL_SELF login-items audit --stdin"
      return 3
    elif (( rc != 0 )); then
      echo "deskflow-ctl login-items: FAIL: sfltool dumpbtm produced no records ($(echo "$dump" | head -1))"
      return 1
    fi
  fi
  findings="$(parse_btm_dump <<<"$dump" | btm_evaluate)" || rc=$?
  if (( rc == 0 )); then
    echo "deskflow-ctl login-items: OK (no BTM app/login-item launcher for Deskflow; fleet agents only)"
    return 0
  fi
  echo "deskflow-ctl login-items: FAIL"
  echo "$findings"
  return 1
}

login_items_fix() {
  # Legacy LSSharedFileList records answer to System Events; SMAppService /
  # BTM ones do not (the audit re-run tells). Only reached via `--fix`.
  local name
  for name in Deskflow Synergy Barrier; do
    osascript -e "tell application \"System Events\" to delete login item \"$name\"" >/dev/null 2>&1 || true # fleet:allow no such legacy item
  done
}

cmd_login_items() {
  local sub="${1:-}" fix=0 src="tool" arg rc=0
  for arg in "${@:2}"; do
    case "$arg" in
      --fix) fix=1 ;;
      --stdin) src="stdin" ;;
      *) die "login-items: unknown option '$arg'" ;;
    esac
  done
  case "$sub" in
    audit)
      if (( fix )); then
        [[ "$src" == "tool" ]] || die "login-items: --fix cannot be combined with --stdin"
        login_items_audit tool >/dev/null || rc=$?
        if (( rc == 1 )); then
          log "login-items: trying the legacy System Events delete, then re-auditing"
          login_items_fix
        fi
        rc=0
      fi
      login_items_audit "$src" || rc=$?
      return "$rc"
      ;;
    print-steps)
      local findings
      findings="$(login_items_audit tool)" || rc=$?
      case "$rc" in
        0) echo "deskflow-ctl login-items: nothing to remove" ;;
        3) echo "$findings" ;;
        *) echo "$findings" | grep -E 'manual step|^ +\(|record:' ;;
      esac
      return 0
      ;;
    *) die "login-items: usage: login-items audit [--fix] [--stdin] | print-steps" ;;
  esac
}

# ---------------------------------------------------------------- retire
retired_root_files_present() {
  local f n=0
  for f in "$RETIRED_PRIO_APPLY" "$RETIRED_SYNERGY_AGENT"; do
    [[ -e "$f" || -L "$f" ]] && { echo "$f"; n=$((n + 1)); }
  done
  (( n > 0 ))
}

cmd_retire() {
  local f present
  for f in "$RETIRED_KEEPALIVE_LOG" "$RETIRED_KEEPALIVE_LOG_OLD"; do
    if [[ -e "$f" ]]; then
      rm -f "$f"
      log "retire: removed $f"
    fi
  done
  if present="$(retired_root_files_present)"; then
    cat <<EOF
== deskflow-ctl: retire: root-owned retired files remain; run once as admin: ==
$(printf '  sudo rm -f "%s"\n' $present)
(the prio LaunchDaemon is $DAEMON_DIR/$PRIO_LABEL.plist via \`deskflow-ctl prio\`; the synergy agent plist is a stray symlink)
EOF
    return 2
  fi
  log "retire: nothing left to retire"
  return 0
}

cmd_status() {
  local label pid
  echo "bundle: $APP"
  if (( IS_SAFE_COPY )); then
    local checkout="unknown, DESKFLOW_ROOT unset"
    if [[ -n "$ROOT" && -n "${DESKFLOW_ROOT:-}" && -z "$ROOT_WARNING" ]]; then
      checkout="$ROOT (DESKFLOW_ROOT)"
    elif [[ -n "$ROOT" ]]; then
      checkout="$ROOT (recorded by the last safe-copy)"
    elif [[ -n "$ROOT_WARNING" ]]; then
      checkout="unknown ($ROOT_WARNING)"
    fi
    echo "ctl: $CTL_SELF (launchd-safe copy; checkout: $checkout)"
  else
    echo "ctl: $CTL_SELF (checkout); safe copy: $SAFE_CTL$([[ -f "$SAFE_CTL" ]] || echo ' (missing: deskflow-ctl start)')"
  fi
  for label in "$CORE_LABEL" "$GUI_LABEL"; do
    if agent_loaded "$label"; then
      pid="$(agent_pid "$label")"
      echo "agent: $label loaded pid=${pid:-none}"
    else
      echo "agent: $label not loaded"
    fi
  done
  echo "processes (pid uid path canonical):"
  local uid path
  while IFS=$'\t' read -r pid uid path; do
    if canonical_path "$path"; then
      echo "  $pid $uid $path yes"
    else
      echo "  $pid $uid $path NO"
    fi
  done < <(inventory)
}

cmd_assert_single() {
  local problems=() pid uid path
  local cores gui bridge core_pid launchd_pid
  cores="$(count_role deskflow-core)"
  gui="$(count_role Deskflow)"
  bridge="$(count_role deskflow-vhid-bridge any)"
  while IFS=$'\t' read -r pid uid path; do
    canonical_path "$path" || problems+=("non-canonical process pid=$pid $path")
  done < <(inventory)
  [[ "$cores" -eq 1 ]] || problems+=("deskflow-core count=$cores (want 1)")
  [[ "$gui" -eq 1 ]] || problems+=("Deskflow GUI count=$gui (want 1)")
  [[ "$bridge" -le 1 ]] || problems+=("deskflow-vhid-bridge count=$bridge (want <=1)")
  launchd_pid="$(agent_pid "$CORE_LABEL")"
  if [[ -z "$launchd_pid" ]]; then
    problems+=("$CORE_LABEL has no running pid under launchd")
  elif [[ "$cores" -eq 1 ]]; then
    core_pid="$(inventory | awk -F'\t' -v app="$APP/Contents/MacOS/deskflow-core" '$3 == app { print $1 }')"
    [[ "$core_pid" == "$launchd_pid" ]] || problems+=("deskflow-core pid $core_pid is not launchd's ($launchd_pid)")
  fi
  # A core spawned by the GUI (hackintosh: ppid = the GUI) survives a GUI
  # crash as an orphan and races launchd's core at the next login.
  if [[ "$cores" -eq 1 ]]; then
    core_pid="${core_pid:-$(inventory | awk -F'\t' -v app="$APP/Contents/MacOS/deskflow-core" '$3 == app { print $1 }')}"
    local core_ppid
    core_ppid="$(proc_ppid "$core_pid")"
    [[ "$core_ppid" == "1" ]] || problems+=("deskflow-core pid $core_pid ppid=${core_ppid:-?} (want 1: launchd)")
  fi
  # The GUI must be launchd's copy too: a Login Item / runningboard copy holds
  # the instance lock and makes the LaunchAgent copy exit 5 forever.
  local gui_pid gui_launchd_pid
  gui_launchd_pid="$(agent_pid "$GUI_LABEL")"
  if [[ -z "$gui_launchd_pid" ]]; then
    problems+=("$GUI_LABEL has no running pid under launchd")
  elif [[ "$gui" -eq 1 ]]; then
    gui_pid="$(inventory | awk -F'\t' -v app="$APP/Contents/MacOS/Deskflow" '$3 == app { print $1 }')"
    [[ "$gui_pid" == "$gui_launchd_pid" ]] || problems+=("Deskflow GUI pid $gui_pid is not launchd's ($gui_launchd_pid)")
  fi
  local rb
  rb="$(domain_services | grep -oE "application\.$GUI_LABEL(\.[^[:space:]]*)?" | head -1 || true)" # fleet:allow no match = no runningboard instance
  [[ -z "$rb" ]] || problems+=("runningboard instance $rb in $DOMAIN (GUI launched by a Login Item/Finder, not launchd)")
  local audit_out audit_rc=0
  audit_out="$(login_items_audit tool)" || audit_rc=$?
  case "$audit_rc" in
    0) ;;
    3) problems+=("login-items audit SKIPPED (never a pass): $(echo "$audit_out" | sed -n '2p' | sed 's/^ *//')") ;;
    *) problems+=("login-items audit FAIL: $(echo "$audit_out" | grep -m1 'FAIL:' | sed 's/^ *FAIL: //')") ;;
  esac
  local f
  for f in "$RETIRED_KEEPALIVE_LOG" "$RETIRED_KEEPALIVE_LOG_OLD" "$RETIRED_PRIO_APPLY" "$RETIRED_SYNERGY_AGENT"; do
    [[ -e "$f" || -L "$f" ]] && problems+=("retired file present: $f (deskflow-ctl retire)")
  done
  # The self-heal tick must be able to run at all (TCC: a launchd job gets
  # EPERM, no prompt, on anything under ~/Desktop, ~/Documents, ~/Downloads).
  local prog_problem hit
  prog_problem="$(converge_program_problem)"
  [[ -z "$prog_problem" ]] || problems+=("$prog_problem")
  while IFS= read -r hit; do
    [[ -n "$hit" ]] || continue
    problems+=("fleet launchd plist points into a TCC-protected folder (launchd gets EPERM there, no prompt; deskflow-ctl start): $hit")
  done < <(installed_plists_tcc_hits)
  if ((${#problems[@]})); then
    printf 'deskflow-ctl assert-single: FAIL\n' >&2
    printf '  %s\n' "${problems[@]}" >&2
    return 1
  fi
  echo "deskflow-ctl assert-single: OK (core=1 launchd-owned ppid 1, gui=1 launchd-owned, bridge=$bridge, login-items clean)"
}

case "${1:-}" in
  stop) cmd_stop ;;
  start) cmd_start ;;
  restart) cmd_restart ;;
  status) cmd_status ;;
  assert-single) cmd_assert_single ;;
  prio) cmd_prio ;;
  converge) cmd_converge "${@:2}" ;;
  login-items) cmd_login_items "${@:2}" ;;
  retire) cmd_retire ;;
  safe-copy) cmd_safe_copy strict ;;
  render-plist) cmd_render_plist "${@:2}" ;;
  -h|--help|help) usage ;;
  *) usage >&2; die "unknown verb '${1:-}'" ;;
esac
