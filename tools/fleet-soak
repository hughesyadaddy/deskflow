def theil_sen(xs: list[float], ys: list[float]) -> float | None:
    """Median of pairwise slopes. Returns None with fewer than 2 points.

    Large series are bucketed to <= THEIL_SEN_MAX_POINTS evenly spaced
    (median-per-bucket) points before the O(n^2) pass.
    """
    pts = [(x, y) for x, y in zip(xs, ys) if x is not None and y is not None]
    if len(pts) < 2:
        return None
    pts.sort()
    if len(pts) > THEIL_SEN_MAX_POINTS:
        pts = _bucket(pts, THEIL_SEN_MAX_POINTS)
    slopes = []
    n = len(pts)
    for i in range(n):
        xi, yi = pts[i]
        for j in range(i + 1, n):
            xj, yj = pts[j]
            if xj != xi:
                slopes.append((yj - yi) / (xj - xi))
    if not slopes:
        return None
    return statistics.median(slopes)


def _bucket(pts: list[tuple[float, float]], k: int) -> list[tuple[float, float]]:
    x0, x1 = pts[0][0], pts[-1][0]
    if x1 == x0:
        return pts[:k]
    width = (x1 - x0) / k
    buckets: dict[int, list[tuple[float, float]]] = {}
    for x, y in pts:
        idx = min(int((x - x0) / width), k - 1)
        buckets.setdefault(idx, []).append((x, y))
    out = []
    for idx in sorted(buckets):
        b = buckets[idx]
        out.append((statistics.median(p[0] for p in b), statistics.median(p[1] for p in b)))
    return out


def load_jsonl(path: Path) -> tuple[dict | None, list[dict], list[str]]:
    header = None
    samples: list[dict] = []
    problems: list[str] = []
    with path.open("r", encoding="utf-8") as fh:
        for n, line in enumerate(fh, 1):
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
            except json.JSONDecodeError:
                problems.append(f"line {n}: not JSON")
                continue
            if obj.get("header"):
                if n == 1:
                    header = obj
                else:
                    problems.append(f"line {n}: header not on first line")
                continue
            if "ts" not in obj:
                problems.append(f"line {n}: sample without ts")
                continue
            try:
                obj["_t"] = parse_ts(obj["ts"])
            except (ValueError, TypeError):
                problems.append(f"line {n}: bad ts {obj['ts']!r}")
                continue
            samples.append(obj)
    samples.sort(key=lambda s: s["_t"])
    return header, samples, problems


def metric_value(s: dict, metric: str) -> float | None:
    v = s.get(f"{metric}_mb")
    if v is None and metric == "private_bytes":
        v = s.get("private_bytes_mb")
    return float(v) if v is not None else None


def ports_value(s: dict) -> float | None:
    v = s.get("mach_ports")
    if v is None:
        v = s.get("handles")
    return float(v) if v is not None else None


def percentile(vals: list[float], p: float) -> float | None:
    if not vals:
        return None
    vs = sorted(vals)
    k = (len(vs) - 1) * p
    lo, hi = int(k), min(int(k) + 1, len(vs) - 1)
    return vs[lo] + (vs[hi] - vs[lo]) * (k - lo)


def validate(header: dict | None, samples: list[dict], problems: list[str],
             interval: int, min_hours: float, min_completeness: float,
             span_h: float | None, completeness: float | None) -> list[str]:
    """Return a list of validity failures (empty == verdict is valid)."""
    fails = list(problems)
    if header is None:
        fails.append("missing header line")
    else:
        if header.get("scenario_source") != "observed":
            fails.append(f"header.scenario_source={header.get('scenario_source')!r} != 'observed'")
        if header.get("metric") not in ("phys_footprint", "private_bytes"):
            fails.append(f"header.metric={header.get('metric')!r} unknown")
    if not samples:
        fails.append("no samples in window")
        return fails
    max_gap = 0.0
    gap_at = None
    for a, b in zip(samples, samples[1:]):
        g = b["_t"] - a["_t"]
        if g > max_gap:
            max_gap, gap_at = g, a["ts"]
    if max_gap > MAX_GAP_S:
        fails.append(f"gap {max_gap/60:.1f} min > {MAX_GAP_S/60:.0f} min after {gap_at}")
    if completeness is not None and completeness < min_completeness:
        fails.append(f"completeness {completeness:.3f} < {min_completeness}")
    if span_h is not None and span_h < min_hours:
        fails.append(f"span {span_h:.1f} h < min-hours {min_hours}")
    return fails


# macOS only: the Windows probe has a single collector (Get-Process).
REQUIRED_METRIC_SOURCE = {"phys_footprint": "proc_pid_rusage"}


def metric_source_problems(metric: str, body: list[dict]) -> list[str]:
    """Body samples whose metric_source is not the authoritative collector.

    On macOS phys_footprint must come from proc_pid_rusage; a top(1) RSS
    fallback (or a missing source) measures something else and the verdict
    built on it is INVALID rather than merely noisy.
    """
    want = REQUIRED_METRIC_SOURCE.get(metric)
    if want is None:
        return []
    bad: dict[str, int] = {}
    first: dict[str, str] = {}
    for s in body:
        src = s.get("metric_source")
        if src != want:
            key = str(src)
            bad[key] = bad.get(key, 0) + 1
            first.setdefault(key, s.get("ts", "?"))
    return [f"{n} body sample(s) with metric_source={src!r} != {want!r} (first at {first[src]})"
            for src, n in sorted(bad.items())]


def analyze(header: dict | None, samples: list[dict], window_h: float | None,
            accelerated: bool, scenario: str | None) -> dict:
    metric = (header or {}).get("metric") or "phys_footprint"
    interval = int((header or {}).get("interval") or 60)

    if window_h and samples:
        t_end = samples[-1]["_t"]
        samples = [s for s in samples if s["_t"] >= t_end - window_h * 3600]
    if scenario:
        samples = [s for s in samples if s.get("scenario") == scenario]

    res: dict = {
        "metric": metric,
        "interval": interval,
        "samples": len(samples),
        "window_h": window_h,
        "accelerated": accelerated,
        "scenario": scenario,
    }
    if not samples:
        res.update(span_h=None, completeness=None, slope_mb_h=None, ports_slope_h=None,
                   max_step_pct=None, restarts=0, restart_tuple_changes=0,
                   restart_count_increases=0, p95_mb=None, max_mb=None, median_mb=None,
                   analyzed=0, warmup_excluded=0)
        return res

    t0, t1 = samples[0]["_t"], samples[-1]["_t"]
    span = t1 - t0
    res["span_h"] = round(span / 3600, 3)
    res["first_ts"], res["last_ts"] = samples[0]["ts"], samples[-1]["ts"]
    expected = span / interval + 1
    res["completeness"] = round(min(len(samples) / expected, 1.0), 4) if expected > 0 else None

    # restarts over the full window (before warm-up exclusion)
    tuple_changes = 0
    rc_increases = 0
    prev_tuple = None
    prev_rc = None
    for s in samples:
        if s.get("pid") is not None:
            tup = (s.get("exe"), s.get("pid"), s.get("start_time"))
            if prev_tuple is not None and tup != prev_tuple:
                tuple_changes += 1
            prev_tuple = tup
        rc = s.get("restart_count")
        if rc is not None:
            if prev_rc is not None and rc > prev_rc:
                rc_increases += rc - prev_rc
            prev_rc = rc
    res["restart_tuple_changes"] = tuple_changes
    res["restart_count_increases"] = rc_increases
    res["restarts"] = tuple_changes + rc_increases

    warm = WARMUP_ACCELERATED_S if accelerated else WARMUP_S
    body = [s for s in samples if s["_t"] >= t0 + warm]
    res["warmup_excluded"] = len(samples) - len(body)
    res["analyzed"] = len(body)
    res["metric_source_problems"] = metric_source_problems(metric, body)

    xs = [s["_t"] / 3600 for s in body]
    ys = [metric_value(s, metric) for s in body]
    ps = [ports_value(s) for s in body]
    slope = theil_sen(xs, ys)
    pslope = theil_sen(xs, ps)
    res["slope_mb_h"] = round(slope, 4) if slope is not None else None
    res["ports_slope_h"] = round(pslope, 4) if pslope is not None else None

    vals = [y for y in ys if y is not None]
    res["p95_mb"] = round(percentile(vals, 0.95), 3) if vals else None
    res["max_mb"] = round(max(vals), 3) if vals else None
    res["median_mb"] = round(statistics.median(vals), 3) if vals else None

    # max daily step: median per 24 h bucket from the start of the body
    days: dict[int, list[float]] = {}
    for s, y in zip(body, ys):
        if y is None:
            continue
        days.setdefault(int((s["_t"] - t0) // 86400), []).append(y)
    meds = [statistics.median(days[k]) for k in sorted(days)]
    step = None
    for a, b in zip(meds, meds[1:]):
        if a > 0:
            pct = (b - a) / a * 100.0
            step = pct if step is None else max(step, pct)
    res["max_step_pct"] = round(step, 3) if step is not None else None
    res["daily_medians_mb"] = [round(m, 3) for m in meds]
    res.update(cpu_summary(body))
    res.update(counter_rates(body))
    return res


def cpu_summary(body: list[dict], cpu_max: float = CPU_ALERT_PCT, ticks: int = CPU_ALERT_TICKS) -> dict:
    """p95/max cpu_pct and runs of >= ``ticks`` consecutive samples above ``cpu_max``."""
    vals = [float(s["cpu_pct"]) for s in body if s.get("cpu_pct") is not None]
    runs = 0
    longest = 0
    first_at = None
    current = 0
    for s in body:
        v = s.get("cpu_pct")
        if v is not None and float(v) > cpu_max:
            current += 1
            if current == ticks:
                runs += 1
                first_at = first_at or s.get("ts")
            longest = max(longest, current)
        else:
            current = 0
    return {
        "cpu_pct_p95": round(percentile(vals, 0.95), 2) if vals else None,
        "cpu_pct_max": round(max(vals), 2) if vals else None,
        "cpu_high_runs": runs,
        "cpu_high_longest": longest,
        "cpu_high_first_at": first_at,
    }


def counter_rates(body: list[dict]) -> dict:
    """Per-hour rate of each log counter over the body (None when never sampled)."""
    out: dict = {}
    span_h = (body[-1]["_t"] - body[0]["_t"]) / 3600 if len(body) > 1 else 0.0
    for key in COUNTER_KEYS:
        vals = [int(s[key]) for s in body if s.get(key) is not None]
        total = sum(vals) if vals else None
        out[f"{key}_total"] = total
        out[f"{key}_h"] = round(total / span_h, 3) if total is not None and span_h > 0 else None
    return out


def cmd_report(a: argparse.Namespace) -> int:
    path = Path(a.infile)
    if not path.is_file():
        print(f"fleet-soak: INVALID: {path} not found")
        return EXIT_INVALID
    header, all_samples, problems = load_jsonl(path)
    res = analyze(header, all_samples, a.window, a.accelerated, a.scenario)
    res["seat"] = a.seat or (header or {}).get("seat")
    res["proc"] = a.proc or (header or {}).get("proc")
    res["in"] = str(path)

    invalid: list[str] = []
    if a.validate:
        # re-select the windowed/scenario'd samples for gap detection
        win = all_samples
        if a.window and win:
            t_end = win[-1]["_t"]
            win = [s for s in win if s["_t"] >= t_end - a.window * 3600]
        if a.scenario:
            win = [s for s in win if s.get("scenario") == a.scenario]
        invalid = validate(header, win, problems, res["interval"], a.min_hours,
                           a.min_completeness, res.get("span_h"), res.get("completeness"))
    elif header is None:
        invalid = ["missing header line"]
    elif res["samples"] == 0:
        invalid = ["no samples in window"]
    if res.get("slope_mb_h") is None and not invalid:
        invalid = ["too few samples after warm-up exclusion to compute a slope"]
    invalid += res.get("metric_source_problems") or []

    fails: list[str] = []
    if not invalid:
        if a.slope_max is not None and res["slope_mb_h"] > a.slope_max:
            fails.append(f"slope {res['slope_mb_h']} MB/h > {a.slope_max}")
        if a.ports_slope_max is not None:
            if res["ports_slope_h"] is None:
                fails.append("ports slope unavailable")
            elif res["ports_slope_h"] > a.ports_slope_max:
                fails.append(f"ports slope {res['ports_slope_h']}/h > {a.ports_slope_max}")
        if a.cap is not None and res["p95_mb"] is not None and res["p95_mb"] > a.cap:
            fails.append(f"p95 {res['p95_mb']} MB > cap {a.cap}")
        if a.max_step is not None and res["max_step_pct"] is not None and res["max_step_pct"] > a.max_step:
            fails.append(f"max daily step {res['max_step_pct']}% > {a.max_step}%")
        if a.max_restarts is not None and res["restarts"] > a.max_restarts:
            fails.append(f"restarts {res['restarts']} > {a.max_restarts}")
        if a.cpu_max is not None:
            cpu = cpu_summary([s for s in all_samples if s.get("cpu_pct") is not None], a.cpu_max, a.cpu_ticks)
            res.update(cpu)
            if cpu["cpu_high_runs"]:
                fails.append(f"cpu > {a.cpu_max}% for {a.cpu_ticks}+ consecutive samples "
                             f"({cpu['cpu_high_runs']} run(s), longest {cpu['cpu_high_longest']}, "
                             f"first at {cpu['cpu_high_first_at']})")
        for key, limit in (("tap_timeouts", a.tap_timeouts_max), ("epoch_flips", a.flips_max),
                           ("unresponsive", a.unresponsive_max)):
            rate = res.get(f"{key}_h")
            if limit is not None and rate is not None and rate > limit:
                fails.append(f"{key} {rate}/h > {limit}/h")

    if invalid:
        verdict, code = "INVALID", EXIT_INVALID
    elif fails:
        verdict, code = "FAIL", EXIT_FAIL
    else:
        verdict, code = "PASS", EXIT_PASS
    res["verdict"] = verdict
    res["failures"] = fails
    res["invalid"] = invalid

    if a.json:
        print(json.dumps(res, indent=2, sort_keys=True))
    else:
        print(
            f"fleet-soak {verdict}: seat={res['seat']} proc={res['proc']} metric={res['metric']} "
            f"samples={res['samples']} span={res.get('span_h')}h completeness={res.get('completeness')} "
            f"slope={res.get('slope_mb_h')}MB/h ports_slope={res.get('ports_slope_h')}/h "
            f"p95={res.get('p95_mb')}MB max={res.get('max_mb')}MB step={res.get('max_step_pct')}% "
            f"restarts={res.get('restarts')} cpu_p95={res.get('cpu_pct_p95')}% "
            f"tap_timeouts={res.get('tap_timeouts_h')}/h flips={res.get('epoch_flips_h')}/h "
            f"unresponsive={res.get('unresponsive_h')}/h"
        )
        for f in fails:
            print(f"  FAIL: {f}")
        for i in invalid:
            print(f"  INVALID: {i}")
    return code


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="fleet-soak", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("sample", help="append one or more samples to a JSONL file")
    s.add_argument("--label", action="append", required=True,
                   help="launchd label / Windows service name (repeatable, pairs with --exe)")
    s.add_argument("--exe", action="append", required=True, help="absolute executable path")
    s.add_argument("--proc", action="append", help="override the label-derived proc name")
    s.add_argument("--scenario-log", action="append", metavar="FILE",
                   help="log file to derive the scenario from ('-' = default lookup; pairs with --label)")
    s.add_argument("--out", help="JSONL path (single target only)")
    s.add_argument("--once", action="store_true")
    s.add_argument("--interval", type=int, default=60)
    s.add_argument("--start-soak", metavar="DIR",
                   help="start a new soak: create DIR/<date>/ and point DIR/latest at it")
    s.add_argument("--soak", metavar="DIR",
                   help="append into DIR/latest (started with --start-soak if missing)")
    s.add_argument("--probe-json", metavar="FILE", help="Windows: read Get-Process JSON from FILE or '-'")
    s.add_argument("--verbose", action="store_true")
    s.set_defaults(func=cmd_sample)

    r = sub.add_parser("report", help="compute a verdict from a JSONL file")
    r.add_argument("--seat")
    r.add_argument("--proc")
    r.add_argument("--in", dest="infile", required=True)
    r.add_argument("--window", type=float, help="hours (default: whole file)")
    r.add_argument("--accelerated", action="store_true", help="exclude first 10 min instead of 2 h")
    r.add_argument("--scenario")
    r.add_argument("--slope-max", type=float, metavar="MB/h")
    r.add_argument("--cap", type=float, metavar="MB", help="p95 footprint cap")
    r.add_argument("--ports-slope-max", type=float, metavar="n/h")
    r.add_argument("--max-step", type=float, metavar="PCT")
    r.add_argument("--max-restarts", type=int)
    r.add_argument("--min-hours", type=float, default=72)
    r.add_argument("--min-completeness", type=float, default=0.95)
    r.add_argument("--validate", action="store_true",
                   help="fail (exit 2) on gaps > 5 min, low completeness, short span, bad header")
    r.add_argument("--cpu-max", type=float, default=CPU_ALERT_PCT, metavar="PCT",
                   help="fail when cpu_pct exceeds PCT for --cpu-ticks consecutive samples (default 80)")
    r.add_argument("--cpu-ticks", type=int, default=CPU_ALERT_TICKS, metavar="N")
    r.add_argument("--tap-timeouts-max", type=float, default=10.0, metavar="N/h",
                   help="Mouser CGEventTap timeouts per hour (default 10; a healthy seat is 0)")
    r.add_argument("--flips-max", type=float, default=6.0, metavar="N/h",
                   help="core role flips ('promoting to server') per hour (default 6)")
    r.add_argument("--unresponsive-max", type=float, default=20.0, metavar="N/h",
                   help="core ClientProxyUnknown lines per hour (default 20)")
    r.add_argument("--json", action="store_true")
    r.set_defaults(func=cmd_report)
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return int(args.func(args))


if __name__ == "__main__":
    sys.exit(main())
