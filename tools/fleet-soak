def metric_name() -> str:
    return "private_bytes" if IS_WIN else "phys_footprint"


RESTART_SOURCE_LAUNCHD = "launchctl-runs+tuple-change"
RESTART_SOURCE_TUPLE_ONLY = (
    "tuple-change only: restart_count is null (no launchd job matched the label "
    "or the exe's program); restarts are detected solely from (exe, pid, "
    "start_time) tuple changes between consecutive samples, so a sampling gap "
    "that spans a restart can hide it"
)


def restart_source(label: str, exe: str) -> str:
    """Header note on where restart evidence comes from for this target."""
    if IS_WIN:
        return "service-control-manager-7036+tuple-change"
    if mac_restart_count(label, exe) is None:
        return RESTART_SOURCE_TUPLE_ONLY
    return RESTART_SOURCE_LAUNCHD


def make_header(proc: str, interval: int, seat: str | None = None,
                restart_src: str | None = None) -> dict:
    hdr = {
        "header": True,
        "metric": metric_name(),
        "scenario_source": "observed",
        "sampler_sha": git_sha(),
        "seat": seat or seat_name(),
        "proc": proc,
        "interval": int(interval),
    }
    if restart_src is not None:
        hdr["restart_source"] = restart_src
    return hdr


def ensure_header(path: Path, header: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists() and path.stat().st_size > 0:
        with path.open("r", encoding="utf-8") as fh:
            first = fh.readline()
        try:
            if json.loads(first).get("header"):
                return
        except json.JSONDecodeError:
            pass
        raise SystemExit(f"fleet-soak: {path} exists without a header line; refusing to append")
    with path.open("w", encoding="utf-8") as fh:
        fh.write(json.dumps(header, separators=(",", ":")) + "\n")


def start_soak(base: Path, date: str | None = None) -> Path:
    """Create base/<date>/ and point base/latest at it."""
    date = date or _dt.date.today().isoformat()
    day = base / date
    day.mkdir(parents=True, exist_ok=True)
    (day / "logs").mkdir(exist_ok=True)
    latest = base / "latest"
    if latest.is_symlink() or latest.exists():
        if latest.is_dir() and not latest.is_symlink():
            raise SystemExit(f"fleet-soak: {latest} is a real directory; refusing to replace")
        latest.unlink()
    latest.symlink_to(date, target_is_directory=True)
    return day


def count_log_deltas(path: Path | None, patterns: dict[str, str],
                     prev_offset: int | None) -> tuple[dict[str, int], int | None]:
    """Occurrences of each pattern in ``path`` after ``prev_offset``; returns
    (counts, new_offset). With no previous offset (first sample of a soak)
    nothing is counted and the cursor starts at EOF, so history before the
    soak never lands in its rates. A shrunken file (rotation) restarts from
    0; a delta larger than LOG_DELTA_MAX_BYTES is counted from the end only."""
    counts = {k: 0 for k in patterns}
    if path is None:
        return counts, None
    try:
        size = path.stat().st_size
    except OSError:
        return counts, None
    if prev_offset is None:
        return counts, size
    start = prev_offset if 0 <= prev_offset <= size else 0
    start = max(start, size - LOG_DELTA_MAX_BYTES)
    if size > start:
        try:
            with path.open("rb") as fh:
                fh.seek(start)
                text = fh.read(size - start).decode("utf-8", "replace")
        except OSError:
            return counts, None
        for key, needle in patterns.items():
            counts[key] = text.count(needle)
    return counts, size


def read_last_samples(path: Path, n: int) -> list[dict]:
    """Last ``n`` sample objects already in the JSONL (oldest first)."""
    if not path.is_file():
        return []
    lines = [ln for ln in _tail_text(path, 64 * 1024).splitlines() if ln.strip()]
    out: list[dict] = []
    for ln in reversed(lines):
        try:
            obj = json.loads(ln)
        except json.JSONDecodeError:
            continue
        if obj.get("header") or "ts" not in obj:
            continue
        out.append(obj)
        if len(out) == n:
            break
    out.reverse()
    return out


def derive_fields(rec: dict, prev: dict | None, proc: str, log_path: Path | None) -> dict:
    """cpu_pct from the previous sample of the same process incarnation,
    log-tail counter deltas since the previous sample, and a carried-forward
    restart_count when the probe reports per-tick restart_events."""
    rec = dict(rec)
    rec["cpu_pct"] = None
    if prev and rec.get("cpu_s") is not None and prev.get("cpu_s") is not None \
            and rec.get("pid") == prev.get("pid") and rec.get("start_time") == prev.get("start_time"):
        try:
            dt = parse_ts(rec["ts"]) - parse_ts(prev["ts"])
        except (ValueError, TypeError, KeyError):
            dt = 0
        if dt > 0:
            rec["cpu_pct"] = round(max(0.0, (rec["cpu_s"] - prev["cpu_s"]) / dt * 100.0), 2)
    patterns = LOG_COUNTERS.get(proc, {})
    if patterns:
        prev_offset = prev.get("log_offset") if prev else None
        counts, offset = count_log_deltas(log_path, patterns, prev_offset)
        rec.update(counts)
        rec["log_offset"] = offset
    if "restart_events" in rec:
        base = prev.get("restart_count") if prev and prev.get("restart_count") is not None else 0
        events = rec["restart_events"]
        # a failed event query keeps the count where it was rather than resetting it
        rec["restart_count"] = base + (int(events) if events is not None else 0)
    rec.pop("restart_events", None)
    return rec


def alerts_for(prev: list[dict], rec: dict, proc: str) -> list[str]:
    """Alert messages that fire exactly at the tick a condition is met."""
    window = prev + [rec]
    alerts: list[str] = []
    absent = [s.get("pid") is None for s in window]
    if len(absent) >= ABSENT_ALERT_TICKS and all(absent[-ABSENT_ALERT_TICKS:]) \
            and not (len(absent) > ABSENT_ALERT_TICKS and absent[-ABSENT_ALERT_TICKS - 1]):
        alerts.append(f"{proc}: no process for {ABSENT_ALERT_TICKS} consecutive samples")
    hot = [(s.get("cpu_pct") or 0) > CPU_ALERT_PCT for s in window]
    if len(hot) >= CPU_ALERT_TICKS and all(hot[-CPU_ALERT_TICKS:]) \
            and not (len(hot) > CPU_ALERT_TICKS and hot[-CPU_ALERT_TICKS - 1]):
        alerts.append(f"{proc}: cpu {rec.get('cpu_pct')}% for {CPU_ALERT_TICKS} consecutive samples")
    return alerts


def notify(message: str) -> None:
    title = "fleet-soak"
    if IS_MAC:
        script = "display notification {} with title {}".format(json.dumps(message[:200]), json.dumps(title))
        run(["osascript", "-e", script], timeout=10)
    elif IS_WIN:
        run(["msg", "*", "/TIME:30", f"{title}: {message}"], timeout=10)
    else:
        print(f"{title}: {message}", file=sys.stderr)


def collect_one(label: str, exe: str, proc: str, probe: dict | None = None,
                scenario_log: str | None = None, interval: int = 60) -> dict:
    if probe is not None:
        rec = win_record_from_probe(probe, exe, proc)
    elif IS_WIN:
        rec = win_record_from_probe(win_probe(label, exe, interval), exe, proc)
    else:
        rec = mac_collect(label, exe, proc, scenario_log)
    return {"ts": iso(now_utc()), **rec, "heartbeat": True}


def cmd_sample(a: argparse.Namespace) -> int:
    if len(a.label) != len(a.exe):
        print("fleet-soak: --label and --exe must be given the same number of times", file=sys.stderr)
        return 2
    procs = list(a.proc or [])
    while len(procs) < len(a.label):
        procs.append(proc_from_label(a.label[len(procs)]))
    logs = list(a.scenario_log or [])
    logs += [None] * (len(a.label) - len(logs))

    soak_dir = None
    if a.start_soak:
        soak_dir = start_soak(Path(a.start_soak))
    elif a.soak:
        latest = Path(a.soak) / "latest"
        soak_dir = latest.resolve() if latest.is_dir() else start_soak(Path(a.soak))
    seat = seat_name()

    outs: list[Path] = []
    if a.out:
        if len(a.label) != 1:
            print("fleet-soak: --out only valid with a single --label/--exe; use --start-soak", file=sys.stderr)
            return 2
        outs = [Path(a.out)]
    elif soak_dir is not None:
        outs = [soak_dir / f"{seat}-{p}.jsonl" for p in procs]
    else:
        print("fleet-soak: --out or --start-soak required", file=sys.stderr)
        return 2

    probe = None
    if a.probe_json:
        raw = sys.stdin.read() if a.probe_json == "-" else Path(a.probe_json).read_text()
        probe = json.loads(raw or "{}")

    for out, p, label, exe in zip(outs, procs, a.label, a.exe):
        ensure_header(out, make_header(p, a.interval, seat, restart_source(label, exe)))

    while True:
        for label, exe, proc, out, slog in zip(a.label, a.exe, procs, outs, logs):
            prev = read_last_samples(out, max(CPU_ALERT_TICKS, ABSENT_ALERT_TICKS))
            log_path = Path(slog) if slog and slog != "-" else default_log_for(proc)
            rec = derive_fields(collect_one(label, exe, proc, probe, slog, a.interval),
                                prev[-1] if prev else None, proc, log_path)
            with out.open("a", encoding="utf-8") as fh:
                fh.write(json.dumps(rec, separators=(",", ":")) + "\n")
            if a.verbose:
                print(json.dumps(rec))
            for alert in alerts_for(prev, rec, proc):
                print(f"fleet-soak: ALERT {alert}", file=sys.stderr)
                notify(alert)
        if a.once:
            return 0
        time.sleep(max(1, a.interval))


