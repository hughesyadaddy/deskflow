# --------------------------------------------------------------------------
# generic helpers
# --------------------------------------------------------------------------


def now_utc() -> _dt.datetime:
    return _dt.datetime.now(_dt.timezone.utc)


def iso(ts: _dt.datetime) -> str:
    return ts.astimezone(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_ts(s: str) -> float:
    """Parse an ISO-8601 timestamp (Z or offset) into epoch seconds."""
    s = s.strip()
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    d = _dt.datetime.fromisoformat(s)
    if d.tzinfo is None:
        d = d.replace(tzinfo=_dt.timezone.utc)
    return d.timestamp()


def run(cmd: list[str], timeout: int = 20) -> str:
    try:
        return subprocess.run(
            cmd, capture_output=True, text=True, timeout=timeout, check=False
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def git_sha() -> str:
    here = Path(__file__).resolve().parent
    out = run(["git", "-C", str(here), "rev-parse", "HEAD"]).strip()
    return out or "unknown"


def seat_name() -> str:
    out = run(["hostname", "-s"]).strip() if not IS_WIN else ""
    if not out:
        out = socket.gethostname().split(".")[0]
    return out.lower()


def proc_from_label(label: str) -> str:
    """Derive a short process name from a launchd label / service name.

    'io.github.hughesyadaddy.mouser'                       -> 'mouser'
    'application.io.github.hughesyadaddy.deskflow.4066.40' -> 'deskflow'
    'deskflow-core'                                        -> 'deskflow-core'
    'DeskflowDaemon'                                       -> 'deskflowdaemon'
    """
    parts = [p for p in label.split(".") if p and not p.isdigit()]
    if parts and parts[0] == "application":
        parts = parts[1:]
    return (parts[-1] if parts else label).lower()


def to_mb(text: str) -> float | None:
    """Convert top(1) style sizes ('28M', '8928K-', '1.2G', '512B') to MB."""
    m = re.match(r"^\s*([0-9]*\.?[0-9]+)\s*([KMGB]?)", text.strip().upper())
    if not m:
        return None
    val = float(m.group(1))
    unit = m.group(2)
    scale = {"B": 1 / MB, "K": 1 / 1024, "M": 1.0, "G": 1024.0, "": 1.0}[unit]
    return round(val * scale, 3)


# --------------------------------------------------------------------------
# macOS collectors
# --------------------------------------------------------------------------

_PS_RE = re.compile(
    r"^\s*(\d+)\s+(\w{3}\s+\w{3}\s+\d{1,2}\s+\d{2}:\d{2}:\d{2}\s+\d{4})\s+(.*)$"
)


def parse_ps(text: str, exe: str) -> list[tuple[int, str, str]]:
    """Parse `ps -axo pid=,lstart=,args=` output; return (pid, start, args).

    The exe match is case-insensitive: APFS is case-insensitive by default,
    so `.../MacOS/deskflow` and `.../MacOS/Deskflow` are the same binary.
    """
    out = []
    exe_l = exe.lower()
    for line in text.splitlines():
        m = _PS_RE.match(line)
        if not m:
            continue
        pid, lstart, args = int(m.group(1)), m.group(2), m.group(3)
        args_l = args.lower()
        if args_l == exe_l or args_l.startswith(exe_l + " "):
            try:
                st = _dt.datetime.strptime(lstart, "%a %b %d %H:%M:%S %Y")
                start = st.astimezone().strftime("%Y-%m-%dT%H:%M:%S%z")
            except ValueError:
                start = lstart
            out.append((pid, start, args))
    return out


def mac_find_pid(exe: str) -> tuple[int | None, str | None]:
    text = run(["ps", "-axo", "pid=,lstart=,args="])
    matches = parse_ps(text, exe)
    if not matches:
        return None, None
    matches.sort(key=lambda t: t[0])
    return matches[0][0], matches[0][1]


def _mac_rusage(pid: int):
    """proc_pid_rusage(pid, RUSAGE_INFO_V4) buffer, or None.

    Layout from <sys/resource.h>: uint8_t ri_uuid[16] followed by 35 x
    uint64_t; ri_phys_footprint is the 8th uint64 (index 7), ri_user_time /
    ri_system_time the first two (mach absolute time units).
    """
    try:
        import ctypes

        class RusageInfoV4(ctypes.Structure):
            _fields_ = [
                ("ri_uuid", ctypes.c_uint8 * 16),
                ("ri_user_time", ctypes.c_uint64),
                ("ri_system_time", ctypes.c_uint64),
                ("ri_pkg_idle_wkups", ctypes.c_uint64),
                ("ri_interrupt_wkups", ctypes.c_uint64),
                ("ri_pageins", ctypes.c_uint64),
                ("ri_wired_size", ctypes.c_uint64),
                ("ri_resident_size", ctypes.c_uint64),
                ("ri_phys_footprint", ctypes.c_uint64),
                ("ri_proc_start_abstime", ctypes.c_uint64),
                ("ri_proc_exit_abstime", ctypes.c_uint64),
                ("ri_child_user_time", ctypes.c_uint64),
                ("ri_child_system_time", ctypes.c_uint64),
                ("ri_child_pkg_idle_wkups", ctypes.c_uint64),
                ("ri_child_interrupt_wkups", ctypes.c_uint64),
                ("ri_child_pageins", ctypes.c_uint64),
                ("ri_child_elapsed_abstime", ctypes.c_uint64),
                ("ri_diskio_bytesread", ctypes.c_uint64),
                ("ri_diskio_byteswritten", ctypes.c_uint64),
                ("ri_cpu_time_qos_default", ctypes.c_uint64),
                ("ri_cpu_time_qos_maintenance", ctypes.c_uint64),
                ("ri_cpu_time_qos_background", ctypes.c_uint64),
                ("ri_cpu_time_qos_utility", ctypes.c_uint64),
                ("ri_cpu_time_qos_legacy", ctypes.c_uint64),
                ("ri_cpu_time_qos_user_initiated", ctypes.c_uint64),
                ("ri_cpu_time_qos_user_interactive", ctypes.c_uint64),
                ("ri_billed_system_time", ctypes.c_uint64),
                ("ri_serviced_system_time", ctypes.c_uint64),
                ("ri_logical_writes", ctypes.c_uint64),
                ("ri_lifetime_max_phys_footprint", ctypes.c_uint64),
                ("ri_instructions", ctypes.c_uint64),
                ("ri_cycles", ctypes.c_uint64),
                ("ri_billed_energy", ctypes.c_uint64),
                ("ri_serviced_energy", ctypes.c_uint64),
                ("ri_interval_max_phys_footprint", ctypes.c_uint64),
                ("ri_runnable_time", ctypes.c_uint64),
            ]

        assert ctypes.sizeof(RusageInfoV4) == 16 + 35 * 8
        libproc = ctypes.CDLL("/usr/lib/libproc.dylib", use_errno=True)
        fn = libproc.proc_pid_rusage
        fn.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_void_p]
        fn.restype = ctypes.c_int
        buf = RusageInfoV4()
        rc = fn(int(pid), 4, ctypes.byref(buf))  # RUSAGE_INFO_V4 == 4
        if rc != 0:
            return None
        return buf
    except Exception:  # noqa: BLE001 - any failure -> caller falls back
        return None


def mac_phys_footprint(pid: int) -> int | None:
    buf = _mac_rusage(pid)
    return int(buf.ri_phys_footprint) if buf is not None else None


def _mach_timebase() -> float:
    """Seconds per mach absolute time unit (1e-9 on Apple Silicon, scaled on Intel)."""
    try:
        import ctypes

        class Timebase(ctypes.Structure):
            _fields_ = [("numer", ctypes.c_uint32), ("denom", ctypes.c_uint32)]

        tb = Timebase()
        libc = ctypes.CDLL("/usr/lib/libSystem.dylib")
        libc.mach_timebase_info(ctypes.byref(tb))
        if tb.denom:
            return tb.numer / tb.denom / 1e9
    except Exception:  # noqa: BLE001
        pass
    return 1e-9


def mac_cpu_seconds(pid: int) -> float | None:
    """user+system CPU seconds consumed by pid (same rusage call as the footprint)."""
    buf = _mac_rusage(pid)
    if buf is None:
        return None
    return round((int(buf.ri_user_time) + int(buf.ri_system_time)) * _mach_timebase(), 3)


def parse_top(text: str) -> dict:
    """Parse the last line of `top -stats pid,mem,cmprs,ports,th`."""
    lines = [ln for ln in text.splitlines() if ln.strip()]
    if not lines:
        return {}
    cols = lines[-1].split()
    if len(cols) < 5 or not cols[0].isdigit():
        return {}
    ports = re.sub(r"\D", "", cols[3])
    th = re.sub(r"\D", "", cols[4].split("/")[0])
    return {
        "rss_mb": to_mb(cols[1]),
        "compressed_mb": to_mb(cols[2]),
        "mach_ports": int(ports) if ports else None,
        "threads": int(th) if th else None,
    }


def mac_top(pid: int) -> dict:
    text = run(
        ["top", "-l", "2", "-s", "1", "-stats", "pid,mem,cmprs,ports,th", "-pid", str(pid)],
        timeout=15,
    )
    return parse_top(text)


def mac_fds(pid: int) -> int | None:
    text = run(["lsof", "-p", str(pid)], timeout=30)
    lines = text.splitlines()
    return max(len(lines) - 1, 0) if lines else None


_LAUNCHCTL_RUNS_RE = re.compile(r"^\s*runs\s*=\s*(\d+)", re.M)
_LAUNCHCTL_PROGRAM_RE = re.compile(r"^\s*program\s*=\s*(\S.*?)\s*$", re.M)


def _launchctl_runs(text: str) -> int | None:
    m = _LAUNCHCTL_RUNS_RE.search(text)
    return int(m.group(1)) if m else None


def launchctl_labels(text: str) -> list[str]:
    """Labels from the `services = { ... }` block of `launchctl print gui/UID`.

    Each row is `<pid|->\t<status>\t<label>`; dynamic app labels look like
    `application.io.github.hughesyadaddy.deskflow.406638075.406638081`.
    """
    labels: list[str] = []
    in_services = False
    for line in text.splitlines():
        s = line.strip()
        if not in_services:
            if re.match(r"^services\s*=\s*\{", s):
                in_services = True
            continue
        if s.startswith("}"):
            break
        parts = s.split()
        if len(parts) >= 3:
            labels.append(parts[-1])
    return labels


def mac_restart_count(label: str, exe: str | None = None) -> int | None:
    """`runs =` of the launchd job for `label`.

    GUI apps launched by LaunchServices get a dynamic label
    (`application.<bundle-id>.<n>.<m>`), so the static label misses. In that
    case fall back to every gui/UID service whose label contains the label's
    last component and whose `program =` is `exe` (case-insensitive). Returns
    None when nothing matches; the header's `restart_source` then records that
    restarts are detected only from (exe, pid, start_time) tuple changes.
    """
    uid = os.getuid()
    runs = _launchctl_runs(run(["launchctl", "print", f"gui/{uid}/{label}"]))
    if runs is not None or not exe:
        return runs
    needle = proc_from_label(label)
    exe_l = exe.lower()
    for cand in launchctl_labels(run(["launchctl", "print", f"gui/{uid}"])):
        if cand == label or needle not in cand.lower():
            continue
        text = run(["launchctl", "print", f"gui/{uid}/{cand}"])
        m = _LAUNCHCTL_PROGRAM_RE.search(text)
        if m and m.group(1).lower() == exe_l:
            runs = _launchctl_runs(text)
            if runs is not None:
                return runs
    return None


def _newest_log(paths: list[Path]) -> Path | None:
    existing = [p for p in paths if p.is_file()]
    if not existing:
        return None
    return max(existing, key=lambda p: p.stat().st_mtime)


def _tail_text(path: Path, nbytes: int = 256 * 1024) -> str:
    try:
        with path.open("rb") as fh:
            fh.seek(0, os.SEEK_END)
            size = fh.tell()
            fh.seek(max(0, size - nbytes))
            return fh.read().decode("utf-8", "replace")
    except OSError:
        return ""


MESH_PORT = 24851


def mesh_token(home: Path | None = None) -> str | None:
    """coordination/token from Deskflow.conf (mirrors harness_mesh_token in
    harness/run-scenario.sh): DESKFLOW_MESH_TOKEN env, else the first of
    $DESKFLOW_SETTINGS, ~/Library/Deskflow/Deskflow.conf,
    $XDG_CONFIG_HOME/Deskflow/Deskflow.conf, /Library/Deskflow/Deskflow.conf.
    """
    env_tok = os.environ.get("DESKFLOW_MESH_TOKEN")
    if env_tok:
        return env_tok
    home = home or Path.home()
    xdg = Path(os.environ.get("XDG_CONFIG_HOME") or (home / ".config"))
    candidates = [
        Path(os.environ["DESKFLOW_SETTINGS"]) if os.environ.get("DESKFLOW_SETTINGS") else None,
        home / "Library/Deskflow/Deskflow.conf",
        xdg / "Deskflow/Deskflow.conf",
        Path("/Library/Deskflow/Deskflow.conf"),
    ]
    for conf in candidates:
        if conf is None or not conf.is_file():
            continue
        section = None
        try:
            for raw in conf.read_text(encoding="utf-8", errors="replace").splitlines():
                line = raw.strip()
                if line.startswith("[") and line.endswith("]"):
                    section = line[1:-1].strip().lower()
                    continue
                if section == "coordination" and "=" in line:
                    k, v = line.split("=", 1)
                    if k.strip() == "token":
                        return v.strip() or None
        except OSError:
            pass
        return None
    return None


def mesh_status(host: str = "127.0.0.1", port: int = MESH_PORT, token: str | None = None,
                timeout: float = 2.0) -> dict | None:
    """Send `{"t":"status"}` (plus token) to the coordinator; return the reply."""
    msg = {"t": "status"}
    if token:
        msg["token"] = token
    try:
        with socket.create_connection((host, port), timeout) as s:
            s.sendall((json.dumps(msg, separators=(",", ":")) + "\n").encode())
            s.settimeout(timeout)
            buf = b""
            while not buf.endswith(b"\n"):
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf += chunk
        reply = json.loads(buf.decode("utf-8", "replace").strip() or "null")
        return reply if isinstance(reply, dict) else None
    except (OSError, ValueError):
        return None


def role_from_status(status: dict | None) -> str | None:
    """Map a coordinator status reply's role to server | client (else None)."""
    if not isinstance(status, dict):
        return None
    role = status.get("role")
    if role is None and isinstance(status.get("self"), dict):
        role = status["self"].get("role")
    if not isinstance(role, str):
        return None
    role = role.strip().lower()
    if role in ("server", "primary"):
        return "server"
    if role in ("client", "secondary"):
        return "client"
    return None


def default_log_for(proc: str, home: Path | None = None) -> Path | None:
    """Newest log file for the process (the same lookup derive_scenario uses)."""
    home = home or Path.home()
    if proc == "mouser":
        return _newest_log(
            [home / "Library/Logs/Mouser/mouser.log"]
            + sorted((home / "Library/Application Support/Mouser").glob("*.log"))
            + sorted((home / "Library/Logs/Mouser").glob("*.log"))
        )
    if proc in ("deskflow-core", "deskflow", "deskflow-daemon"):
        return _newest_log(
            [home / "deskflow.log", home / "deskflow-core.log"]
            + sorted((home / "Library/Deskflow").glob("*.log"))
            + sorted((home / "Library/Logs").glob("deskflow*.log"))
            + sorted((home / "Library/Application Support/Deskflow").glob("*.log"))
        )
    return None


def derive_scenario(proc: str, home: Path | None = None, log_path: str | None = None,
                    status_fn=None) -> str:
    """Derive the observed scenario.

    mouser        -> device-connected | device-absent (newest log line)
    deskflow-core -> server | client from the coordinator status socket
                     (127.0.0.1:24851, `{"t":"status"}` with the Deskflow.conf
                     token); the newest log line is only a fallback
    otherwise     -> unknown

    ``log_path`` overrides the default log lookup for the process.
    ``status_fn`` overrides the status query (tests); it returns a dict or None.
    """
    home = home or Path.home()
    text = ""
    override = Path(log_path) if log_path and log_path != "-" else None
    if proc in ("deskflow-core", "deskflow", "deskflow-daemon"):
        query = status_fn or (lambda: mesh_status(token=mesh_token(home)))
        role = role_from_status(query())
        if role:
            return role
    if proc == "mouser":
        log = override or default_log_for(proc, home)
        text = _tail_text(log) if log else ""
        last = None
        for m in re.finditer(r"Device (Connected|Disconnected|Absent)", text):
            last = m.group(1)
        if last == "Connected":
            return "device-connected"
        if last in ("Disconnected", "Absent"):
            return "device-absent"
        return "unknown"
    if proc in ("deskflow-core", "deskflow", "deskflow-daemon"):
        log = override or default_log_for(proc, home)
        text = _tail_text(log) if log else ""
        last = None
        for m in re.finditer(r"starting (server|client) epoch|running as (server|client)", text):
            last = m.group(1) or m.group(2)
        return last or "unknown"
    return "unknown"


def mac_collect(label: str, exe: str, proc: str, scenario_log: str | None = None) -> dict:
    pid, start = mac_find_pid(exe)
    rec: dict = {
        "pid": pid,
        "start_time": start,
        "exe": exe,
        "phys_footprint_mb": None,
        "metric_source": None,
        "rss_mb": None,
        "compressed_mb": None,
        "mach_ports": None,
        "threads": None,
        "fds": None,
        "cpu_s": None,
    }
    if pid is not None:
        top = mac_top(pid)
        rec.update(top)
        fp = mac_phys_footprint(pid)
        if fp is not None:
            rec["phys_footprint_mb"] = round(fp / MB, 3)
            rec["metric_source"] = "proc_pid_rusage"
        else:
            rec["phys_footprint_mb"] = top.get("rss_mb")
            rec["metric_source"] = "top-mem-fallback"
        rec["fds"] = mac_fds(pid)
        rec["cpu_s"] = mac_cpu_seconds(pid)
    rec["scenario"] = derive_scenario(proc, log_path=scenario_log)
    rec["restart_count"] = mac_restart_count(label, exe)
    return rec


# --------------------------------------------------------------------------
# Windows collectors (via PowerShell JSON; see tools/fleet-soak-task.ps1)
# --------------------------------------------------------------------------

# restart_events: SCM 7036 "running" events for the service in the last
# interval only (cumulative restart_count is carried forward by the sampler
# from the previous JSONL sample), so the event-log scan stays bounded.
WIN_PROBE_PS = r"""
$ErrorActionPreference = 'SilentlyContinue'
$exe = $args[0]; $svc = $args[1]; $interval = [int]$args[2]
$p = Get-Process | Where-Object { $_.Path -eq $exe } | Sort-Object Id | Select-Object -First 1
$restarts = $null
try {
  $restarts = @(Get-WinEvent -FilterHashtable @{LogName='System'; ProviderName='Service Control Manager'; Id=7036; StartTime=(Get-Date).AddSeconds(-$interval)} -MaxEvents 100 |
    Where-Object { $_.Message -like "*$svc*" -and $_.Message -like '*running*' }).Count
} catch {}
$o = [ordered]@{ pid = $null }
if ($p) {
  $o = [ordered]@{
    pid = $p.Id
    start_time = $p.StartTime.ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ssZ')
    exe = $p.Path
    private_bytes_mb = [math]::Round($p.PrivateMemorySize64 / 1MB, 3)
    rss_mb = [math]::Round($p.WorkingSet64 / 1MB, 3)
    handles = $p.HandleCount
    threads = $p.Threads.Count
    cpu_s = [math]::Round($p.TotalProcessorTime.TotalSeconds, 3)
  }
  Add-Type -Name U -Namespace W -MemberDefinition '[DllImport("user32.dll")] public static extern int GetGuiResources(IntPtr h, int f);'
  $o.gdi = [W.U]::GetGuiResources($p.Handle, 0)
  $o.user = [W.U]::GetGuiResources($p.Handle, 1)
}
$o.restart_events = $restarts
$o | ConvertTo-Json -Compress
"""


def win_probe(label: str, exe: str, interval: int = 60) -> dict:
    text = run(
        ["powershell", "-NoProfile", "-NonInteractive", "-Command", WIN_PROBE_PS, exe, label, str(interval)],
        timeout=60,
    )
    try:
        return json.loads(text.strip() or "{}")
    except json.JSONDecodeError:
        return {}


def win_record_from_probe(probe: dict, exe: str, proc: str) -> dict:
    rec = {
        "pid": probe.get("pid"),
        "start_time": probe.get("start_time"),
        "exe": probe.get("exe") or exe,
        "private_bytes_mb": probe.get("private_bytes_mb"),
        "metric_source": "Get-Process" if probe.get("pid") is not None else None,
        "rss_mb": probe.get("rss_mb"),
        "compressed_mb": None,
        "mach_ports": None,
        "handles": probe.get("handles"),
        "gdi": probe.get("gdi"),
        "user": probe.get("user"),
        "threads": probe.get("threads"),
        "fds": probe.get("handles"),
        "cpu_s": probe.get("cpu_s"),
        "scenario": probe.get("scenario") or "unknown",
        "restart_count": probe.get("restart_count"),
    }
    if "restart_events" in probe:
        rec["restart_events"] = probe["restart_events"]
    return rec


