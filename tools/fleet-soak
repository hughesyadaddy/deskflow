def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="fleet-soak", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("sample", help="append one or more samples to a JSONL file")
    s.add_argument("--label", action="append", required=True,
                   help="launchd label / Windows service name (repeatable, pairs with --exe)")
    s.add_argument("--exe", action="append", required=True, help="absolute executable path")
    s.add_argument("--proc", action="append", help="override the label-derived proc name")
    s.add_argument("--scenario-log", action="append", metavar="FILE",
                   help="log file to derive the scenario from ('-' = default lookup; pairs with --label)")
    s.add_argument("--out", help="JSONL path (single target only)")
    s.add_argument("--once", action="store_true")
    s.add_argument("--interval", type=int, default=60)
    s.add_argument("--start-soak", metavar="DIR",
                   help="start a new soak: create DIR/<date>/ and point DIR/latest at it")
    s.add_argument("--soak", metavar="DIR",
                   help="append into DIR/latest (started with --start-soak if missing)")
    s.add_argument("--probe-json", metavar="FILE", help="Windows: read Get-Process JSON from FILE or '-'")
    s.add_argument("--verbose", action="store_true")
    s.set_defaults(func=cmd_sample)

    r = sub.add_parser("report", help="compute a verdict from a JSONL file")
    r.add_argument("--seat")
    r.add_argument("--proc")
    r.add_argument("--in", dest="infile", required=True)
    r.add_argument("--window", type=float, help="hours (default: whole file)")
    r.add_argument("--accelerated", action="store_true", help="exclude first 10 min instead of 2 h")
    r.add_argument("--scenario")
    r.add_argument("--slope-max", type=float, metavar="MB/h")
    r.add_argument("--cap", type=float, metavar="MB", help="p95 footprint cap")
    r.add_argument("--ports-slope-max", type=float, metavar="n/h")
    r.add_argument("--max-step", type=float, metavar="PCT")
    r.add_argument("--max-restarts", type=int)
    r.add_argument("--min-hours", type=float, default=72)
    r.add_argument("--min-completeness", type=float, default=0.95)
    r.add_argument("--validate", action="store_true",
                   help="fail (exit 2) on gaps > 5 min, low completeness, short span, bad header")
    r.add_argument("--json", action="store_true")
    r.set_defaults(func=cmd_report)
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return int(args.func(args))


if __name__ == "__main__":
    sys.exit(main())
