<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Deskflow GUI (tray app) — launched once per login by launchd, never by
  `open`. Rendered into ~/Library/LaunchAgents by `scripts/deskflow-ctl start`
  (__APP__ -> the installed bundle, __HOME__ -> $HOME).

  RunAtLoad starts it at bootstrap/login; KeepAlive/SuccessfulExit=false
  relaunches it after a crash or non-zero exit (ThrottleInterval bounds the
  loop), while a clean tray Quit (exit 0) sticks: the GUI also writes the
  quit-intent sentinel that keeps `deskflow-ctl converge` from bootstrapping
  it back until the next `deskflow-ctl start` or reboot.
  DESKFLOW_LAUNCHD=1 tells the GUI it is launchd-owned: it must not register
  itself as a Login Item nor spawn its own core.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.hughesyadaddy.deskflow</string>
  <key>ProgramArguments</key>
  <array>
    <string>__APP__/Contents/MacOS/Deskflow</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DESKFLOW_LAUNCHD</key>
    <string>1</string>
  </dict>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/Deskflow/deskflow-gui.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/Deskflow/deskflow-gui.log</string>
</dict>
</plist>
