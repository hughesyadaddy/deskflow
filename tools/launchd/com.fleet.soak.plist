<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  fleet-soak sampler: one sample per process every 60 s.

  NOT INSTALLED ANYWHERE as of 2026-09-18: the sampler was built during the
  memory program but never bootstrapped on any seat, so nothing watched for a
  dead Mouser (pid null) or the 27 h 100%-CPU spin. Install on every macOS
  seat (user agent, Aqua session so osascript notifications reach the desktop):

    cd ~/Desktop/deskflow
    sed -e "s#__REPO__#$PWD#g" -e "s#__HOME__#$HOME#g" tools/launchd/com.fleet.soak.plist \
      > ~/Library/LaunchAgents/com.fleet.soak.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.fleet.soak.plist
    launchctl kickstart gui/$(id -u)/com.fleet.soak        # first sample now
    tail -1 harness/soak/latest/$(hostname -s | tr A-Z a-z)-mouser.jsonl

  Windows (tiny11): tools/fleet-soak-task.ps1 header has the schtasks line.

  Alerts (desktop notification, also on stderr -> ~/Library/Logs/fleet-soak.log):
  process absent for 2 consecutive samples; cpu_pct > 80 for 3 consecutive
  samples. Each sample also carries per-tick log deltas (Mouser tap timeouts,
  core epoch flips, ClientProxyUnknown) that `fleet-soak report` rates per
  hour against --tap-timeouts-max/--flips-max/--unresponsive-max.

  stdout/stderr go to ~/Library/Logs/fleet-soak.log (not /tmp: that is purged
  on reboot and by the periodic cleaner, which is exactly when a soak's
  sampler errors matter).

  Uninstall:

    launchctl bootout gui/$(id -u)/com.fleet.soak

  Output goes to __REPO__/harness/soak/<date>/<seat>-<proc>.jsonl with
  harness/soak/latest pointing at the current day directory (the <date>
  directory is created once by `fleet-soak sample --start-soak`; --soak keeps
  appending to latest so a multi-day soak stays in one file per process).
  The label for deskflow-core is a plain name (it is a child of the GUI app,
  not a launchd job), so its restart_count is null and restarts are detected
  from (exe, pid, start_time) tuple changes; the JSONL header's
  `restart_source` records this. The GUI app's launchd label is dynamic
  (application.io.github.hughesyadaddy.deskflow.<n>.<m>), so fleet-soak falls
  back to matching gui/$UID jobs by `program = <exe>`. The exe is the real
  binary name `Deskflow` (capital D); ps matching is case-insensitive either
  way.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fleet.soak</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>python3</string>
    <string>__REPO__/tools/fleet-soak</string>
    <string>sample</string>
    <string>--once</string>
    <string>--interval</string>
    <string>60</string>
    <string>--heap-classes</string>
    <string>--soak</string>
    <string>__REPO__/harness/soak</string>
    <string>--label</string>
    <string>io.github.hughesyadaddy.mouser</string>
    <string>--exe</string>
    <string>/Applications/Mouser.app/Contents/MacOS/Mouser</string>
    <string>--label</string>
    <string>deskflow-core</string>
    <string>--exe</string>
    <string>/Applications/Deskflow.app/Contents/MacOS/deskflow-core</string>
    <string>--label</string>
    <string>io.github.hughesyadaddy.deskflow</string>
    <string>--exe</string>
    <string>/Applications/Deskflow.app/Contents/MacOS/Deskflow</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/fleet-soak.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/fleet-soak.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
