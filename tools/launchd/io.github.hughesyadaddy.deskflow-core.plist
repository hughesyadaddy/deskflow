<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  deskflow-core (auto mode) — launchd is the ONLY owner of this process.

  Rendered into ~/Library/LaunchAgents by `scripts/deskflow-ctl start`
  (__APP__ -> the installed bundle, __HOME__ -> $HOME; launchd does not expand
  ~). Never `open`/`pkill` deskflow-core by hand; use the ctl verbs:

    scripts/deskflow-ctl stop      launchctl bootout
    scripts/deskflow-ctl start     launchctl bootstrap
    scripts/deskflow-ctl restart   launchctl kickstart -k

  KeepAlive/SuccessfulExit=false restarts the core only after a crash or
  non-zero exit; a clean `bootout` stays down. ThrottleInterval keeps a
  crash loop from spinning faster than once per 10 s.

  The core paces itself before launchd ever has to: a role epoch that ends
  in failure (port taken, no display, unreadable config) is retried with an
  exponential backoff of 1 s doubling to 30 s, and after 5 consecutive
  failures the process exits non-zero on purpose (AutoModeRunner
  EpochFailurePolicy) so this KeepAlive replaces it with a clean one -- a
  fresh fd table, a fresh listener, a fresh display wait. So a persistent
  fault costs one restart every ~1 min at most (31 s of in-process backoff
  + the throttle), never a hot loop, and a fault that clears mid-way is
  picked up by the next epoch without a restart.

  The login-window bridge stays separate:
  /Library/LaunchAgents/org.deskflow.vhid-bridge.plist (LoginWindow, KeepAlive).

  Logging: ONE sink. The core writes its own rotated log via Deskflow.conf
  `[log] toFile=true file=~/Library/Deskflow/deskflow-core.log` (5 MiB x 3
  generations, FileLogOutputter). launchd's stdout/stderr capture used to
  duplicate every line into ~/Library/Logs/Deskflow/deskflow-core.log with no
  rotation, so it now goes to /dev/null. Crashes are in
  ~/Library/Logs/DiagnosticReports; `[log] toFile` MUST stay true on every seat.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.hughesyadaddy.deskflow-core</string>
  <key>ProgramArguments</key>
  <array>
    <string>__APP__/Contents/MacOS/deskflow-core</string>
    <string>auto</string>
  </array>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DESKFLOW_LAUNCHD</key>
    <string>1</string>
  </dict>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/dev/null</string>
</dict>
</plist>
