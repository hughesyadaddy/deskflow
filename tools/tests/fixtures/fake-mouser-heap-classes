#!/bin/sh
# Stand-in for the Mouser repo's tools/mouser-heap-classes (parses `heap -s`).
# Prints FAKE_HEAP_CLASSES (JSON) and records its argv next to itself.
printf '%s\n' "$*" >> "$(dirname "$0")/heap-classes.calls"
[ -n "${FAKE_HEAP_RC:-}" ] && exit "$FAKE_HEAP_RC"
default='{"CGEvent": 1, "NSXPCConnection": 1}'
printf '%s\n' "${FAKE_HEAP_CLASSES:-$default}"
exit 0
