def macho_scan_cmd(apps: Sequence[str] = MAC_APPS, extra: Sequence[str] = MAC_EXTRA_BINARIES) -> str:
    """One remote round-trip: enumerate Mach-Os and dump codesign info per file."""
    finds = []
    for app in apps:
        macos = f"{app}/Contents/MacOS"
        frameworks = f"{app}/Contents/Frameworks"
        finds.append(f"find {shlex.quote(macos)} -type f 2>/dev/null")
        finds.append(
            f"find {shlex.quote(frameworks)} -type f \\( -name '*.dylib' -o -perm -u+x \\) "
            f"-not -path '*/Resources/*' -not -path '*/Headers/*' 2>/dev/null"
        )
    for path in extra:
        finds.append(f"ls {shlex.quote(path)} 2>/dev/null")
    return (
        "for f in $({ " + "; ".join(finds) + "; }); do "
        'echo "=== $f"; codesign -dvv --verbose=4 "$f" 2>&1; '
        'echo "--- verify"; codesign --verify --deep --strict "$f" 2>&1; echo "rc=$?"; '
        "done"
    )


