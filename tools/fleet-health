def bridge_status_cmd(port: int = BRIDGE_PORT) -> str:
    """Ask the local Mouser bridge (127.0.0.1:BRIDGE_PORT) for its status line.

    Mouser's lego listener answers a `{"t":"status"}` line with one JSON line
    describing the attached peer. `nc -w2` bounds the wait; the printf pipe
    keeps the socket open long enough for the reply.
    """
    return f"printf '{{\"t\":\"status\"}}\\n' | nc -w2 127.0.0.1 {port}"


def parse_bridge_status(output: str) -> Tuple[bool, str]:
    """(pass, detail) for a bridge status reply.

    PASS iff a JSON object in the output has peer == "deskflow-core" —
    that proves the proto-2 link is wired up. attached == false is the
    correct steady state on a seat that has not yet received a device
    connect over the link (e.g. before the physical device's host has
    published one); it is reported in the detail, not treated as a
    failure. Anything else (wrong/missing peer, no reply, unparseable)
    names what was wrong.
    """
    text = output.strip()
    if not text:
        return False, "no reply from bridge (Mouser not listening or status unsupported)"
    payload = None
    for line in text.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            candidate = json.loads(line)
        except ValueError:
            continue
        if isinstance(candidate, dict):
            payload = candidate
            break
    if payload is None:
        return False, f"unparseable bridge reply: {text[:120]}"
    attached = payload.get("attached")
    peer = payload.get("peer")
    if peer != BRIDGE_PEER:
        return False, f"peer={json.dumps(peer)} (want {BRIDGE_PEER!r})"
    extra = ""
    for key in ("session", "proto", "ver"):
        if key in payload:
            extra += f" {key}={payload[key]}"
    if attached is True:
        return True, f"attached to {BRIDGE_PEER}{extra}"
    return True, f"linked to {BRIDGE_PEER}, not yet attached (no device connect observed){extra}"


def ctl_assert_single_cmd(root: str = MAC_DESKFLOW_ROOT) -> str:
