TOOLS_DIR = Path(__file__).resolve().parent
REPO_ROOT = TOOLS_DIR.parent
DEFAULT_ENV_FILE = REPO_ROOT / "scripts" / "fleet.env"
IDENTIFIERS_FILE = TOOLS_DIR / "fleet-health.identifiers"

ALL_CHECKS = ("sign", "no-adhoc", "identifiers", "tcc", "authenticode", "session", "mesh", "instances", "bridge",
              "loginbridge")
MAC_ONLY = {"sign", "no-adhoc", "identifiers", "tcc", "loginbridge"}
WIN_ONLY = {"authenticode"}

MAC_APPS = ("/Applications/Deskflow.app", "/Applications/Mouser.app")
# Loose Mach-Os outside any bundle that must still carry the fleet signature.
# deskflow-prio now installs inside Deskflow.app (covered by the MAC_APPS scan
# above); this legacy path is kept as a no-op safety net for any seat still
# carrying the old out-of-tree /usr/local/bin/deskflow-prio pair -- it should
# report nothing on a seat deployed from this branch.
MAC_EXTRA_BINARIES = ("/usr/local/bin/deskflow-prio",)
MAC_DESKFLOW_ROOT = "~/Desktop/deskflow"
DESKFLOW_CORE = "/Applications/Deskflow.app/Contents/MacOS/deskflow-core"
# launchd is the only owner of deskflow-core on macOS (scripts/deskflow-ctl).
DESKFLOW_CORE_LABEL = "io.github.hughesyadaddy.deskflow-core"
# Coordination-mesh port (src/lib/coordination/Coordinator.h meshPort default):
# always listening on every seat, unlike the KVM/Synergy port which only the
# currently-elected server binds in auto mode. This is what the mesh check
# probes -- see its docstring above.
DEFAULT_MESH_PORT = 24851
# Mouser's lego listener on every seat; deskflow-core attaches to it (MouserLink).
BRIDGE_PORT = 19795
BRIDGE_PEER = "deskflow-core"
DEFAULT_AUTHORITY = "Apple Development"
# LoginWindow bridge (scripts/install-login-bridge-macos.sh renders the plist).
LOGIN_BRIDGE_LABEL = "org.deskflow.vhid-bridge"
LOGIN_BRIDGE_PLIST = f"/Library/LaunchAgents/{LOGIN_BRIDGE_LABEL}.plist"
LOGIN_BRIDGE_BIN = "/Applications/Deskflow.app/Contents/MacOS/deskflow-vhid-bridge"
LOGIN_BRIDGE_LOG = "/var/log/deskflow-vhid-bridge.log"
LOGIN_BRIDGE_KEYSTROKE_MARK = "key down id="
WIN_DESKFLOW_ROOT = "C:/Users/alexh/Desktop/deskflow"

PASS, FAIL, SKIP = "PASS", "FAIL", "SKIP"

# --------------------------------------------------------------------------- env


def parse_env_file(path: Path) -> Dict[str, str]:
    """Parse a shell-style KEY=VALUE file (comments, export, quotes)."""
    env: Dict[str, str] = {}
    if not path.exists():
        return env
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[len("export "):].strip()
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()
        if value[:1] in ("'", '"') and value[-1:] == value[:1] and len(value) >= 2:
            value = value[1:-1]
        else:
            value = value.split(" #", 1)[0].strip()
        env[key] = value
    return env


def local_id() -> str:
    """This seat's id: FLEET_LOCAL_ID, else the short hostname (same rule as fleet-deploy/-doctor)."""
    override = os.environ.get("FLEET_LOCAL_ID", "").strip()
    if override:
        return override.lower()
    return socket.gethostname().split(".")[0].lower()


@dataclass
class Host:
    id: str
    target: str  # ssh target or "local"
    user: str
    os: str  # "macos" | "windows"
    addr: str  # address other seats use to reach this seat

    @property
    def is_local(self) -> bool:
        return self.target == "local"


def guess_os(host_id: str, env: Dict[str, str]) -> str:
    explicit = env.get(f"FLEET_OS_{host_id}", "").lower()
    if explicit in ("macos", "windows"):
        return explicit
    lowered = host_id.lower()
    if lowered == "tiny11" or lowered.startswith(("win", "tiny")):
        return "windows"
    return "macos"


def load_hosts(env: Dict[str, str], want: str, this_id: Optional[str] = None) -> List[Host]:
    this_id = (this_id or local_id()).lower()
    ids = env.get("FLEET_HOSTS", "").split()
    if want == "local":
        if this_id in [i.lower() for i in ids]:
            ids = [i for i in ids if i.lower() == this_id]
        else:
            ids = [this_id]
            env = dict(env, **{f"FLEET_SSH_{this_id}": "local"})
    elif want != "all":
        if want not in ids:
            raise SystemExit(f"fleet-health: unknown host '{want}' (FLEET_HOSTS={ids})")
    hosts: List[Host] = []
    for hid in ids:
        target = env.get(f"FLEET_SSH_{hid}", "") or hid
        if hid.lower() == this_id:
            target = "local"
        os_name = guess_os(hid, env)
        default_user = "alexh" if os_name == "windows" else os.environ.get("USER", "")
        user = env.get(f"FLEET_SSH_USER_{hid}", "") or default_user
        addr = env.get(f"FLEET_ADDR_{hid}", "") or (hid if target == "local" else target)
        hosts.append(Host(hid, target, user, os_name, addr))
    if want not in ("all", "local"):
        hosts = [h for h in hosts if h.id == want]
    return hosts


# ------------------------------------------------------------------------ runner

Runner = Callable[[Host, str], Tuple[int, str, str]]
"""A runner executes `cmd` on `host` and returns (rc, stdout, stderr)."""


def subprocess_runner(host: Host, cmd: str) -> Tuple[int, str, str]:
    if host.is_local:
        argv: Sequence[str] = ["sh", "-c", cmd] if host.os == "macos" else ["cmd.exe", "/c", cmd]
    else:
        argv = [
            "ssh",
            "-o", "BatchMode=yes",
            "-o", "ConnectTimeout=10",
            f"{host.user}@{host.target}" if host.user else host.target,
            cmd,
        ]
    try:
        # PowerShell over ssh emits OEM/UTF-16 fragments (e.g. byte 0x83) that
        # are not valid UTF-8; decode leniently instead of raising.
        proc = subprocess.run(argv, capture_output=True, text=True, timeout=600,
                              encoding="utf-8", errors="replace")
    except FileNotFoundError as exc:
        return 127, "", str(exc)
    except subprocess.TimeoutExpired:
        return 124, "", f"timeout running: {cmd}"
    return proc.returncode, proc.stdout, proc.stderr


# ----------------------------------------------------------------------- results


@dataclass
class Result:
    host: str
    check: str
    status: str
    detail: str

    @property
    def ok(self) -> bool:
        return self.status != FAIL


# --------------------------------------------------------------- command builders
# Kept as functions so tests can key a fake runner on the exact command string.


def macho_scan_cmd(apps: Sequence[str] = MAC_APPS, extra: Sequence[str] = MAC_EXTRA_BINARIES) -> str:
    """One remote round-trip: enumerate Mach-Os and dump codesign info per file."""
    finds = []
    for app in apps:
        macos = f"{app}/Contents/MacOS"
        frameworks = f"{app}/Contents/Frameworks"
        finds.append(f"find {shlex.quote(macos)} -type f 2>/dev/null")
        finds.append(
            f"find {shlex.quote(frameworks)} -type f \\( -name '*.dylib' -o -perm -u+x \\) "
            f"-not -path '*/Resources/*' -not -path '*/Headers/*' 2>/dev/null"
        )
    for path in extra:
        finds.append(f"ls {shlex.quote(path)} 2>/dev/null")
    return (
        "for f in $({ " + "; ".join(finds) + "; }); do "
        'echo "=== $f"; codesign -dvv --verbose=4 "$f" 2>&1; '
        'echo "--- verify"; codesign --verify --deep --strict "$f" 2>&1; echo "rc=$?"; '
        "done"
    )


TCC_QUERY = (
    "select service,client,auth_value,hex(csreq) from access "
    "where client like '%deskflow%' or client like '%mouser%'"
)


USER_TCC_DB = '"$HOME/Library/Application Support/com.apple.TCC/TCC.db"'
# Accessibility and ListenEvent (Input Monitoring) grants are stored in the
# SYSTEM database, not the per-user one. Reading it needs Full Disk Access for
# the calling process (sshd-remote / Terminal), same as the user database.
SYSTEM_TCC_DB = '"/Library/Application Support/com.apple.TCC/TCC.db"'


def tcc_query_cmd(db: str = SYSTEM_TCC_DB) -> str:
    return f"sqlite3 -readonly {db} {shlex.quote(TCC_QUERY)}"


def csreq_decode_cmd(hex_blob: str) -> str:
    return f"printf '%s' {shlex.quote(hex_blob)} | xxd -r -p | csreq -r- -t"


def check_permissions_cmd() -> str:
    return f"{DESKFLOW_CORE} --check-permissions"


def launchctl_cmd() -> str:
    return 'launchctl print "gui/$(id -u)"'


def deskflow_gui_running_cmd() -> str:
    # The GUI executable is Contents/MacOS/Deskflow (capital D); deskflow-core is the daemon.
    return "pgrep -f 'Deskflow.app/Contents/MacOS/Deskflow$'"


def mouser_running_cmd() -> str:
    # Mouser is intentionally NOT launchd-managed (its own in-app "Start at
    # login" toggle has a self-sync bug that pops the window); the installer
    # spawns it directly instead. A process check is the correct liveness
    # signal here, not a launchd-agent lookup.
    return "pgrep -f 'Mouser.app/Contents/MacOS/Mouser$'"


def nc_cmd(addr: str, port: int) -> str:
    return f"nc -z -w3 {shlex.quote(addr)} {port}"


def bridge_status_cmd(port: int = BRIDGE_PORT) -> str:
    """Ask the local Mouser bridge (127.0.0.1:BRIDGE_PORT) for its status line.

    Mouser's lego listener answers a `{"t":"status"}` line with one JSON line
    describing the attached peer. `nc -w2` bounds the wait; the printf pipe
    keeps the socket open long enough for the reply.
    """
    return f"printf '{{\"t\":\"status\"}}\\n' | nc -w2 127.0.0.1 {port}"


def parse_bridge_status(output: str) -> Tuple[bool, str]:
    """(pass, detail) for a bridge status reply.

    PASS iff a JSON object in the output has peer == "deskflow-core" —
    that proves the proto-2 link is wired up. attached == false is the
    correct steady state on a seat that has not yet received a device
    connect over the link (e.g. before the physical device's host has
    published one); it is reported in the detail, not treated as a
    failure. Anything else (wrong/missing peer, no reply, unparseable)
    names what was wrong.
    """
    text = output.strip()
    if not text:
        return False, "no reply from bridge (Mouser not listening or status unsupported)"
    payload = None
    for line in text.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            candidate = json.loads(line)
        except ValueError:
            continue
        if isinstance(candidate, dict):
            payload = candidate
            break
    if payload is None:
        return False, f"unparseable bridge reply: {text[:120]}"
    attached = payload.get("attached")
    peer = payload.get("peer")
    if peer != BRIDGE_PEER:
        return False, f"peer={json.dumps(peer)} (want {BRIDGE_PEER!r})"
    extra = ""
    for key in ("session", "proto", "ver"):
        if key in payload:
            extra += f" {key}={payload[key]}"
    if attached is True:
        return True, f"attached to {BRIDGE_PEER}{extra}"
    return True, f"linked to {BRIDGE_PEER}, not yet attached (no device connect observed){extra}"


def ctl_assert_single_cmd(root: str = MAC_DESKFLOW_ROOT) -> str:
    """scripts/deskflow-ctl assert-single; `~` becomes $HOME so it expands on the remote."""
    root = root.rstrip("/")
    if root.startswith("~"):
        root = '"$HOME"' + root[1:]
    else:
        root = shlex.quote(root)
    return f"{root}/scripts/deskflow-ctl assert-single"


def login_bridge_plist_cmd(plist: str = LOGIN_BRIDGE_PLIST) -> str:
    """Lint the bridge plist and print its program path (ProgramArguments[0])."""
    q = shlex.quote(plist)
    return f"test -f {q} && plutil -lint {q} >/dev/null && plutil -extract ProgramArguments.0 raw -o - {q}"


def login_bridge_log_mode_cmd(log: str = LOGIN_BRIDGE_LOG) -> str:
    return f"stat -f %Lp {shlex.quote(log)}"


def sudo_probe_cmd() -> str:
    return "sudo -n true"


def login_bridge_agent_cmd(label: str = LOGIN_BRIDGE_LABEL) -> str:
    return f"sudo -n launchctl print loginwindow/{label}"


def login_bridge_keystroke_cmd(log: str = LOGIN_BRIDGE_LOG, mark: str = LOGIN_BRIDGE_KEYSTROKE_MARK) -> str:
    # The log is root:0600, so the grep needs sudo too. grep -c exits 1 on zero
    # matches; the count on stdout is what matters.
    return f"sudo -n grep -c {shlex.quote(mark)} {shlex.quote(log)}"


def ps1_cmd(root: str, checks: Sequence[str], thumbprint: str, port: int, peers: Sequence[str]) -> str:
    script = root.rstrip("/") + "/tools/fleet-health.ps1"
    parts = [
        "powershell.exe -NoProfile -ExecutionPolicy Bypass -File",
        f'"{script}"',
        "-Checks", ",".join(checks),
        "-Port", str(port),
    ]
    if thumbprint:
        parts += ["-Thumbprint", thumbprint]
    if peers:
        parts += ["-Peers", ",".join(peers)]
    return " ".join(parts)


# ------------------------------------------------------------------ mac parsing


@dataclass
class MachO:
    path: str
    authorities: List[str]
    team: str
    identifier: str
    adhoc: bool
    verify_rc: int
    verify_out: str


def parse_macho_scan(output: str) -> List[MachO]:
    entries: List[MachO] = []
    cur: Optional[dict] = None
    in_verify = False
    for line in output.splitlines():
        if line.startswith("=== "):
            if cur:
                entries.append(_finish(cur))
            cur = {"path": line[4:].strip(), "auth": [], "team": "", "id": "", "adhoc": False,
                   "vrc": 1, "vout": []}
            in_verify = False
            continue
        if cur is None:
            continue
        if line.strip() == "--- verify":
            in_verify = True
            continue
        if in_verify:
            m = re.match(r"rc=(\d+)", line.strip())
            if m:
                cur["vrc"] = int(m.group(1))
            else:
                cur["vout"].append(line)
            continue
        if line.startswith("Authority="):
            cur["auth"].append(line[len("Authority="):].strip())
        elif line.startswith("TeamIdentifier="):
            cur["team"] = line[len("TeamIdentifier="):].strip()
        elif line.startswith("Identifier="):
            cur["id"] = line[len("Identifier="):].strip()
        elif line.startswith("Signature=adhoc"):
            cur["adhoc"] = True
    if cur:
        entries.append(_finish(cur))
    return entries


def _finish(c: dict) -> MachO:
    return MachO(c["path"], c["auth"], c["team"], c["id"], c["adhoc"], c["vrc"],
                 "\n".join(c["vout"]).strip())


def load_identifier_allowlist(path: Path = IDENTIFIERS_FILE) -> List[str]:
    if not path.exists():
        return []
    out = []
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.split("#", 1)[0].strip()
        if line:
            out.append(line)
    return out


def identifier_allowed(identifier: str, allowlist: Sequence[str]) -> bool:
    return any(fnmatch.fnmatchcase(identifier, pat) for pat in allowlist)


_VERSION_TAIL = re.compile(r"^(\.\d+)*$")


def identifier_is_filename_derived(path: str, identifier: str) -> bool:
    """True when `identifier` is codesign's default derivation from the file name.

    codesign strips the extension and trailing version components, e.g.
    libpcre2-16.0.dylib -> libpcre2-16, _ssl.cpython-313-darwin.so -> _ssl.cpython-313-darwin.
    An LC_UUID-style suffix (libfoo-5555) never matches because the stem does not start with it.
    """
    if not identifier:
        return False
    stem = re.sub(r"\.(dylib|so|bundle)$", "", Path(path).name)
    if not stem.startswith(identifier):
        return False
    return bool(_VERSION_TAIL.match(stem[len(identifier):]))


def is_first_party(path: str) -> bool:
    return "/Contents/MacOS/" in path


# -------------------------------------------------------------------- checker


class FleetHealth:
    def __init__(self, hosts: List[Host], env: Dict[str, str], runner: Runner = subprocess_runner,
                 allowlist: Optional[Sequence[str]] = None, osenv: Optional[Dict[str, str]] = None):
        self.hosts = hosts
        self.env = env
        self.runner = runner
        self.allowlist = list(allowlist) if allowlist is not None else load_identifier_allowlist()
        self.osenv = osenv if osenv is not None else dict(os.environ)
        self.mesh_port = int(env.get("FLEET_MESH_PORT") or DEFAULT_MESH_PORT)
        self._scan_cache: Dict[str, Tuple[int, List[MachO], str]] = {}
        self.results: List[Result] = []

    # -- helpers
    def _add(self, host: Host, check: str, status: str, detail: str) -> None:
        self.results.append(Result(host.id, check, status, detail))

    def _scan(self, host: Host) -> Tuple[int, List[MachO], str]:
        if host.id not in self._scan_cache:
            rc, out, err = self.runner(host, macho_scan_cmd())
            self._scan_cache[host.id] = (rc, parse_macho_scan(out), (out + err).strip())
        return self._scan_cache[host.id]

    def _scan_or_fail(self, host: Host, check: str) -> Optional[List[MachO]]:
        rc, entries, raw = self._scan(host)
        if not entries:
            tail = raw.splitlines()[-1] if raw else "no output"
            self._add(host, check, FAIL, f"no Mach-Os found (rc={rc}): {tail}")
            return None
        return entries

    # -- macOS checks
    def check_sign(self, host: Host) -> None:
        entries = self._scan_or_fail(host, "sign")
        if entries is None:
            return
        expect_auth = self.osenv.get("DESKFLOW_EXPECT_AUTHORITY") or DEFAULT_AUTHORITY
        expect_team = self.osenv.get("DESKFLOW_EXPECT_TEAM") or entries[0].team
        problems = []
        for e in entries:
            name = Path(e.path).name
            if not any(a.startswith(expect_auth) for a in e.authorities):
                problems.append(f"{name}: no Authority={expect_auth}*")
            if not e.team or e.team != expect_team:
                problems.append(f"{name}: TeamIdentifier={e.team or 'not set'} != {expect_team or '?'}")
            if e.verify_rc != 0:
                problems.append(f"{name}: verify --deep --strict rc={e.verify_rc}")
        if problems:
            self._add(host, "sign", FAIL, "; ".join(problems))
        else:
            self._add(host, "sign", PASS,
                      f"{len(entries)} Mach-Os signed by {expect_auth}* team {expect_team}")

    def check_no_adhoc(self, host: Host) -> None:
        entries = self._scan_or_fail(host, "no-adhoc")
        if entries is None:
            return
        adhoc = [Path(e.path).name for e in entries if e.adhoc]
        if adhoc:
            self._add(host, "no-adhoc", FAIL, "Signature=adhoc: " + ", ".join(adhoc))
        else:
            self._add(host, "no-adhoc", PASS, f"{len(entries)} Mach-Os, none ad-hoc")

    def check_identifiers(self, host: Host) -> None:
        entries = self._scan_or_fail(host, "identifiers")
        if entries is None:
            return
        if not self.allowlist:
            self._add(host, "identifiers", FAIL, f"allowlist empty/missing: {IDENTIFIERS_FILE}")
            return
        # First-party binaries (Contents/MacOS/*) must be allowlisted exactly. Bundled
        # third-party frameworks/plugins may instead carry codesign's stable
        # filename-derived identifier; UUID-style suffixes fail either way.
        bad = []
        for e in entries:
            if identifier_allowed(e.identifier, self.allowlist):
                continue
            if not is_first_party(e.path) and identifier_is_filename_derived(e.path, e.identifier):
                continue
            bad.append(f"{Path(e.path).name}={e.identifier or '?'}")
        if bad:
            self._add(host, "identifiers", FAIL, "not in allowlist: " + ", ".join(bad))
        else:
            self._add(host, "identifiers", PASS, f"{len(entries)} identifiers stable/allowlisted")

    def check_tcc(self, host: Host) -> None:
        rows: List[List[str]] = []
        for label, db in (("system", SYSTEM_TCC_DB), ("user", USER_TCC_DB)):
            rc, out, err = self.runner(host, tcc_query_cmd(db))
            if rc != 0:
                self._add(host, "tcc", FAIL,
                          f"sqlite3 {label} TCC.db rc={rc}: {(err or out).strip()[:160]} "
                          "(needs Full Disk Access for sshd-remote/Terminal)")
                return
            rows += [line.split("|") for line in out.splitlines() if line.strip()]
        problems: List[str] = []
        granted = {"kTCCServiceAccessibility": False, "kTCCServiceListenEvent": False}
        for row in rows:
            if len(row) < 4:
                problems.append(f"unparseable row: {'|'.join(row)}")
                continue
            service, client, auth, hexblob = row[0], row[1], row[2], row[3]
            if service in granted:
                if auth == "2":
                    if "deskflow" in client.lower():
                        granted[service] = True
                else:
                    problems.append(f"{service} {client} auth_value={auth} (want 2)")
            if not hexblob:
                problems.append(f"{service} {client}: empty csreq")
                continue
            drc, dout, derr = self.runner(host, csreq_decode_cmd(hexblob))
            req = dout.strip()
            if drc != 0:
                problems.append(f"{service} {client}: csreq decode rc={drc} {derr.strip()[:80]}")
            elif "cdhash" in req:
                problems.append(f"{service} {client}: csreq is cdhash-based")
            elif "certificate leaf[subject.CN]" not in req:
                problems.append(f"{service} {client}: csreq lacks certificate leaf[subject.CN]")
        for service, ok in granted.items():
            if not ok:
                problems.append(f"{service}: no deskflow client with auth_value=2")
        prc, pout, perr = self.runner(host, check_permissions_cmd())
        ptext = (pout + perr).lower()
        if prc != 0:
            if prc == 127 or "unrecognized" in ptext or "unknown option" in ptext \
                    or "invalid option" in ptext or "unknown argument" in ptext:
                problems.append("deskflow-core lacks --check-permissions")
            else:
                problems.append(f"deskflow-core --check-permissions rc={prc}: {(pout + perr).strip()[:120]}")
        if problems:
            self._add(host, "tcc", FAIL, "; ".join(problems))
        else:
            self._add(host, "tcc", PASS,
                      f"{len(rows)} rows cert-based; AX+ListenEvent granted; --check-permissions ok")

    def check_session_mac(self, host: Host) -> None:
        problems = []
        rc, out, err = self.runner(host, launchctl_cmd())
        if rc != 0:
            problems.append(f"launchctl print gui/$UID rc={rc}")
        elif DESKFLOW_CORE_LABEL not in out:
            problems.append(f"{DESKFLOW_CORE_LABEL} not loaded in gui/$UID")
        rc, out, err = self.runner(host, deskflow_gui_running_cmd())
        if rc != 0 or not out.strip():
            problems.append("Deskflow GUI not running")
        rc, out, err = self.runner(host, mouser_running_cmd())
        if rc != 0 or not out.strip():
            problems.append("Mouser not running")
        if problems:
            self._add(host, "session", FAIL, "; ".join(problems))
        else:
            self._add(host, "session", PASS,
                      f"{DESKFLOW_CORE_LABEL} loaded; Deskflow GUI + Mouser running")

    def check_instances_mac(self, host: Host) -> None:
        root = self.env.get("FLEET_DESKFLOW_PATH_macos") or MAC_DESKFLOW_ROOT
        rc, out, err = self.runner(host, ctl_assert_single_cmd(root))
        text = (out + err).strip()
        if rc == 0:
            last = text.splitlines()[-1] if text else "assert-single: OK"
            self._add(host, "instances", PASS, last)
        else:
            lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
            problems = [ln for ln in lines if not ln.startswith("deskflow-ctl assert-single")]
            self._add(host, "instances", FAIL,
                      f"deskflow-ctl assert-single rc={rc}: " + ("; ".join(problems) or "no output")[:300])

    def check_bridge_mac(self, host: Host) -> None:
        rc, out, err = self.runner(host, bridge_status_cmd())
        if rc != 0 and not out.strip():
            self._add(host, "bridge", FAIL,
                      f"nc 127.0.0.1:{BRIDGE_PORT} rc={rc}: {(err or 'no Mouser bridge listening').strip()[:120]}")
            return
        ok, detail = parse_bridge_status(out)
        self._add(host, "bridge", PASS if ok else FAIL, detail)

    def check_login_bridge_mac(self, host: Host) -> None:
        problems: List[str] = []
        rc, out, err = self.runner(host, login_bridge_plist_cmd())
        if rc != 0:
            problems.append(f"{LOGIN_BRIDGE_PLIST} missing or does not lint: {(err or out).strip()[:120] or f'rc={rc}'}")
        elif out.strip() != LOGIN_BRIDGE_BIN:
            problems.append(f"plist program {out.strip() or '?'} != {LOGIN_BRIDGE_BIN}")
        rc, out, err = self.runner(host, login_bridge_log_mode_cmd())
        if rc != 0:
            problems.append(f"{LOGIN_BRIDGE_LOG} missing (rc={rc})")
        elif out.strip() != "600":
            problems.append(f"{LOGIN_BRIDGE_LOG} mode {out.strip() or '?'} (want 600; it holds login-window keystrokes)")
        rc, _, _ = self.runner(host, sudo_probe_cmd())
        sudo_ok = rc == 0
        agent = ""
        if sudo_ok:
            rc, out, err = self.runner(host, login_bridge_agent_cmd())
            if rc != 0:
                problems.append(f"loginwindow/{LOGIN_BRIDGE_LABEL} not loaded (launchctl rc={rc})")
            else:
                m = re.search(r"^\s*pid = (\d+)", out, re.M)
                agent = f"agent pid {m.group(1)}" if m else "agent loaded, no pid (normal outside the login window)"
            rc, out, err = self.runner(host, login_bridge_keystroke_cmd())
            count = out.strip().splitlines()[-1] if out.strip() else ""
            if not count.isdigit():
                problems.append(f"keystroke grep failed: {(err or out).strip()[:80] or f'rc={rc}'}")
            elif int(count) > 0:
                problems.append(f"{count} '{LOGIN_BRIDGE_KEYSTROKE_MARK}' lines in {LOGIN_BRIDGE_LOG} (keystrokes logged)")
        if problems:
            self._add(host, "loginbridge", FAIL, "; ".join(problems))
        elif not sudo_ok:
            self._add(host, "loginbridge", SKIP,
                      "plist lints + program ok, log mode 600; agent state and keystroke grep need "
                      "passwordless sudo (sudo -n failed)")
        else:
            self._add(host, "loginbridge", PASS, f"plist lints, program ok, log 600 with 0 keystrokes, {agent}")

    def check_mesh_leg_mac(self, src: Host, dst: Host) -> None:
        rc, out, err = self.runner(src, nc_cmd(dst.addr, self.mesh_port))
        status = PASS if rc == 0 else FAIL
        detail = f"{src.id} -> {dst.id} ({dst.addr}:{self.mesh_port}) " + ("ok" if rc == 0 else f"rc={rc}")
        self._add(src, "mesh", status, detail)

    # -- Windows checks (delegated to tools/fleet-health.ps1)
    def run_windows(self, host: Host, checks: Sequence[str], peers: Sequence[Host]) -> None:
        root = self.env.get("FLEET_DESKFLOW_PATH_windows") or WIN_DESKFLOW_ROOT
        thumb = self.env.get("DESKFLOW_SIGN_THUMBPRINT", "")
        peer_addrs = [p.addr for p in peers] if "mesh" in checks else []
        cmd = ps1_cmd(root, checks, thumb, self.mesh_port, peer_addrs)
        rc, out, err = self.runner(host, cmd)
        payload = None
        for candidate in (out.strip(), out.strip()[out.find("["):] if "[" in out else ""):
            try:
                payload = json.loads(candidate)
                break
            except (ValueError, TypeError):
                continue
        if not isinstance(payload, list):
            for c in checks:
                self._add(host, c, FAIL, f"fleet-health.ps1 rc={rc}: {(err or out).strip()[:200] or 'no JSON'}")
            return
        seen = set()
        for item in payload:
            check = str(item.get("check", "?"))
            status = str(item.get("status", FAIL)).upper()
            if status not in (PASS, FAIL, SKIP):
                status = FAIL
            seen.add(check)
            self._add(host, check, status, str(item.get("detail", "")))
        for c in checks:
            if c not in seen:
                self._add(host, c, FAIL, "no result from fleet-health.ps1")

    # -- driver
    def run(self, checks: Sequence[str], explicit: bool) -> List[Result]:
        for host in self.hosts:
            peers = [h for h in self.hosts if h.id != host.id]
            if host.os == "windows":
                applicable = [c for c in checks if c not in MAC_ONLY]
                if explicit:
                    for c in checks:
                        if c in MAC_ONLY:
                            self._add(host, c, SKIP, "macOS-only check")
                if applicable:
                    if "mesh" in applicable and not peers:
                        applicable = [c for c in applicable if c != "mesh"]
                        self._add(host, "mesh", SKIP, "no peers")
                    if applicable:
                        self.run_windows(host, applicable, peers)
                continue
            for c in checks:
                if c == "sign":
                    self.check_sign(host)
                elif c == "no-adhoc":
                    self.check_no_adhoc(host)
                elif c == "identifiers":
                    self.check_identifiers(host)
                elif c == "tcc":
                    self.check_tcc(host)
                elif c == "session":
                    self.check_session_mac(host)
                elif c == "instances":
                    self.check_instances_mac(host)
                elif c == "bridge":
                    self.check_bridge_mac(host)
                elif c == "loginbridge":
                    self.check_login_bridge_mac(host)
                elif c == "mesh":
                    if not peers:
                        self._add(host, "mesh", SKIP, "no peers")
                    for dst in peers:
                        self.check_mesh_leg_mac(host, dst)
                elif c in WIN_ONLY and explicit:
                    self._add(host, c, SKIP, "Windows-only check")
        return self.results


# ------------------------------------------------------------------ output


def format_table(results: Sequence[Result]) -> str:
    rows = [("host", "check", "status", "detail")] + [
        (r.host, r.check, r.status, r.detail) for r in results
    ]
    widths = [max(len(row[i]) for row in rows) for i in range(3)]
    lines = []
    for i, row in enumerate(rows):
        lines.append(" | ".join([row[0].ljust(widths[0]), row[1].ljust(widths[1]),
                                 row[2].ljust(widths[2]), row[3]]))
        if i == 0:
            lines.append("-+-".join(["-" * widths[0], "-" * widths[1], "-" * widths[2], "-" * 6]))
    return "\n".join(lines)


def main(argv: Optional[Sequence[str]] = None, runner: Runner = subprocess_runner) -> int:
    ap = argparse.ArgumentParser(prog="fleet-health", description=__doc__.split("\n\n")[0])
    ap.add_argument("--host", default="all", help="all | local | <id> (default: all)")
    ap.add_argument("--check", default="all", choices=ALL_CHECKS + ("all",))
    ap.add_argument("--json", action="store_true", help="emit JSON instead of a table")
    # FLEET_ENV_FILE is the controller's (fleet-deploy.sh/.ps1, fleet-doctor) name
    # for the same override; FLEET_ENV is kept for older callers.
    ap.add_argument("--env", default=os.environ.get("FLEET_ENV_FILE") or os.environ.get("FLEET_ENV")
                    or str(DEFAULT_ENV_FILE), help="path to fleet.env (default: $FLEET_ENV_FILE, else scripts/fleet.env)")
    args = ap.parse_args(argv)

    env_path = Path(args.env).expanduser()
    env = parse_env_file(env_path)
    if not env and args.host != "local":
        print(f"fleet-health: missing or empty {env_path} (copy scripts/fleet.env.example)", file=sys.stderr)
        return 2
    hosts = load_hosts(env, args.host)
    if not hosts:
        print("fleet-health: no hosts selected", file=sys.stderr)
        return 2

    explicit = args.check != "all"
    checks = list(ALL_CHECKS) if not explicit else [args.check]
    results = FleetHealth(hosts, env, runner=runner).run(checks, explicit)

    ok = all(r.ok for r in results)
    if args.json:
        print(json.dumps({"ok": ok, "results": [asdict(r) for r in results]}, indent=2))
    else:
        print(format_table(results))
        failed = sum(1 for r in results if not r.ok)
        print(f"\n{'OK' if ok else 'FAIL'}: {len(results)} results, {failed} failed")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
